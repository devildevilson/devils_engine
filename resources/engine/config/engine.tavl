window = {
  width = 1280
  height = 720
  create_on_start = true
  fullscreen = false
  monitor = ""
}

simulation = {
  main_fps = 20
  // Fixed authoritative gameplay rate; independent of main/render pacing.
  tick_rate = 60
  // Catch-up budget per main frame. Excess fixed steps remain as debt.
  max_steps_per_frame = 8
  sound_fps = 60
  // owner: decode + mix in the sound-system thread; device: mix in the native callback.
  sound_mixing = owner
  sound_output_buffer_ms = 50
  render_fps = 60
  assets_fps = 60
  sound_enabled = true
  assets_enabled = true
  worker_threads_reserved = 4
  min_worker_threads = 1
  thread_start_gap_divisor = 4
}

render = {
  enabled = true
  headless = false
  config_folder = "render_config"
  shader_folder = "shaders"
  cache_folder = "cache"
}

sound = {
  device = ""
  master = 1.0
  music = 1.0
  talk = 1.0
  talk_pos = 1.0
  ui_effect = 1.0
  sfx = 1.0
  // Optional non-HRTF cue. Disabled for tile_frontier's top-down listener: enable it only for a
  // true 3D listener after headphone tuning. Bounds are also enforced in libs/sound.
  directional_coloration = {
    enabled = false
    strength = 1.0
    behind_high_shelf_db = -2.25
    above_high_shelf_db = 0.65
    below_high_shelf_db = -0.85
    high_shelf_frequency_hz = 2500.0
    smoothing_ms = 80.0
  }
}

ui = {
  // Ноль отключает соответствующий лимит/GC step. Ошибка или превышение пропускает текущий кадр;
  // несколько ошибок подряд отключают UI до reload settings или пересоздания runtime state.
  lua_instruction_limit = 10000000
  lua_wall_time_us = 50000
  lua_gc_step_kib = 64
  convert_wall_time_us = 50000
  max_vertex_bytes = 8388608
  max_index_bytes = 4194304
  max_draw_commands = 65536
  disable_after_failures = 3
}

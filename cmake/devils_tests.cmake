# Keep the native test command and its build prerequisites in the same declaration.
# Target-file references can point forward (common's CLI contract precedes GN targets).
function(devils_add_test)
  add_test(${ARGV})
  set(is_command FALSE)
  foreach(argument IN LISTS ARGV)
    if(argument STREQUAL "COMMAND")
      set(is_command TRUE)
      continue()
    endif()
    if(is_command)
      # A bare first command is an executable target; external tools use absolute paths.
      if(argument MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        set_property(GLOBAL APPEND PROPERTY DEVILS_ENGINE_DIRECT_TEST_TARGETS "${argument}")
      endif()
      set(is_command FALSE)
    endif()
    string(REGEX MATCHALL "\\$<TARGET_FILE:[^>]+>" references "${argument}")
    foreach(reference IN LISTS references)
      string(REGEX REPLACE "^\\$<TARGET_FILE:([^>]+)>$" "\\1" target "${reference}")
      set_property(GLOBAL APPEND PROPERTY DEVILS_ENGINE_DIRECT_TEST_TARGETS "${target}")
    endforeach()
  endforeach()
endfunction()

// pass_step2_mirror: name, blending(map), barriers/resources/sets/push_constants(lists),
// material, geometry, draw_group, command. Пустые контейнеры опущены = дефолт.
{
  name = draw_triangles
  material = mat1
  geometry = g1
  draw_group = dg1
  stencil_state = dynamic_stencil
  sets = [ textures ]
  command = "draw"
  // Depth/stencil-only draw inside a target that also owns color.
  blending = { albedo_res = { mask = none } }
}
{
  name = draw_tiles
  material = tile
  geometry = g1
  draw_group = dg_tiles
  sets = [ globals, textures ]
  command = "draw"
}
{
  name = draw_actors
  material = actor
  geometry = g1
  draw_group = dg_actors
  sets = [ globals ]
  command = "draw"
}
// Интерфейс. Без draw_group: vertex/index/command буферы — обычные ресурсы, имена в команде.
// sets выводят camera_buffer=uniform из descriptor globals; command выводит ui_vertices=vertex,
// ui_indices=index и ui_commands=transfer_dst. textures = sampled-image массив binding0 +
// sampler-пул binding1). push_constants: ui_push. Альфа-блендинг на albedo_res.
{
  name = draw_ui
  material = ui
  geometry = ui
  command = "draw_ui ui_vertices ui_indices ui_commands"
  sets = [ globals, textures ]
  push_constants = [ ui_push ]
  // Маска ЯВНО полная. Здесь стояло `mask = rg` — значение, выбранное как фикстура для проверки
  // «объявленная маска ЗАМЕНЯЕТ RGBA, а не дописывается в неё». Пока парсер начинал с RGBA, оно
  // было безвредной декорацией; после починки парсера оно ожило, и интерфейс перестал писать синий
  // канал: панель получала R и G от себя, а B — от того, что лежало в кадре от мира. Этот же файл
  // копируется в проекты как БОЕВОЙ render config, поэтому фикстура переехала на тест-онли шаг
  // draw_regions, которого нет ни в одном графе.
  blending = {
    albedo_res = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha", mask = rgba }
  }
}
{
  name = draw_regions
  material = region_material
  geometry = g1
  draw_group = dg1
  sets = [ region_data ]
  push_constants = [ region_index_push ]
  // specialization constants: имя из SPIR-V шейдера либо 'id_<N>' для констант без OpName
  shader_constants = [ region_quality = "2", id_7 = "0.5" ]
  command = "draw_regions region_gpu_data region_commands"
  // ФИКСТУРА парсера масок: частичная маска обязана ЗАМЕНИТЬ RGBA, а не дописаться в неё. Шаг
  // тест-онли (его нет ни в одном render_graph), поэтому фикстура ничего не рисует в проектах.
  blending = { albedo_res = { mask = rg } }
}
{
  name = blit_to_swapchain
  command = "blit albedo_res swapchain_image"
}

//--- Буферы генератора GN01
// Формат повторяет painter: <род><число компонент>. Отличие одно — поля ИМЕНОВАНЫ, потому что по
// этим именам к ним обращаются и lua, и devils_script. Размер задан ИМЕНЕМ константы: генератор
// обязан уметь назвать свою стоимость по памяти до запуска.
// Раскладка (aos/soa) — свойство хранения, а не контракта: переключение не меняет ни одного скрипта.

{
  name = cells
  format = [
    (height, v1)
    (moisture, v1)
    (smoothed, v1)
    (biome, ub1)
    (biome_lua, ub1)
    (biome_ds, ub1)
    (region, us1)
  ]
  layout = soa
  size = cell_count
}

// Сайты областей. Их мало, поэтому позиции расставляет сама lua поэлементно — это ровно тот случай,
// который правилом разрешён: скрипт обходит множество, которое сам же перечислил.
{
  name = sites
  format = [ (position, v2) ]
  layout = soa
  size = site_count
}

// Соседство областей в CSR: смещения плюс дуги. offsets[site_count] — сколько дуг всего.
{
  name = region_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = site_count_plus_one
}
{
  name = region_arcs
  format = [ (site, us1) ]
  layout = soa
  size = arc_capacity
}

// Контуры областей как планарная сетка с ОБЩИМИ вершинами: соседние области ссылаются на одну
// вершину, а не на две совпадающие копии, поэтому щели на стыке невозможны по построению.
{
  name = polygon_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = site_count_plus_one
}
{
  name = polygon_corners
  format = [ (vertex, ui1) ]
  layout = soa
  size = corner_capacity
}
{
  name = polygon_vertices
  format = [ (position, v2) ]
  layout = soa
  size = vertex_capacity
}
// Число углов видно из смещений, а число вершин — нет, поэтому инструмент пишет его отдельно.
{
  name = polygon_counts
  format = [ (vertices, ui1) ]
  layout = aos
  size = single
}

// Раскладка клеток по областям, тот же CSR: смещения групп и индексы клеток в порядке групп.
{
  name = region_cell_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = site_count_plus_one
}
{
  name = region_cell_order
  format = [ (cell, ui1) ]
  layout = soa
  size = cell_count
}

// Сводка по области: сумма высот. Делить на число клеток будет потребитель — здесь важно, что
// сложение плавающих чисел воспроизводится при любом числе потоков.
{
  name = region_stats
  format = [ (height_sum, v1) ]
  layout = soa
  size = site_count
}

// Состояние между шагами — обычный буфер на один элемент. Отдельного механизма для «сколько всего
// получилось» не нужно: это те же данные, просто их мало.
{
  name = state
  format = [ (peak, v1), (land_cells, ui1) ]
  layout = aos
  size = single
}

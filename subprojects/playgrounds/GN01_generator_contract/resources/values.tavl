//--- Общие значения пайплайна GN01
// Объявлены ОДИН раз и видны каждому шагу среди его параметров. Шаг может переопределить значение
// своим params, но по умолчанию все читают одно и то же.
//
// Смысл именно в этом: sea_level нужен и нативной классификации в climate, и правилу на
// devils_script в semantics, и подсчёту суши в stats. Продублированный в трёх местах порог однажды
// разъедется, и заметить это будет почти нечем — три уровня исполнения начнут считать разное.

{
  numbers = {
    // Рельеф. features — сколько черт приходится на всю карту; частота на клетку выводится из него
    // и ШИРИНЫ КАРТЫ (не буфера), поэтому и смена разрешения, и разбиение на чанки оставляют мир
    // тем же. width — ширина строки буфера, map_width — ширина всей карты; в нечанкованном прогоне
    // они совпадают, оба подставляет host.
    features = 5

    // Нормализация рельефа по измеренному диапазону. Работает только для карты ЦЕЛИКОМ: чанк
    // измерил бы свой собственный диапазон, и соседние чанки получили бы разные отображения. При
    // чанкованной генерации host выключает её, и в дело идут фиксированные scale/offset.
    normalize = 1
    fixed_scale = 1.8
    fixed_offset = 0.0

    // Пороги классификации биома. Их читают все три уровня исполнения.
    sea_level = 0.5
    dry = 0.35
    wet = 0.65

    // Сглаживание рельефа.
    radius = 2

    // Разброс сайтов областей.
    spread = 0.37
  }

  strings = {
    // Закодированное дерево узлов из редактора FastNoise2: граф шума — данные, а не код.
    tree = "DQkGDA=="
  }
}

//--- Шаги генератора планеты GN02
//
// Порядок шагов — это порядок ПРИЧИН, а не удобства: суша не может быть распределена раньше, чем
// посчитаны плиты, климат — раньше суши, а люди — раньше климата. Поэтому каждый следующий шаг
// читает то, что записал предыдущий, и связь видна в reads/writes, а не в комментарии.
//
// Буфер в writes доступен своему шагу и на чтение, поэтому повторять его в reads нельзя.

// 1. Топология замкнутой поверхности: клетки и соседство. Ни одного слова про мир — только форма.
{
  name = topology
  body = scripts/topology.lua
  writes = [ cells, cell_offsets, cell_arcs ]
}

// 2. Тектоника: плиты, их движение, стыки и рельеф.
{
  name = tectonics
  body = scripts/tectonics.lua
  reads = [ cell_offsets, cell_arcs ]
  writes = [ cells, plates, plate_offsets, plate_order, state ]
  programs = {
    convergent = scripts/convergent.ds
    divergent = scripts/divergent.ds
    relief_convergent = scripts/relief_convergent.ds
    relief_divergent = scripts/relief_divergent.ds
  }
}

// 3. Поверхность: сглаживание, уровень моря под заданную долю суши, расстояние до океана.
{
  name = surface
  body = scripts/surface.lua
  reads = [ cell_offsets, cell_arcs ]
  writes = [ cells, state ]
  programs = {
    land = scripts/land.ds
    ocean = scripts/ocean.ds
  }
}

// 4. Климат: ветры от вращения, температура и перенос влаги. Осадки не считаются «на месте» — влага
// едет по ветру, поэтому шаг состоит из цикла переносов, а не из одной формулы.
{
  name = climate
  body = scripts/climate.lua
  reads = [ cell_offsets, cell_arcs ]
  writes = [ cells ]
}

// 5. Сезоны: лето и зима как тёплый и холодный из двух наклонений, отсюда же градиент и зоны.
{
  name = seasons
  body = scripts/seasons.lua
  writes = [ cells, state ]
  programs = {
    summer = scripts/summer.ds
    winter = scripts/winter.ds
    seasonality = scripts/seasonality.ds
    climate_zone = scripts/climate_zone.ds
    alpine = scripts/alpine.ds
  }
}

// 6. Люди: пригодность земли, расселение, культуры и журнал событий.
{
  name = peoples
  body = scripts/peoples.lua
  reads = [ cell_offsets, cell_arcs ]
  writes = [ cells, cultures, culture_offsets, culture_order, history, state ]
  programs = {
    habitability = scripts/habitability.ds
    population_step = scripts/population_step.ds
    culture_mask = scripts/culture_mask.ds
  }
}

// 7. Области: провинции по суше и морские зоны по воде. Идут ПОСЛЕ людей, потому что сводка области
// включает население и культуру: область — это то, чем владеют, а владеют людьми, а не рельефом.
{
  name = regions
  body = scripts/regions.lua
  reads = [ cell_offsets, cell_arcs ]
  writes = [
    cells, provinces, province_offsets, province_order,
    sea_zones, sea_offsets, sea_order, state
  ]
  programs = {
    unassigned_land = scripts/unassigned_land.ds
    unassigned_water = scripts/unassigned_water.ds
    island_seeded = scripts/island_seeded.ds
  }
}

// Наиболее противоположное ветру направление; strict argmin сохраняет порядок CSR.
{
  ctx_save = { n = sqrt(position_x*position_x + position_y*position_y + position_z*position_z) }
  ctx_save = { inverse = value_or(ctx:saved:n > 1e-12,1.0/ctx:saved:n,0.0) }
  ctx_save = { px = position_x*ctx:saved:inverse, py = position_y*ctx:saved:inverse, pz = position_z*ctx:saved:inverse }
  ctx_save = { n = sqrt(wind_x*wind_x + wind_y*wind_y + wind_z*wind_z) }
  ctx_save = { inverse = value_or(ctx:saved:n > 1e-12,1.0/ctx:saved:n,0.0) }
  ctx_save = { wx = wind_x*ctx:saved:inverse, wy = wind_y*ctx:saved:inverse, wz = wind_z*ctx:saved:inverse }
  ctx_save = { dx = other_position_x-ctx:saved:px, dy = other_position_y-ctx:saved:py, dz = other_position_z-ctx:saved:pz }
  ctx_save = { projection = ctx:saved:dx*ctx:saved:px + ctx:saved:dy*ctx:saved:py + ctx:saved:dz*ctx:saved:pz }
  ctx_save = { dx = ctx:saved:dx-ctx:saved:px*ctx:saved:projection, dy = ctx:saved:dy-ctx:saved:py*ctx:saved:projection, dz = ctx:saved:dz-ctx:saved:pz*ctx:saved:projection }
  ctx_save = { n = sqrt(ctx:saved:dx*ctx:saved:dx + ctx:saved:dy*ctx:saved:dy + ctx:saved:dz*ctx:saved:dz) }
  ctx_save = { inverse = value_or(ctx:saved:n > 1e-12,1.0/ctx:saved:n,0.0) }
  ctx_save = { alignment = ctx:saved:dx*ctx:saved:inverse*ctx:saved:wx + ctx:saved:dy*ctx:saved:inverse*ctx:saved:wy + ctx:saved:dz*ctx:saved:inverse*ctx:saved:wz }
  ctx:saved:alignment
}

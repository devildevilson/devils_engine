// Вид области на суше: вулканический остров, горы, холмы, нагорье, низина, прибрежная равнина.
//
// Те же измеренные величины, что и под водой, плюс доля континентальной массы: остров горячей точки
// или вулкан островной дуги стоит на ОКЕАНИЧЕСКОЙ коре, и это его отличает от куска материка той же
// высоты и изрезанности.
//
// Порядок ветвей — порядок главности, и он же ответ на вопрос «что это»: сначала «чей это кусок
// коры», потом «горы ли это» (по уклону), потом «высоко ли» — высокое и не горное и есть нагорье, —
// и только в самом низу лестницы холмы и равнины. Проверять высоту после холмов нельзя: нагорье
// тогда достаётся холмам целиком, потому что у него уклон всё-таки больше равнинного.
//
//   5 прибрежная равнина   6 низина   7 нагорье   8 холмы   9 горы   10 вулканический остров
{
  value_or = { crust - ctx:arg:island_crust < 0, 10,
  value_or = { relief_local - ctx:arg:mountain_relief > 0, 9,
  value_or = { height_relative - ctx:arg:plateau_height > 0, 7,
  value_or = { relief_local - ctx:arg:hill_relief > 0, 8,
  value_or = { height_relative - ctx:arg:plain_height < 0, 5, 6 } } } } }
}

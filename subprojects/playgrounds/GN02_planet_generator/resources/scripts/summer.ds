// Лето — это тёплый из двух сезонов, а не «сезон с положительным наклонением».
//
// Разница принципиальная: при наклонении +tilt в северном полушарии лето, а в южном зима. Правило
// max/min по двум посчитанным сезонам даёт МЕСТНОЕ лето и МЕСТНУЮ зиму на обоих полушариях, и
// градиент «лето — зима» становится величиной клетки, а не полушария.
{
  max = { season_a, season_b }
}

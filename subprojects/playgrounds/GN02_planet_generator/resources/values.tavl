//--- Общие значения планеты GN02
//
// Здесь живут ЧИСЛА мира, и это не то же самое, что настройки движка. Тектоника, климат и люди
// связаны через них: подняли скорость плит — получили выше горы, выше горы — суше подветренная
// сторона, суше — меньше населения. Поэтому одно число объявлено один раз и видно каждому шагу, а
// не продублировано по трём скриптам, где оно однажды разъедется.
//
// Правила, которые эти числа читают, лежат рядом в scripts/*.ds: правило в скрипте, число в конфиге.

{
  numbers = {
    // ---------------------------------------------------------------- топология
    // Ось вращения планеты: 1 = Y, мировая вертикаль движка. От неё считается ВСЁ остальное —
    // широта, инсоляция, пояса ветров, полюса Эйлера плит.
    axis = 1
    // Соседей на клетку до симметризации. Шесть — средняя степень триангуляции на плоскости и
    // хорошее приближение для равнораспределённой решётки; после симметризации выходит около семи.
    neighbours = 6

    // ---------------------------------------------------------------- вращение
    // Скорость вращения в земных сутках наоборот: 1 = сутки как у Земли. Влияет на два разных
    // механизма, и путать их нельзя:
    //   - число зональных поясов ветров (быстрое вращение режет ячейку Хэдли на несколько);
    //   - экваториальное вздутие, то есть форму уровня моря.
    rotation = 1
    wind_bands = 3
    // Вздутие: насколько уровень моря у экватора выше, чем у полюсов, в метрах поправки к рельефу.
    //
    // Число маленькое, и это физика, а не осторожность. У жидкой вращающейся планеты равновесная
    // поверхность выше у экватора на R·f (для Земли это ~21 км), но кора находится в изостатическом
    // равновесии с тем же вздутием, поэтому взаимно они почти сокращаются. Остаётся лишь та часть, на
    // которую кора ОТСТАЛА от смены режима вращения.
    //
    // Величина проверена измерением, и первый выбор был неверным. При 800 м поправка переставала быть
    // поправкой: у трёх зёрен подряд суша собиралась у полюсов (78%, 88% полярных полос против 15-20%
    // в тропиках), потому что континентальная кора поднимается над океанической всего на 420 м, и
    // наклон геоида просто перевешивал тектонику. При 150 м широтный перекос остаётся заметным, но
    // главной причиной формы материков снова становится движение плит.
    bulge = 150
    // Насколько полюса Эйлера плит утягиваются в экваториальную плоскость. Плита, вращающаяся
    // вокруг оси планеты, движется чисто по широте и материки не перемешивает; плита с полюсом на
    // экваторе гоняет кору ПОПЕРЁК широт. Это единственная честная связь дрейфа с вращением:
    // распределение суши по широте от неё зависит, но не задаётся ею напрямую — оно измеряется.
    polar_axis_bias = 0.65

    // ---------------------------------------------------------------- тектоника
    // Скорость плит в условных единицах (порядок сантиметров в год). Абсолютная величина не важна:
    // важны отношения, потому что все пороги ниже заданы в тех же единицах.
    plate_rate_min = 0.6
    plate_rate_max = 4.5
    // ---------------------------------------------------------------- материки и острова
    //
    // Континентальная масса задаётся НЕ плитами, и это выбор в пользу играбельности против прямой
    // физики. Когда континентальной объявлялась целая плита, материки выходили как повезёт: то один
    // сверхматерик на пол-планеты, то вся суша в одном полушарии. На настоящей планете так и бывает,
    // но играть на такой карте нельзя — половина мира оказывается пустой водой.
    //
    // Поэтому центры материков расставляются РАЗНЕСЁННО по всей сфере (пуассоновский выбор), а масса
    // спадает от центра. Плиты при этом остаются полностью в силе: они двигаются, сталкиваются и
    // строят горы, а кто континентальный, теперь свойство КЛЕТКИ, а не плиты — что и физичнее, потому
    // что настоящая плита несёт и континент, и океаническое дно одновременно.
    continent_count = 12
    // Группы материков. Ровно разнесённые центры дают восемь одинаковых одиночных материков: суша
    // распределена равномерно, но крупной связной суши нет — измерено 13% в крупнейшем куске против
    // 52% до правки. Якоря групп и явное расстояние между материками возвращают большие материки, не
    // сгоняя всю сушу в одно полушарие: внутри группы вздутия перекрываются и срастаются, между
    // группами остаётся океан.
    continent_group_count = 5
    continent_group_reach = 0.45
    continent_spacing = 0.56
    // Радиус материка в радианах: 0.42 рад ≈ 2700 км по Земле.
    continent_radius = 0.48
    // Ширина шельфа: на этом расстоянии масса спадает с единицы до нуля, а внутри держится плато.
    //
    // Плато обязательно, и это выяснилось с первого кадра. При линейном спаде от центра масса выше
    // 0.86 (то есть суша) оставалась только у самой середины материка, поиск уровня моря опускал воду
    // и вытаскивал наружу срединные хребты — суша получалась ЛЕНТАМИ вдоль стыков плит вместо
    // материков. Плюс так появляется настоящий шельф: мелководье у берега, а не обрыв.
    continent_shelf = 0.12
    // Насколько шум ломает край материка, в радианах. Половина шельфа: меньше — берег окружностью,
    // больше — материк рассыпается в архипелаг.
    continent_edge_noise = 0.06

    // ---------------------------------------------------------------- горячие точки
    //
    // Океанические острова задаются МЕХАНИЗМОМ, а не количеством, и это разница между миром и узором.
    // Прежняя модель ставила полторы сотни одинаковых конусов пуассоновским выбором: игровое
    // требование выполнялось, но россыпь одинаковых круглых пятен ничем не была связана ни с плитами,
    // ни с их движением, и читалась как узор с первого же кадра.
    //
    // Плюм стоит в мантии неподвижно, плита едет над ним, и каждый кусок коры, прошедший над плюмом,
    // унёс с собой вулкан. Отсюда сами собой берутся все черты архипелага: цепь, а не россыпь;
    // вытянута вдоль движения плиты; самый молодой и высокий остров на одном конце, осевшие банки на
    // другом; у быстрой плиты цепь длиннее и реже.
    hotspot_count = 34
    hotspot_feature = 0.8
    // Высота молодого острова над дном. Дно лежит на 4-6 км, поэтому цифра большая: над водой
    // поднимается только вершина, всё остальное — подводная гора, что и на планете так.
    hotspot_height = 7800
    hotspot_variation = 0.55
    // Время жизни плюма в тех же условных единицах, что и скорость плиты: длина цепи выводится из
    // произведения, а не задаётся отдельно.
    hotspot_life = 0.30
    // Во сколько раз слабее плюм поднимает КОНТИНЕНТАЛЬНУЮ кору. На океане вулкан строится с нуля со
    // дна, на континенте лишь приподнимает уже существующую кору: Эфиопское нагорье, а не Гавайи.
    hotspot_continental = 0.18
    // Ширина следа и ширина поднятия вокруг самого плюма, в радианах; доля высоты, приходящаяся на
    // это поднятие. Без «головы» у цепи не было бы активной области — только точка.
    hotspot_track_width = 0.035
    hotspot_swell_width = 0.13
    hotspot_swell_share = 0.72
    // Расстояние между постройками вдоль цепи и «пол» маски: между Гавайями вода, но подводный
    // хребет под ними непрерывен, поэтому пол не нулевой.
    hotspot_spacing = 0.030
    hotspot_gap = 0.45

    // ---------------------------------------------------------------- островные дуги
    //
    // Второй механизм океанических островов. У настоящей дуги вулканы стоят не на жёлобе, а там, где
    // погружающаяся плита доходит до глубины плавления — в сотне-двух километров за ним, полосой.
    // Поэтому дуга задана СМЕЩЕНИЕМ и шириной полосы, а не спадом от границы.
    arc_height = 7400
    arc_offset = 0.045
    arc_width = 0.012
    // Расстояние между постройками вдоль дуги: дуга — это цепь вулканов, а не сплошная стена.
    arc_spacing = 0.025
    // Широкая низкая часть дуги: утолщённая кора задугового бассейна. Она поднимает дно до пары
    // километров, то есть делает МЕЛКОЕ МОРЕ, и уже с него вулкан выходит островом, а не горой.
    arc_platform_width = 0.055
    arc_platform_share = 0.62
    // Блуждание фронта дуги: доля смещения и длина волны блуждания в радианах. У настоящей дуги угол
    // погружения плиты меняется вдоль стыка, и вместе с ним расстояние до глубины плавления.
    arc_wander = 0.40
    arc_wander_scale = 0.25
    // Поперечная сегментация дуги: расстояние между проливами, ширина пролива и «пол» — во сколько
    // раз в проливе кора тоньше. Пол не нулевой: пролив разрывает цепь, а не отменяет дугу.
    arc_segment_scale = 0.14
    arc_segment_width = 0.30
    arc_segment_gap = 0.25
    // Разброс стоимости роста плиты по поверхности. Ноль дал бы равные плиты-соты, чего на планете
    // не бывает: у Земли одна плита больше половины остальных вместе.
    plate_cost_variation = 0.85
    // Размер узора стоимости роста плиты и отдельный, более мелкий узор для счёта островных затравок.
    // Счёт обязан быть ДРУГИМ: выбор затравок жадный и идёт по счёту, поэтому с тем же полем первые
    // островные центры встали бы ровно туда, где стоят материковые.
    plate_cost_feature = 1.2
    island_score_feature = 0.30
    // Порог, с которого стык плит считается сходящимся или расходящимся. Ниже него граница
    // трансформная: плиты скользят, а не строят и не рвут.
    boundary_threshold = 0.35

    // Рельеф. Все высоты в метрах, все РАССТОЯНИЯ в радианах по поверхности.
    //
    // Про радианы отдельно, потому что это была ошибка первого захода. Заливка по графу считает
    // расстояние в ШАГАХ, и ширины, заданные в шагах, привязывают мир к разрешению: «2.6 клетки» —
    // это 230 км на решётке из 65 тысяч клеток и 115 км на решётке из 262 тысяч. Поэтому ширины
    // объявлены в радианах, а тело шага делит их на шаг решётки sqrt(4π/N). Земной масштаб для
    // перевода: 1 радиан ≈ 6371 км, 0.0157 рад ≈ 100 км.
    continental_base = 0
    // Материковое вздутие: насколько середина материка выше его прибрежной равнины. Без него плато
    // массы коры делает материк столовой горой на одной отметке — см. комментарий в tectonics.lua.
    continent_swell = 1250
    // Базовая глубина океанической коры — это глубина ГРЕБНЯ хребта, а не абиссальной равнины: до
    // равнины дно доводит слагаемое возраста ниже.
    oceanic_base = -3200
    // Орогенез: горы у сходящейся границы. reference — скорость сближения, при которой поднятие
    // равно uplift; width — на каком расстоянии поднятие спадает в e раз (250 км).
    // Поднятие при полной скорости сближения. 7500 м, а не 5200: при 5200 максимум рельефа на решётке
    // из 16 тысяч клеток не доходил до 3 км, потому что типичная скорость сближения даёт около трети
    // от полной, а сглаживание срезает узкие вершины. Горная система обязана быть заметной величиной,
    // иначе климат не получает подветренных сторон.
    uplift = 4400
    // Нагорье: широкий и низкий спад поверх узкого хребта, доля от поднятия и ширина в радианах
    // (0.16 рад ≈ 1000 км). Без него площадь выше двух километров вчетверо меньше земной, хотя
    // вершины уже земной высоты: у горной системы главное не пик, а нагорье за ним.
    plateau_share = 0.20
    plateau_width = 0.16
    uplift_reference = 3.0
    // Во сколько раз слабее поднимается ОКЕАНИЧЕСКАЯ кора при том же сближении. Столкновение двух
    // континентов и столкновение двух океанических плит дают разный рельеф — Гималаи против Японской
    // дуги, — а одинаковое поднятие заодно ломало шельф: суши в открытом океане становилось столько,
    // что уровень моря уходил на две сотни метров ниже материкового берега. Множитель ложится на спад
    // орогена, а не на скорость сближения: скорость нужна ещё и островной дуге, а ей континентальная
    // кора как раз мешает.
    arc_uplift = 0.25
    uplift_width = 0.055
    // Субдукция: сторона, уходящая вниз, получает жёлоб, а не гору. Жёлоб узкий (120 км).
    trench = 3800
    trench_width = 0.019
    // Расходящаяся граница: в океане это гребень над остывшим дном, на континенте — рифтовая долина.
    ridge = 400
    ridge_width = 0.031
    rift = 900
    rift_width = 0.024
    // Возраст океанического дна: чем дальше от хребта, тем холоднее и глубже, но не дальше предела.
    //
    // Глубина задана ПОЛНЫМ перепадом от гребня хребта до абиссальной равнины, а спад — насыщающийся:
    // модель остывания плиты выходит на равновесную глубину, а не тонет бесконечно. Прямая вместо
    // кривой стоила двух ошибок сразу — фланг хребта получался круче суши (перепад между соседями
    // 198 м против 151 м на суше, то есть самая ровная поверхность планеты выходила самой неровной),
    // и наклон задавался метрами на ШАГ заливки, из-за чего мелкая решётка топила океан вдвое глубже.
    abyss_depth = 2800
    abyss_width = 0.07

    // ---------------------------------------------------------------- шельф и гипсография
    //
    // Гипсографическая кривая планеты обязана быть ДВУГОРБОЙ: два самых распространённых уровня —
    // абиссальная равнина около -4500 м и прибрежная суша около нуля, а между ними узкий
    // континентальный склон, который занимает считанные проценты поверхности. Кривая здесь ОДНА и
    // собрана в tectonics.lua: дно (глубина по остыванию) → узкий склон → бровка шельфа → материковая
    // поверхность, то есть само вздутие. Два прежних захода — прямая по доле континентальной массы и
    // ломаная по ней же — не дали такой кривой; почему именно, написано у самой сборки.
    //
    // Бровка шельфа: насколько шельф опускается от берега. 140 м — это отметка бровки на Земле, и она
    // задана В МЕТРАХ ОТ БЕРЕГА, а не долей массы коры: шельф — это затопленный край материковой
    // поверхности, то есть величина уровня моря.
    shelf_drop = 140
    // Ширина континентального склона в радианах (0.03 рад ≈ 190 км). Переводится в метры вздутия по
    // наклону материкового конуса, поэтому склон остаётся узким при любом размере материка.
    slope_width = 0.030

    // ---------------------------------------------------------------- изломанность
    //
    // Шум рельефа ФРАКТАЛЬНЫЙ: спектр настоящего рельефа близок к 1/f, поэтому одна частота даёт
    // узнаваемо искусственную волнистость — одинаковые бугры одного размера. Октавы складываются с
    // затуханием gain на каждом умножении частоты на lacunarity.
    //
    // Число октав ограничено СНИЗУ решёткой, и это не осторожность: октава с длиной волны меньше двух
    // шагов решётки не рельеф, а шум выборки, причём разный на разных разрешениях. Тело шага само
    // отбрасывает такие октавы, поэтому мелкая планета получает меньше октав, чем крупная, — деталь,
    // которой клетка не может быть, на ней не появляется.
    // Размеры узора объявлены в РАДИАНАХ, как и все расстояния мира. Перевод в единицы frequency
    // делает тело шага через noise_scale — частоту, зашитую в само закодированное дерево: единица
    // frequency даёт около сотой доли цикла на радиан. Пока размеры писались прямо в этих единицах,
    // весь шум генератора был примерно в сто раз крупнее задуманного: «мелкая деталь рельефа» с
    // частотой 11 имела узор в несколько радиан, то есть была плавным градиентом по всей планете.
    // Значение измерено по насыщению: на решётке из 16 тысяч клеток отклик уклона перестаёт расти
    // около frequency 2200, а шаг решётки там 0.0277 рад, то есть предел Найквиста 0.055 рад.
    // Округлено ВВЕРХ — так посчитанный узор выходит крупнее заказанного, а не мельче, и предел по
    // решётке остаётся с запасом.
    noise_scale = 0.01
    relief_feature = 0.12
    relief_octaves = 4
    relief_lacunarity = 2.3
    relief_gain = 0.55

    // Амплитуда изломанности в метрах, и она РАЗНАЯ по месту — в этом вся разница с прежней моделью,
    // где деталь была одинаковой везде. Абиссальная равнина — самая ровная поверхность планеты
    // (осадки засыпают всё), континент неровен всюду, а горный пояс неровен сильнее всего. Одинаковая
    // амплитуда делала дно таким же бугристым, как сушу: и физически неверно, и на глобусе видно.
    roughness_abyss = 20
    roughness_land = 400
    // На какой высоте над бровкой шельфа изломанность выходит на материковую величину.
    roughness_relief_span = 800
    roughness_orogen = 1400
    roughness_ridge = 400
    // Трансформные границы дают не высоту, а изломанность.
    shear_roughness = 260

    // Горный пояс не вал, а гряды. Спад от стыка сам по себе даёт гладкое вздутие; настоящий ороген
    // состоит из параллельных хребтов и перевалов между ними. Складчатый шум (модуль шума, свёрнутый
    // обратно в единицу) даёт излом там, где шум проходит ноль, — то есть ровно линию хребта.
    // Пол нужен, чтобы пояс не рвался насквозь: перевал ниже гряды, но это по-прежнему горы.
    belt_feature = 0.05
    belt_floor = 0.50
    // Сглаживание рельефа по графу: пар проходов и вес себя против веса соседа.
    // Сглаживание рельефа по графу: пар проходов и вес себя против веса соседа. Вес себя большой не
    // случайно: у клетки на решётке около семи соседей, и при весе 2.4 один проход оставлял от
    // одноклеточной вершины четверть, а четыре прохода стирали горы вовсе — максимум рельефа падал
    // до 1100 м. Сглаживание обязано убирать шум, а не черты.
    relief_smoothing = 1
    relief_self_weight = 9.0

    // ---------------------------------------------------------------- суша и вода
    // Доля поверхности, которая обязана стать сушей. Уровень моря НЕ задаётся числом — он ищется
    // бисекцией под эту долю, потому что задавать его напрямую значит получать случайную долю суши
    // при каждой смене формул рельефа.
    // Доля суши. НЕ земные 29%, и это отход в сторону игры, но не в сторону выдумки: воды у планеты
    // остаётся ровно столько же, просто океан глубже. Жизнь идёт по суше, и океан на карте
    // воспринимается меньше, чем он есть; при земной доле полтора экрана из двух — пустая вода.
    // Физика при этом соблюдена и ПРОВЕРЯЕТСЯ отчётом: объём океана держится около земного
    // (1.335e9 км³) за счёт большей средней глубины — 4.4 км против земных 3.7.
    land_target = 0.40
    sea_level_iterations = 22
    // Прибрежная эрозия: сколько проходов и с каким порогом поддержки клетка остаётся сушей.
    //
    // Нужна из-за шума на краю материка: он даёт десятки островков в одну-две клетки, в которые не
    // влезает никакая провинция. Измерено на решётке 16384: без эрозии 183 куска суши, из них 113
    // крошек меньше трёх клеток, и всего 18 кусков вмещают провинцию. Эрозия идёт ВНУТРИ поиска
    // уровня моря, поэтому доля суши остаётся заданной, а не проваливается вместе со смытым.
    coast_erosion_passes = 2
    coast_support = 0.30

    // ---------------------------------------------------------------- области рельефа
    //
    // Пороги опознания. Все три величины, по которым различаются области, УЖЕ ПОСЧИТАНЫ физикой:
    // высота от уровня моря, местная изрезанность (отклонение от сглаженной окрестности) и доля
    // суши по соседству. Ничего нового здесь не выдумывается — задаются только границы между видами.
    //
    // Изрезанность меряется по ОКРЕСТНОСТИ, а не по соседу: по одному проходу размытия гладкий склон
    // выглядит таким же изрезанным, как гребень, потому что перепад между соседями у них одинаковый.
    landform_smoothing = 3
    landform_self_weight = 2.5
    // Сколько пар проходов размывает МНОЖИТЕЛЬ усиления. Опознание даёт резкую границу между видами,
    // а разные множители по её сторонам создают ступеньку там, где в рельефе ничего не происходит.
    landform_blend = 2

    // Вода. Жёлоб — крайняя глубина; хребет — изрезанность; шельф и архипелаг — мелководье, а
    // различает их наличие суши по соседству.
    // Пороги уклона — в МЕТРАХ НА СТО КИЛОМЕТРОВ, поэтому не зависят от разрешения планеты.
    trench_depth = 7000
    ridge_relief = 800
    shallow_depth = 1400
    archipelago_support = 0.10

    // Суша. Порядок признаков: чья кора, потом изрезанность (она отличает горы от нагорья при
    // одинаковой высоте), и только потом сама высота.
    island_crust = 0.35
    mountain_relief = 550
    hill_relief = 200
    plateau_height = 1200
    plain_height = 250

    // Усиление областей. Множитель применяется к ОТКЛОНЕНИЮ высоты от сглаженной окрестности, а
    // поправка — к самой высоте. Меньше единицы значит «стать ровнее», больше — «стать резче»; это
    // тот же приём, которым поднимают локальный контраст, только применённый по смыслу места.
    //
    // Смысл каждой строки:
    //   равнины и нагорья  ровнее и заметнее: нагорье приподнимается, низина оседает, и между ними
    //                      появляется настоящий уступ, а не плавный переход;
    //   горы и хребты      резче: гребни выше, долины глубже;
    //   архипелаг          резче: проливы глубже, банки выше, и острова читаются островами, а не
    //                      сплошной отмелью;
    //   шельф и абиссаль   ровнее: это самые ровные поверхности планеты, и они обязаны такими быть.
    landform_gain_abyss = 0.30
    landform_gain_ridge = 1.35
    landform_gain_shelf = 0.35
    landform_gain_archipelago = 1.45
    landform_gain_trench = 1.20
    landform_gain_coast = 0.35
    landform_gain_lowland = 0.30
    landform_gain_plateau = 0.40
    landform_gain_hills = 1.15
    landform_gain_mountains = 1.70
    landform_gain_volcanic = 1.30

    landform_offset_abyss = 0
    landform_offset_ridge = 0
    landform_offset_shelf = 0
    landform_offset_archipelago = 60
    landform_offset_trench = 0
    landform_offset_coast = -30
    landform_offset_lowland = -120
    landform_offset_plateau = 220
    landform_offset_hills = 0
    landform_offset_mountains = 0
    landform_offset_volcanic = 80

    // ---------------------------------------------------------------- климат
    equator_temperature = 27
    pole_temperature = -26
    insolation_exponent = 1.25
    axial_tilt = 23.44
    lapse_rate = 6.5
    // Континентальность: во сколько раз сильнее сезонная амплитуда в глубине материка.
    continental_gain = 0.95
    // Расстояние, на котором континентальность выходит на максимум (800 км). В радианах по той же
    // причине, что и ширины рельефа.
    ocean_reference = 0.126
    // Ветер и влага.
    wind_speed = 1.0
    wind_meridional = 0.4
    // Путь влаги по поверхности в радианах: 0.9 рад ≈ 5700 км, то есть поперёк большого материка.
    // Число переносов тело шага считает из него и шага решётки, поэтому дальность переноса не
    // зависит от разрешения планеты. Предел сверху нужен, чтобы мелкая решётка не превратила шаг в
    // сотни проходов.
    moisture_travel = 0.9
    moisture_max_iterations = 96
    moisture_transport = 0.94
    moisture_evaporation = 0.17
    // Испарение с суши: земля возвращает в воздух заметную часть выпавшего, поэтому центр материка
    // не превращается в абсолютную пустыню от одного расстояния до моря.
    moisture_land_evaporation = 0.10
    moisture_capacity_base = 0.32
    moisture_capacity_gain = 0.028
    // Конвективный дождь: доля влаги, выпадающая за проход из-за неустойчивости тёплого воздуха.
    // Показатель больше единицы обязателен — при линейной зависимости от температуры экватор вышел
    // СУШЕ средних широт, то есть наоборот, и тропиков на планете не оказалось вовсе.
    rain_convective = 0.14
    rain_convective_reference = 26
    rain_convective_exponent = 2.5
    rain_orographic = 0.00060
    rain_ocean = 0.030

    // Пороги климатических зон. Их читает scripts/climate_zone.ds — правило там, числа здесь.
    //
    // Осадки заданы в ДОЛЯХ ОТ СРЕДНЕГО по планете, а не в единицах модели переноса. Так порог
    // читается («суше трети средних осадков») и не требует перенастройки после каждой правки модели
    // влаги; в единицах переноса первый заход дал 28% пустыни просто из-за несовпадения масштабов.
    ice_summer = -2
    tundra_summer = 8
    boreal_summer = 16
    tropical_winter = 14
    arid_precipitation = 0.35
    steppe_precipitation = 0.70
    wet_precipitation = 1.60
    alpine_height = 3200

    // ---------------------------------------------------------------- люди
    // Пригодность для жизни: пороги «холодно», «жарко», «сухо». Всё, что вне, даёт ноль.
    habitable_cold = -12
    habitable_warm = 30
    habitable_optimum = 14
    // Пригодность по осадкам — в тех же долях от среднего.
    habitable_dry = 0.30
    habitable_wet = 1.10
    habitable_height = 2600
    // Расселение. Логистический рост на ёмкости, равной пригодности: население упирается в землю,
    // а не растёт вечно.
    //
    // Тики здесь — ВРЕМЯ, а не расстояние, поэтому от разрешения они не зависят и не должны: рост
    // упирается в местную ёмкость, а не приходит откуда-то. Перемешивание миграцией при этом слегка
    // зависит от решётки, и это осознанная плата — приводить его к расстоянию значило бы считать
    // квадрат отношения шагов, то есть триста проходов на мелкой планете.
    population_ticks = 40
    population_rate = 0.22
    population_capacity = 1000
    population_seed = 0.6
    migration_self_weight = 5.0
    // Культуры расселяются голосованием: пустая клетка перенимает культуру сильнейшего соседа.
    //
    // Дальность расселения задана в РАДИАНАХ, а не в тиках, и это исправление после первого же кадра
    // просмотрщика: при 28 тиках культуры занимали половину суши на решётке из 65 тысяч клеток и
    // ничтожные пятна на решётке из 262 тысяч, потому что тик — это шаг графа, а шаг вдвое мельче.
    // 0.55 рад ≈ 3500 км по Земле: столько культура успевает пройти за отведённое ей время.
    culture_reach = 0.55
    culture_max_ticks = 160
    culture_min_habitability = 0.35
    // История: во сколько раз культура должна вырасти, чтобы это стало событием. Журнал отвечает на
    // вопрос «что было важным», а не «что было», иначе он вырождается в лог тиков.
    history_growth_step = 2.0

    // ---------------------------------------------------------------- области
    // Стоимость подъёма для роста провинции, в единицах стоимости на километр высоты. Из-за неё
    // провинции ложатся по долинам и вдоль берега, а не режут хребет пополам.
    province_mountain_cost = 2.5
    // Границы размера провинции — В ДОЛЯХ ОТ СРЕДНЕЙ, а не в клетках: среднее считается как
    // «клеток суши / число провинций», поэтому границы не зависят ни от разрешения, ни от того,
    // сколько провинций попросили.
    //
    // Зачем границы вообще: без верхней одна провинция расползается на полматерика, если рядом нет
    // затравок, а без нижней у берега появляются провинции в две клетки. И то и другое ломает
    // геймплей сильнее, чем неровность границ, поэтому усреднение здесь сознательное.
    province_min_share = 0.40
    province_max_share = 2.40
    // Запас к верхней границе для ПОСЛЕДНЕЙ заливки. Нужен из-за одиночных клеток: когда все соседи
    // набрали предел, клетке некуда деться, добор даёт ей свою затравку, и появляется провинция в одну
    // клетку. Измерено: 54 таких провинции при жёстком пределе. Провинция на клетку — артефакт хуже,
    // чем провинция на четверть больше предела, поэтому последний проход разрешает перебор.
    province_capacity_slack = 1.25
    // Сколько раз пытаться убрать слишком мелкие провинции. Каждая попытка — снятие затравки и новая
    // заливка; больше трёх-четырёх проходов ничего не меняют, потому что остаток — это острова.
    province_merge_passes = 4

    // ---------------------------------------------------------------- география
    //
    // Уровни иерархии заданы РАЗМЕРОМ, а не числом, и это не мелочь: число областей на планете зависит
    // от того, сколько провинций попросили, а размер исторической области — нет. «Двадцать провинций»
    // остаётся двадцатью провинциями и на планете с тысячей провинций, и на планете с четырьмя
    // тысячами; «сто пятьдесят областей» на первой означало бы область в семь провинций, а на второй
    // в двадцать семь.
    //
    // Масштабы взяты по земной аналогии: историческая область — это Северная Европа или Балканы, то
    // есть десяток-два провинций; материк — Европа целиком, то есть сотни. Земляной массив числом не
    // задаётся вовсе: он определён связностью, а не разбиением.
    continent_provinces = 240
    historical_provinces = 20
    // Ниже этого числа провинций массив НЕ получает своего материка, а прикрепляется к ближайшему:
    // Япония — остров, но материк у неё Азия. Без порога планета с сотней островов дала бы сто с
    // лишним «материков», и уровень перестал бы что-либо означать.
    continent_min_provinces = 40
    // Морских зон в океане. У Земли океанов пять, и это ровно тот порядок, который нужен: океан — это
    // самое крупное названное место на планете, и их не бывает тридцати.
    ocean_zones = 36
    // Ниже этого числа областей замкнутый водоём — не океан, а озеро: океана у него нет, а область
    // есть. Порог не украшение: без него каждое озеро становилось отдельным «океаном».
    ocean_min_zones = 2

    // ---------------------------------------------------------------- титулы
    //
    // Масштабы взяты по CK3 и приведены к нашей провинции = графству: там на герцогство приходится
    // три-четыре графства, на королевство около тринадцати, на империю около сотни. Королевство
    // отдельным числом НЕ задаётся: де-юре королевство — это историческая область, и своё число у
    // него было бы вторым разбиением того же масштаба.
    duchy_provinces = 4
    empire_provinces = 100
    // Баронств на графство. У CK3 их три-семь; здесь среднее, а точное число зависит от пригодности
    // земли: на голом камне поселений меньше.
    baronies_per_province = 4
    // Держав де-факто в среднем на планету — задано размером, как и всё остальное. Точный размер
    // выходит РАЗНЫМ: державы растут голосованием по населению, а не делением площади, поэтому
    // сильная держава больше слабой, и это то, чего от карты и хотят.
    realm_provinces = 14
  }

  // Диапазоны настройки: имя = [минимум, максимум, шаг].
  //
  // Здесь перечислено то, что имеет смысл крутить вслепую, глядя на планету. Значение без диапазона
  // просто не настраивается из окна, и это правильный ответ по умолчанию: у большинства чисел мира
  // есть область осмысленных значений, за которой генератор не ломается, а даёт бессмыслицу — и
  // граница этой области известна автору мира, а не просмотрщику.
  ranges = {
    // Сколько мира
    province_count = [100, 4000, 50]
    sea_zone_count = [20, 400, 10]
    continent_provinces = [40, 800, 20]
    historical_provinces = [4, 80, 2]
    ocean_zones = [8, 120, 4]
    continent_min_provinces = [4, 200, 4]
    ocean_min_zones = [1, 20, 1]
    duchy_provinces = [2, 20, 1]
    empire_provinces = [20, 400, 10]
    realm_provinces = [4, 80, 2]
    baronies_per_province = [1, 10, 1]
    culture_count = [4, 200, 4]

    // Суша и её раскладка по планете
    land_target = [0.10, 0.60, 0.01]
    continent_count = [3, 16, 1]
    continent_radius = [0.15, 0.70, 0.01]
    continent_shelf = [0.02, 0.30, 0.01]
    continent_edge_noise = [0.0, 0.20, 0.01]
    hotspot_count = [0, 60, 2]
    hotspot_height = [0, 12000, 200]
    hotspot_life = [0.1, 2.0, 0.05]
    arc_height = [0, 14000, 250]
    arc_offset = [0.0, 0.20, 0.005]

    // Рельеф: насколько он выражен
    continent_swell = [400, 4000, 100]
    relief_feature = [0.02, 0.40, 0.01]
    roughness_land = [0, 2000, 50]
    roughness_orogen = [0, 6000, 100]
    shelf_drop = [40, 600, 20]
    abyss_depth = [800, 5000, 100]
    arc_uplift = [0.0, 1.0, 0.05]
    continent_group_count = [1, 8, 1]

    // Вращение и тектоника
    rotation = [0.25, 4.0, 0.25]
    wind_bands = [1, 9, 1]
    bulge = [0, 1500, 50]
    polar_axis_bias = [0.0, 1.0, 0.05]
    plate_rate_max = [1.0, 12.0, 0.5]
    uplift = [1000, 14000, 250]

    // Климат
    axial_tilt = [0, 45, 0.5]
    equator_temperature = [5, 45, 1]
    pole_temperature = [-70, 10, 1]
    moisture_travel = [0.2, 2.0, 0.05]
    rain_convective = [0.02, 0.40, 0.01]

    // Люди и области
    culture_reach = [0.1, 1.5, 0.05]
    province_min_share = [0.0, 0.9, 0.05]
    province_max_share = [1.1, 6.0, 0.1]
  }

  strings = {
    // Дерево узлов FastNoise2 закодированной строкой: граф шума — данные конфига, а не код.
    tree = "DQkGDA=="

    // Секции пакета планеты. Что уходит на диск, решает конфиг: рабочие поля генератора
    // потребителю не нужны, а перечислять их в C++ значило бы держать второй список.
    // Иерархия названных мест и титулы уходят в пакет целиком, включая графы соседства ОБЛАСТЕЙ.
    // Граф выводится из клеточного графа и метк, то есть формально избыточен, — но выводится он
    // инструментом, которого у потребителя может и не быть, а нужен он ему на каждый шаг: «кто чей
    // сосед» на уровне провинций спрашивает и путь, и война, и любая надпись по границе.
    package = "cells cell_offsets cell_arcs plates plate_offsets plate_order provinces province_offsets province_order province_neighbour_offsets province_neighbour_arcs sea_zones sea_offsets sea_order sea_neighbour_offsets sea_neighbour_arcs land_masses continents historical_regions oceans duchies empires realms baronies cultures culture_offsets culture_order history state"
  }
}

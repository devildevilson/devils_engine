//--- Общие значения планеты GN02
//
// Здесь живут ЧИСЛА мира, и это не то же самое, что настройки движка. Тектоника, климат и люди
// связаны через них: подняли скорость плит — получили выше горы, выше горы — суше подветренная
// сторона, суше — меньше населения. Поэтому одно число объявлено один раз и видно каждому шагу, а
// не продублировано по трём скриптам, где оно однажды разъедется.
//
// Правила, которые эти числа читают, лежат рядом в scripts/*.ds: правило в скрипте, число в конфиге.

{
  numbers = {
    // ---------------------------------------------------------------- топология
    // Ось вращения планеты: 1 = Y, мировая вертикаль движка. От неё считается ВСЁ остальное —
    // широта, инсоляция, пояса ветров, полюса Эйлера плит.
    axis = 1
    // Соседей на клетку до симметризации. Шесть — средняя степень триангуляции на плоскости и
    // хорошее приближение для равнораспределённой решётки; после симметризации выходит около семи.
    neighbours = 6

    // ---------------------------------------------------------------- вращение
    // Скорость вращения в земных сутках наоборот: 1 = сутки как у Земли. Влияет на два разных
    // механизма, и путать их нельзя:
    //   - число зональных поясов ветров (быстрое вращение режет ячейку Хэдли на несколько);
    //   - экваториальное вздутие, то есть форму уровня моря.
    rotation = 1
    wind_bands = 3
    // Вздутие: насколько уровень моря у экватора выше, чем у полюсов, в метрах поправки к рельефу.
    //
    // Число маленькое, и это физика, а не осторожность. У жидкой вращающейся планеты равновесная
    // поверхность выше у экватора на R·f (для Земли это ~21 км), но кора находится в изостатическом
    // равновесии с тем же вздутием, поэтому взаимно они почти сокращаются. Остаётся лишь та часть, на
    // которую кора ОТСТАЛА от смены режима вращения.
    //
    // Величина проверена измерением, и первый выбор был неверным. При 800 м поправка переставала быть
    // поправкой: у трёх зёрен подряд суша собиралась у полюсов (78%, 88% полярных полос против 15-20%
    // в тропиках), потому что континентальная кора поднимается над океанической всего на 420 м, и
    // наклон геоида просто перевешивал тектонику. При 150 м широтный перекос остаётся заметным, но
    // главной причиной формы материков снова становится движение плит.
    bulge = 150
    // Насколько полюса Эйлера плит утягиваются в экваториальную плоскость. Плита, вращающаяся
    // вокруг оси планеты, движется чисто по широте и материки не перемешивает; плита с полюсом на
    // экваторе гоняет кору ПОПЕРЁК широт. Это единственная честная связь дрейфа с вращением:
    // распределение суши по широте от неё зависит, но не задаётся ею напрямую — оно измеряется.
    polar_axis_bias = 0.65

    // ---------------------------------------------------------------- тектоника
    // Скорость плит в условных единицах (порядок сантиметров в год). Абсолютная величина не важна:
    // важны отношения, потому что все пороги ниже заданы в тех же единицах.
    plate_rate_min = 0.6
    plate_rate_max = 4.5
    // Доля континентальной коры среди плит. У Земли континентальная кора занимает около 40%
    // площади, а суши при этом около 29%: разницу даёт затопленный шельф.
    continental_share = 0.42
    // Разброс стоимости роста плиты по поверхности. Ноль дал бы равные плиты-соты, чего на планете
    // не бывает: у Земли одна плита больше половины остальных вместе.
    plate_cost_variation = 0.85
    plate_cost_frequency = 2.6
    // Порог, с которого стык плит считается сходящимся или расходящимся. Ниже него граница
    // трансформная: плиты скользят, а не строят и не рвут.
    boundary_threshold = 0.35

    // Рельеф. Все высоты в метрах, все РАССТОЯНИЯ в радианах по поверхности.
    //
    // Про радианы отдельно, потому что это была ошибка первого захода. Заливка по графу считает
    // расстояние в ШАГАХ, и ширины, заданные в шагах, привязывают мир к разрешению: «2.6 клетки» —
    // это 230 км на решётке из 65 тысяч клеток и 115 км на решётке из 262 тысяч. Поэтому ширины
    // объявлены в радианах, а тело шага делит их на шаг решётки sqrt(4π/N). Земной масштаб для
    // перевода: 1 радиан ≈ 6371 км, 0.0157 рад ≈ 100 км.
    continental_base = 420
    // Базовая глубина океанической коры — это глубина ГРЕБНЯ хребта, а не абиссальной равнины: до
    // равнины дно доводит слагаемое возраста ниже.
    oceanic_base = -2600
    // Орогенез: горы у сходящейся границы. reference — скорость сближения, при которой поднятие
    // равно uplift; width — на каком расстоянии поднятие спадает в e раз (250 км).
    // Поднятие при полной скорости сближения. 7500 м, а не 5200: при 5200 максимум рельефа на решётке
    // из 16 тысяч клеток не доходил до 3 км, потому что типичная скорость сближения даёт около трети
    // от полной, а сглаживание срезает узкие вершины. Горная система обязана быть заметной величиной,
    // иначе климат не получает подветренных сторон.
    uplift = 7500
    uplift_reference = 3.0
    uplift_width = 0.039
    // Субдукция: сторона, уходящая вниз, получает жёлоб, а не гору. Жёлоб узкий (120 км).
    trench = 3800
    trench_width = 0.019
    // Расходящаяся граница: в океане это гребень над остывшим дном, на континенте — рифтовая долина.
    ridge = 600
    ridge_width = 0.031
    rift = 900
    rift_width = 0.024
    // Возраст океанического дна: чем дальше от хребта, тем холоднее и глубже, но не дальше предела.
    // 210 м на шаг при пределе 0.22 рад (1400 км) уводит дно с -2600 до примерно -5500 м.
    abyss_slope = 210
    abyss_limit = 0.22
    // Трансформные границы дают не высоту, а изломанность.
    shear_roughness = 260
    relief_detail = 900
    relief_frequency = 11.0
    // Сглаживание рельефа по графу: пар проходов и вес себя против веса соседа.
    // Сглаживание рельефа по графу: пар проходов и вес себя против веса соседа. Вес себя большой не
    // случайно: у клетки на решётке около семи соседей, и при весе 2.4 один проход оставлял от
    // одноклеточной вершины четверть, а четыре прохода стирали горы вовсе — максимум рельефа падал
    // до 1100 м. Сглаживание обязано убирать шум, а не черты.
    relief_smoothing = 1
    relief_self_weight = 9.0

    // ---------------------------------------------------------------- суша и вода
    // Доля поверхности, которая обязана стать сушей. Уровень моря НЕ задаётся числом — он ищется
    // бисекцией под эту долю, потому что задавать его напрямую значит получать случайную долю суши
    // при каждой смене формул рельефа.
    land_target = 0.29
    sea_level_iterations = 22

    // ---------------------------------------------------------------- климат
    equator_temperature = 27
    pole_temperature = -26
    insolation_exponent = 1.25
    axial_tilt = 23.44
    lapse_rate = 6.5
    // Континентальность: во сколько раз сильнее сезонная амплитуда в глубине материка.
    continental_gain = 0.95
    // Расстояние, на котором континентальность выходит на максимум (800 км). В радианах по той же
    // причине, что и ширины рельефа.
    ocean_reference = 0.126
    // Ветер и влага.
    wind_speed = 1.0
    wind_meridional = 0.4
    // Путь влаги по поверхности в радианах: 0.9 рад ≈ 5700 км, то есть поперёк большого материка.
    // Число переносов тело шага считает из него и шага решётки, поэтому дальность переноса не
    // зависит от разрешения планеты. Предел сверху нужен, чтобы мелкая решётка не превратила шаг в
    // сотни проходов.
    moisture_travel = 0.9
    moisture_max_iterations = 96
    moisture_transport = 0.94
    moisture_evaporation = 0.17
    // Испарение с суши: земля возвращает в воздух заметную часть выпавшего, поэтому центр материка
    // не превращается в абсолютную пустыню от одного расстояния до моря.
    moisture_land_evaporation = 0.06
    moisture_capacity_base = 0.32
    moisture_capacity_gain = 0.028
    // Конвективный дождь: доля влаги, выпадающая за проход из-за неустойчивости тёплого воздуха.
    // Показатель больше единицы обязателен — при линейной зависимости от температуры экватор вышел
    // СУШЕ средних широт, то есть наоборот, и тропиков на планете не оказалось вовсе.
    rain_convective = 0.14
    rain_convective_reference = 26
    rain_convective_exponent = 2.5
    rain_orographic = 0.00060
    rain_ocean = 0.030

    // Пороги климатических зон. Их читает scripts/climate_zone.ds — правило там, числа здесь.
    //
    // Осадки заданы в ДОЛЯХ ОТ СРЕДНЕГО по планете, а не в единицах модели переноса. Так порог
    // читается («суше трети средних осадков») и не требует перенастройки после каждой правки модели
    // влаги; в единицах переноса первый заход дал 28% пустыни просто из-за несовпадения масштабов.
    ice_summer = -2
    tundra_summer = 8
    boreal_summer = 16
    tropical_winter = 14
    arid_precipitation = 0.35
    steppe_precipitation = 0.70
    wet_precipitation = 1.60
    alpine_height = 3200

    // ---------------------------------------------------------------- люди
    // Пригодность для жизни: пороги «холодно», «жарко», «сухо». Всё, что вне, даёт ноль.
    habitable_cold = -12
    habitable_warm = 30
    habitable_optimum = 14
    // Пригодность по осадкам — в тех же долях от среднего.
    habitable_dry = 0.30
    habitable_wet = 1.10
    habitable_height = 2600
    // Расселение. Логистический рост на ёмкости, равной пригодности: население упирается в землю,
    // а не растёт вечно.
    population_ticks = 40
    population_rate = 0.22
    population_capacity = 1000
    population_seed = 0.6
    migration_self_weight = 5.0
    // Культуры расселяются голосованием: пустая клетка перенимает культуру сильнейшего соседа.
    culture_ticks = 28
    culture_min_habitability = 0.35
    // История: во сколько раз культура должна вырасти, чтобы это стало событием. Журнал отвечает на
    // вопрос «что было важным», а не «что было», иначе он вырождается в лог тиков.
    history_growth_step = 2.0

    // ---------------------------------------------------------------- области
    // Стоимость подъёма для роста провинции, в единицах стоимости на километр высоты. Из-за неё
    // провинции ложатся по долинам и вдоль берега, а не режут хребет пополам.
    province_mountain_cost = 2.5
  }

  strings = {
    // Дерево узлов FastNoise2 закодированной строкой: граф шума — данные конфига, а не код.
    tree = "DQkGDA=="

    // Секции пакета планеты. Что уходит на диск, решает конфиг: рабочие поля генератора
    // потребителю не нужны, а перечислять их в C++ значило бы держать второй список.
    package = "cells cell_offsets cell_arcs plates plate_offsets plate_order provinces province_offsets province_order sea_zones sea_offsets sea_order cultures culture_offsets culture_order history state"
  }
}

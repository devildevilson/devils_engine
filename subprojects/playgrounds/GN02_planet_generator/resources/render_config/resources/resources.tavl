{ name = swapchain_image, format = swapchain4, role = present, size = viewport, swap = swapchain }
{ name = scene_color, format = sf4, role = hdr_color, size = viewport, swap = per_frame }
{ name = scene_depth, format = d32, role = depth, size = viewport, swap = per_frame }
{ name = camera_buffer, format = c1, role = upload, size = camera_bytes, swap = per_frame }
// Сетка поверхности перезаписывается только при смене шага генерации, поэтому у неё собственный
// счётчик, который не крутится вместе с кадрами.
{ name = surface_vertices, format = c1, role = upload, size = surface_vertex_bytes, swap = static_surface, type = singlebuffer }
// Цвет клетки меняется при каждой смене поля, поэтому он идёт по кадрам, как камера.
{ name = cell_visuals, format = c1, role = upload, size = cell_visual_bytes, swap = per_frame }
{ name = ui_vertices, format = c1, role = upload, size = ui_vertices_bytes, swap = per_frame }
{ name = ui_indices, format = c1, role = upload, size = ui_indices_bytes, swap = per_frame }
{ name = ui_commands, format = c1, role = upload, size = ui_commands_bytes, swap = per_frame }

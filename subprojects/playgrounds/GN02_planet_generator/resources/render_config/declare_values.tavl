{ name = viewport, type = screensize }
{ name = camera_bytes, type = fixed, value = [256, 0, 0] }
// Икосфера до восьми подразделений: 20 * 4^8 треугольников по три вершины по 32 байта. Размер
// объявлен заранее, как и у буферов генератора: просмотрщик тоже обязан назвать свою цену по памяти.
// Вершина стала вдвое толще, когда начала брать ЧЕТЫРЕ ближайшие клетки вместо одной. Нужны они ей
// теперь для одного — для ВЫСОТЫ: без смешивания у рельефа видны террасы по клеткам. Цвет и область
// решает фрагмент, у него свои клетки и своя окрестность.
{ name = surface_vertex_bytes, type = fixed, value = [125829120, 0, 0] }
// Цвет, высота, номер области, ОПОРА области и признак суши на клетку, до 1 048 576 клеток. Номер
// области нужен заливке и границе, и вывести его из цвета нельзя: равенство цветов — догадка о
// равенстве метк, а не оно само.
{ name = cell_visual_bytes, type = fixed, value = [33554432, 0, 0] }
// Направление клетки и до восьми её соседей, до 1 048 576 клеток. Нужны ФРАГМЕНТУ: выбор области
// делается на пиксель, а для этого пиксель обязан сам найти ближайшую клетку — спуском по графу от
// той, которую назвала вершина. Дороже на 48 мегабайт видеопамяти, и это цена того, чтобы карта не
// показывала сетку треугольников вместо мира.
{ name = cell_geometry_bytes, type = fixed, value = [50331648, 0, 0] }
// Восемь тысяч глифов по 64 байта: шестьдесят подписей по двадцать букв и запас. Больше подписей на
// экране всё равно нечитаемо.
{ name = label_glyph_bytes, type = fixed, value = [524288, 0, 0] }
{ name = ui_vertices_bytes, type = fixed, value = [524288, 0, 0] }
{ name = ui_indices_bytes, type = fixed, value = [131072, 0, 0] }
{ name = ui_commands_bytes, type = fixed, value = [16384, 0, 0] }

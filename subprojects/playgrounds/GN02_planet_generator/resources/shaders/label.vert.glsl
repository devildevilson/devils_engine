#version 450

// Подпись места ДЕКАЛЬЮ НА ПОВЕРХНОСТИ.
//
// Каждый угол каждого глифа лежит НА СФЕРЕ, а не на плоском щитке: направление угла считается от
// направления якоря сдвигом по касательному базису и нормируется. Поэтому надпись гнётся вместе с
// планетой, укорачивается к горизонту по закону перспективы и прячется за глубиной, как всякая
// геометрия — а не «висит над» планетой, как это делал предыдущий заход со щитком.
//
// Размер задан в РАДИАНАХ, а не в долях экрана, и это следствие того же: у декали есть место на
// поверхности, значит есть и размер на поверхности. Читаемость обеспечивает не постоянный размер, а
// порог: подпись, которая на экране мельче нескольких пикселей, вообще не собирается.
#include "camera_block.glsl"

// Глиф: якорь с угловой высотой, прямоугольник в долях высоты, координаты в атласе и цвет с номером
// текстуры.
struct label_glyph {
  vec4 anchor;
  vec4 rect;
  vec4 uv;
  vec4 tint;
};
layout(set = 0, binding = 1, std430) readonly buffer LabelGlyphs { label_glyph glyphs[]; } labels;

layout(location = 0) out vec2 out_uv;
layout(location = 1) out vec4 out_tint;

void main() {
  const uint glyph_index = uint(gl_VertexIndex) / 6u;
  const uint corner_index = uint(gl_VertexIndex) % 6u;
  // Шесть вершин на глиф без буфера индексов: индексы ради двух треугольников — это второй буфер,
  // который надо держать согласованным с первым.
  const vec2 corners[6] = vec2[6](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0),
                                  vec2(0.0, 1.0), vec2(1.0, 0.0), vec2(1.0, 1.0));
  const vec2 corner = corners[corner_index];

  const label_glyph glyph = labels.glyphs[glyph_index];
  const vec3 anchor = normalize(glyph.anchor.xyz);

  // Касательный базис считается ЗДЕСЬ, а не приходит в записи: он полностью определён якорем, и
  // держать в буфере шесть чисел, которые выводятся из трёх, значило бы платить памятью за ничто.
  // Надпись идёт с запада на восток, как на картах: вправо — вдоль параллели.
  const vec3 polar = abs(anchor.y) < 0.985 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
  const vec3 right = normalize(cross(polar, anchor));
  const vec3 up = cross(anchor, right);

  // Смещение в радианах: em-координаты глифа, помноженные на угловую высоту подписи. Знак у
  // вертикали обратный, потому что `pb`/`pt` шрифта отсчитываются ВНИЗ от верха строки.
  const vec2 offset = (glyph.rect.xy + corner * glyph.rect.zw) * glyph.anchor.w;
  const vec3 direction = normalize(anchor + right * offset.x - up * offset.y);

  // Подъём над поверхностью: чуть выше самой высокой горы при текущем масштабе рельефа, иначе
  // надпись утонула бы в склоне. Проверка глубины при этом остаётся включённой — гора ПЕРЕД надписью
  // обязана её закрыть, ровно как закрывает всё остальное.
  // Подъём отсчитывается от САМОЙ ВЫСОКОЙ возможной горы, а не от средней высоты: масштаб рельефа
  // лежит в `params.x` как «радиусов планеты на метр», и одиннадцать километров — это выше любой
  // вершины, которую генератор строит. С полутора километрами надпись тонула в склонах, и выглядело
  // это как обрезка текста, а не как затенение горой.
  const float lift = camera.params.z + camera.params.x * 11000.0;
  gl_Position = camera.view_projection * camera.planet_to_world * vec4(direction * lift, 1.0);

  out_uv = mix(glyph.uv.xy, glyph.uv.zw, vec2(corner.x, 1.0 - corner.y));
  out_tint = glyph.tint;
}

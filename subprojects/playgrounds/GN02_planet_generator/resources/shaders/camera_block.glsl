// БЛОК КАМЕРЫ ОДИН НА ВСЕ ШЕЙДЕРЫ, и живёт он отдельным файлом не ради краткости.
//
// Блок в std140 читается по СМЕЩЕНИЯМ, а не по именам, поэтому пропуск одного поля в одной копии не
// даёт ни ошибки компиляции, ни предупреждения: все следующие поля просто читаются с чужого места.
// Именно так и исчез весь интерфейс, когда в блок добавилась обратная матрица, — оверлей брал размер
// окна оттуда, где лежат параметры отрисовки, и уезжал за экран целиком. Пять копий этой раскладки
// руками — это пять мест, где можно забыть.
//
// Свободных полей здесь нет: часть компонент занята «сбоку», потому что размер блока объявлен в
// конфиге, и занять свободный слот дешевле, чем менять раскладку в пяти файлах разом.
//
// - `light_direction.w` — НОМЕР ВЫДЕЛЕННОЙ ОБЛАСТИ (нуль означает «ничего не выделено»);
// - `params` — масштаб рельефа в радиусах планеты на метр высоты, режим областей (0 нет, 1 есть,
//   2 есть с линией границы), радиус планеты, «различает ли палитра сушу и воду»;
// - `viewport_near` — ширина и высота окна в пикселях, ближняя плоскость, ШИРИНА ЯДРА заливки карты
//   в шагах решётки.
layout(set = 0, binding = 0, std140) uniform CameraBlock {
  mat4 view_projection;
  mat4 inverse_view_projection;
  mat4 planet_to_world;
  vec4 camera_position;
  vec4 light_direction;
  vec4 params;
  vec4 viewport_near;
} camera;

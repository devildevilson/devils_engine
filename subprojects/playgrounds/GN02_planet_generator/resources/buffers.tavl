//--- Буферы генератора планеты GN02
//
// Адрес поверхности здесь — НАПРАВЛЕНИЕ, а не пара (x, y): планета замкнута, у неё нет края и нет
// строки. Поэтому нет ни одного поля вида «столбец/строка», а соседство лежит отдельным CSR — оно
// данные, а не свойство раскладки.
//
// Поля перечислены от крупных к мелким: у soa это не влияет ни на что, но конфиг читают и как
// документ, а при переключении на aos порядок сразу становится размером элемента.
//
// Размер задан ИМЕНЕМ константы: генератор обязан назвать свою стоимость по памяти до запуска.

{
  name = cells
  format = [
    // Топология
    (position, v3)
    (plate_axis, v3)
    (velocity, v3)
    (wind, v3)

    // Скаляры поверхности и климата. Имена важны буквально: программа на devils_script читает поле
    // по имени привязки, поэтому переименование поля здесь — это переименование в правиле.
    (lat_sin, v1)
    (one, v1)
    (relief_noise, v1)
    (plate_rate, v1)
    (crust, v1)
    (convergence, v1)
    (shear, v1)
    (subduction, v1)
    (convergent_distance, v1)
    (divergent_distance, v1)
    (flood_cost, v1)
    (scratch_distance, v1)
    // Промежуточные величины рельефа. Они существуют потому, что правило на devils_script не может
    // вызвать функцию внутри выражения: спад и ограничение считает движок, а правило складывает.
    (drive, v1)
    (open_drive, v1)
    (age, v1)
    (decay_a, v1)
    (decay_b, v1)
    (height, v1)
    (height_smooth, v1)
    (ocean_distance, v1)
    (temperature, v1)
    (season_a, v1)
    (season_b, v1)
    (temperature_summer, v1)
    (temperature_winter, v1)
    (seasonality, v1)
    (moisture, v1)
    (moisture_next, v1)
    (rain, v1)
    (precipitation, v1)
    (habitability, v1)
    (population, v1)
    (population_next, v1)
    // Нормированные условия пригодности в [0,1]. Их считает движок по порогам из конфига, а правило
    // habitability.ds их только комбинирует: «привести величину к отрезку по двум порогам» — это
    // арифметика, а не правило, и вызов функции внутри выражения ds не принимает.
    (warmth, v1)
    (wetness, v1)
    (altitude, v1)
    (heat_penalty, v1)
    (winter_penalty, v1)

    // Метки. Ноль означает «нет метки» везде, поэтому метки считаются с единицы.
    (scratch_label, ui1)
    (island_label, ui1)
    (province_seed, ui1)
    (province, ui1)
    (sea_seed, ui1)
    (sea_zone, ui1)
    (plate_seed, us1)
    (plate, us1)
    (culture_seed, us1)
    (culture, us1)
    (culture_next, us1)
    (land, ub1)
    (convergent_seed, ub1)
    (divergent_seed, ub1)
    (ocean_seed, ub1)
    (culture_mask, ub1)
    (island_mask, ub1)
    (climate, ub1)
    (frontier, ub1)
  ]
  layout = soa
  size = cell_count
}

// Соседство клеток в CSR. offsets[cell_count] — сколько дуг всего; граф симметричный, поэтому каждая
// пара соседей встречается дважды.
{
  name = cell_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = cell_count_plus_one
}
{
  name = cell_arcs
  format = [ (cell, ui1) ]
  layout = soa
  size = arc_capacity
}

// Тектонические плиты. Плита описана полюсом Эйлера и угловой скоростью, а не вектором сдвига: на
// замкнутой поверхности «едет в сторону» не имеет смысла, а «поворачивается вокруг оси» имеет.
{
  name = plates
  format = [
    (axis, v3)
    (rate, v1)
    (crust, v1)
    (seed_cell, ui1)
    (cells, ui1)
  ]
  layout = aos
  size = plate_capacity
}
{
  name = plate_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = plate_capacity_plus_one
}
{
  name = plate_order
  format = [ (cell, ui1) ]
  layout = soa
  size = cell_count
}

// Провинции суши. Суммы, а не средние: делить будет потребитель, а сложение плавающих чисел в
// scatter воспроизводится при любом числе потоков.
{
  name = provinces
  format = [
    (center, v3)
    (height_sum, v1)
    (temperature_sum, v1)
    (precipitation_sum, v1)
    (population_sum, v1)
    (habitability_sum, v1)
    (seed_cell, ui1)
    (cells, ui1)
    (culture, us1)
  ]
  layout = aos
  size = province_capacity
}
{
  name = province_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = province_capacity_plus_one
}
{
  name = province_order
  format = [ (cell, ui1) ]
  layout = soa
  size = cell_count
}

// Морские зоны. Их мало и они крупные: море нарезается не на провинции, а на акватории, потому что
// геймплейный смысл у воды другой — путь, а не владение.
{
  name = sea_zones
  format = [
    (center, v3)
    (depth_sum, v1)
    (temperature_sum, v1)
    (seed_cell, ui1)
    (cells, ui1)
  ]
  layout = aos
  size = sea_capacity
}
{
  name = sea_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = sea_capacity_plus_one
}
{
  name = sea_order
  format = [ (cell, ui1) ]
  layout = soa
  size = cell_count
}

// Культуры и их сводки.
{
  name = cultures
  format = [
    (origin, v3)
    (population, v1)
    (habitability, v1)
    (origin_cell, ui1)
    (cells, ui1)
    (frontier, ui1)
    (birth_tick, us1)
    (contacts, us1)
  ]
  layout = aos
  size = culture_capacity
}
{
  name = culture_offsets
  format = [ (start, ui1) ]
  layout = soa
  size = culture_capacity_plus_one
}
{
  name = culture_order
  format = [ (cell, ui1) ]
  layout = soa
  size = cell_count
}

// История: журнал событий. Событие — запись, а не сущность: у него есть тик, вид, подлежащее и место.
{
  name = history
  format = [
    (value, v1)
    (cell, ui1)
    (tick, us1)
    (subject, us1)
    (object, us1)
    (kind, ub1)
  ]
  layout = aos
  size = history_capacity
}

// Сводка мира. Обычный буфер на один элемент: «сколько всего получилось» — это те же данные, просто
// их мало, и отдельного механизма для них не нужно.
{
  name = state
  format = [
    (sea_level, v1)
    (land_target, v1)
    (mean_temperature, v1)
    (population, v1)
    (land_cells, ui1)
    (event_count, ui1)
    (province_count, ui1)
    (sea_zone_count, ui1)
    (plate_count, us1)
    (culture_count, us1)
  ]
  layout = aos
  size = single
}

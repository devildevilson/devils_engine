{ name = viewport, type = screensize }
{ name = camera_bytes, type = fixed, value = [256, 0, 0] }
// АРЕНА ВЕРШИН. Шесть миллионов вершин по двенадцать байт — семьдесят два мегабайта, и это цена
// площадки по видеопамяти, названная до запуска. Ключ `--arena` может попросить меньше, но не
// больше: объявление здесь, а не в командной строке, ровно потому же, почему размер буфера
// генератора задан именем константы — стоимость обязана быть видна в конфиге глазами.
//
// Откуда это число, и почему две первые попытки не подошли. Окно вокруг камеры — это 405 чанков, и
// ИЗМЕРЕНИЕ показало, что геометрию имеют почти ВСЕ: стены пещер — тоже поверхность, и её никто не
// видит, пока в неё не залетишь, поэтому «пустых» чанков в мире с ходами почти нет. Тридцати двух
// мегабайт хватило на 214 чанков из 324, шестидесяти четырёх — на 296; у земли окно занимает 5.0
// миллиона вершин из шести, в воздухе — 2.1 миллиона, потому что окно следует за камерой.
//
// Вершина при этом стала ДВЕНАДЦАТИБАЙТНОЙ вместо шестнадцати, когда позиция уехала в фиксированную
// точку внутри своего чанка: точность от этого выросла (полмиллиметра на чанке против сантиметров у
// мирового float32 на удалении в сотню километров), а память уменьшилась на четверть.
{ name = surface_vertex_bytes, type = fixed, value = [75497472, 0, 0] }
// ТАБЛИЦА СМЕЩЕНИЙ ЧАНКОВ: четыре тысячи слотов по вектору. Шестьдесят четыре килобайта — и это вся
// цена того, что мир задан относительно камеры: при уходе камеры из чанка переписывается эта
// таблица, а не арена. Число слотов обязано совпадать с `max_chunk_slots` в коде площадки, и
// расхождение — громкая ошибка при запуске.
{ name = chunk_offset_bytes, type = fixed, value = [65536, 0, 0] }
// СУЩНОСТИ НА КАДР: шестнадцать тысяч вех по 32 байта — полмегабайта, и они переписываются целиком
// каждый кадр. Это осознанная разница с ареной: вершин миллионы, поэтому они лежат в арене и меняются
// только при смене чанка, а сущностей десяток на чанк (замерено: 84 на двенадцать чанков), поэтому
// привести их к системе чанка камеры на процессоре дешевле, чем заводить им вторую арену со слотами.
{ name = prop_instance_bytes, type = fixed, value = [524288, 0, 0] }
{ name = ui_vertices_bytes, type = fixed, value = [524288, 0, 0] }
{ name = ui_indices_bytes, type = fixed, value = [131072, 0, 0] }
{ name = ui_commands_bytes, type = fixed, value = [16384, 0, 0] }

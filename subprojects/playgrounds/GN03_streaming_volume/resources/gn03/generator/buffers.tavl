// Буферы генератора GN03.
//
// Размер задан ИМЕНЕМ константы, а не числом: генератор обязан назвать свою стоимость по памяти до
// запуска. Все три имени хост считает из значений (chunk_cells, vertex_capacity) — то есть цену
// чанка называет сам генератор, а не программа вокруг него.
//
// РЕШЁТКА ШИРЕ КЛЕТОК НА ОДИН УЗЕЛ С КАЖДОЙ СТОРОНЫ, и это не запас «на всякий случай», а условие
// бесшовности. Клеток в чанке `chunk_cells` по оси, значит углов нужно на один больше; а нормаль
// считается центральной разностью, значит у КАЖДОГО угла обязан быть сосед с обеих сторон. Отсюда
// `chunk_cells + 3` отсчёта: полоса перекрытия шириной один узел. Без неё вершины на общей грани
// двух чанков совпали бы, а нормали нет — и шов стал бы видимой полосой другого оттенка.

{
  name = samples
  format = [
    // МИРОВАЯ позиция узла. Она же вход выборки шума, и она обязана быть абсолютной: поле мира
    // считается от мировой позиции, иначе мир поехал бы вслед за наблюдателем.
    position = v3

    // ПОЗИЦИЯ ВНУТРИ ЧАНКА — то же самое минус начало чанка. Отдельное поле, а не пересчёт на
    // выходе, потому что из неё marching cubes строит вершины: арена хранит геометрию в координатах
    // СВОЕГО чанка, а смещение чанка относительно чанка камеры живёт в маленькой таблице на кадр.
    // Тогда уход камеры из чанка стоит обновления таблицы, а не переписывания всей арены, и точность
    // не зависит от того, как далеко улетел наблюдатель.
    local = v3

    // Слои поля. Каждый — отдельное поле, потому что инструмент пишет ОДНО значение в ОДНО поле, а
    // складывает слои конфиг: движок считает арифметику, смысл остаётся в скрипте шага. Амплитуды у
    // слоёв единичные: масштабирует их каждый БИОМ по-своему.
    relief = v1
    detail = v1
    cave = v1

    // КЛИМАТ и смешивание биомов. Два климата — то, по чему биом узнаёт своё место; дальше на каждый
    // присутствующий биом считается вес и плотность по его правилу, и всё это складывается в
    // числитель и знаменатель взвешенного среднего.
    warmth = v1
    wetness = v1
    climate_a = v1
    climate_b = v1
    weight = v1
    biome_density = v1
    blend_num = v1
    blend_den = v1
    shade_num = v1
    // Оттенок биома в этом узле — уже смешанный. По нему хост красит вершины: цвет получается тем же
    // весом, что и форма, поэтому переход цвета совпадает с переходом рельефа, а не рисуется отдельно.
    biome_shade = v1

    // Воздушные острова: шум, ворота по высоте (ниже пола островов их нет) и спад с высотой.
    island = v1
    gate = v1
    lift = v1

    // Расстояние до маршрутов каркаса, по одному полю на СТИЛЬ: у естественной пещеры круглое
    // сечение, у тоннеля бункера угловатое, и это две разные метрики, а не два коэффициента.
    route_distance = v1
    bunker_distance = v1

    // Итог: больше нуля — вещество, меньше — пустота. Поверхность идёт по нулю.
    density = v1
    island_density = v1
  ]
  layout = soa
  size = sample_count
}

{
  name = vertices
  // Треугольники развёрнуты в плоский массив по три вершины: общих вершин нет намеренно. Нормаль
  // приходит из градиента поля, а не усредняется по соседним треугольникам, поэтому индексный буфер
  // сэкономил бы память, но потребовал бы сшивать вершины — то есть решать задачу, которой у
  // marching cubes нет.
  format = [ position = v3, normal = v3 ]
  layout = soa
  size = vertex_capacity
}

{
  name = route_points
  // МАРШРУТ КАРКАСА В ОБЛАСТИ ЭТОГО ЧАНКА — вход пайплайна, а не результат шага: заполняет его хост
  // запросом к каркасу. Ёмкость объявлена, как и у всего остального: чанк обязан назвать свою цену
  // до запуска, а переполнение — громкий отказ, потому что НЕПОЛНЫЙ маршрут даёт другой мир, а не
  // чуть другой коридор.
  format = [ position = v3 ]
  layout = soa
  size = chunk_route_capacity
}

{
  name = route_offsets
  // CSR-смещения цепочек маршрута. Неиспользованные цепочки хост делает ПУСТЫМИ (смещения равны), а
  // не оставляет как есть: у пустой цепочки нет отрезков, и она ничего не вырежет.
  format = [ offset = ui1 ]
  layout = soa
  size = chunk_route_chain_capacity
}

// ВТОРОЙ СТИЛЬ — ОТДЕЛЬНАЯ ПАРА БУФЕРОВ, а не поле «стиль» внутри одной. Инструмент расстояния
// считает по ОДНОМУ набору цепочек с одной метрикой, поэтому смешивать в нём круглые и угловатые
// коридоры нечем: пришлось бы либо звать его на подмножество цепочек (диапазона по цепочкам у него
// нет), либо разделять после. Разделяет хост при заполнении входа — там это одна проверка стиля.
{
  name = bunker_points
  format = [ position = v3 ]
  layout = soa
  size = chunk_route_capacity
}

{
  name = bunker_offsets
  format = [ offset = ui1 ]
  layout = soa
  size = chunk_route_chain_capacity
}

{
  name = props
  // СУЩНОСТИ ЧАНКА: вехи, стоящие на поверхности. Позиция ЛОКАЛЬНАЯ, от начала чанка, ровно по тому
  // же правилу, что у вершин: мировое место — это целый ключ чанка плюс это смещение, и абсолютной
  // позиции нет нигде. Чанк владеет своими сущностями, поэтому выгрузка чанка — это и выгрузка их.
  //
  // Длина выхода снова ПЕРЕМЕННАЯ, и механизм тот же, что у геометрии: ёмкость объявлена размером
  // буфера, занятая длина лежит в `state`. Второго механизма не понадобилось.
  format = [
    position = v3
    // Нормаль поверхности под вехой: по ней она наклоняется, а не торчит вертикально из склона.
    normal = v3
    // Высота в метрах и род (0 столб на открытом месте, 1 валун на склоне, 2 кристалл под сводом).
    size = v1
    kind = ui1

    // ИДЕНТИЧНОСТЬ. Номер ПОПЫТКИ, на которой генератор поставил эту веху, — то, по чему её можно
    // узнать после выгрузки чанка и пересчёта. Вместе с ключом чанка это и есть имя сущности.
    //
    // Почему номер попытки, а не место в выходном массиве: попытки перечисляет сам цикл генератора и
    // их число объявлено, а место в массиве зависит от того, сколько попыток до неё ОТКАЗАЛОСЬ. Стоит
    // подкрутить порог уклона — и все места сдвинутся, то есть память об одной вехе окажется памятью
    // о другой. Номер попытки от этого не зависит.
    origin = ui1
  ]
  layout = soa
  size = prop_capacity
}

{
  name = state
  // Сколько вершин занято в этом проходе. Отдельного механизма под переменную длину выхода в
  // библиотеке нет и не понадобилось: «сколько получилось» — обычное состояние между шагами, а
  // значит обычный буфер на один элемент.
  // `biomes_used` — сколько биомов реально участвовало в этом чанке. Это не диагностика ради
  // диагностики: цена биомов равна их числу В ЧАНКЕ, а не в мире, и без этого числа утверждение
  // осталось бы словами.
  format = [ vertex_count = ui1, prop_count = ui1, biomes_used = ui1 ]
  layout = soa
  size = state_count
}

// Общие значения генератора GN03.
//
// Здесь живут числа МИРА, и первые два из них — не настройки движка, а его геометрия: сколько клеток
// в чанке и сколько метров в клетке. Их читает и генератор (размер буферов, шаг решётки), и хост
// (куда поставить чанк, какой ключ у окрестности камеры). Продублированные, они однажды разъедутся, и
// мир поедет относительно самого себя — поэтому объявлены они РАЗ, и хост берёт их отсюда, а не
// заводит своё мнение.

{
  numbers = {
    // ---------------------------------------------------------------- геометрия чанка
    // Клеток в чанке по каждой оси. Отсчётов на один больше, плюс полоса перекрытия в один узел с
    // каждой стороны, то есть (chunk_cells + 3)^3 — см. buffers.tavl.
    chunk_cells = 32
    // Метров в клетке. Вместе с chunk_cells задаёт размер чанка в мире: 32 клетки по метру = 32 м.
    cell_size = 1.0
    // Сколько вершин может выдать один чанк. Число ИЗМЕРЕНО, а не выбрано с запасом: на настройках
    // по умолчанию самый густой чанк выборки дал 24309 вершин (19% отсюда), а средний — 8524.
    // Объявленные 131072 оставляют запас на настройки погуще: узкие ходы и мелкий шум дают больше
    // поверхности. Переполнение — громкий отказ инструмента, а не тихая обрезка: обрезанная
    // поверхность выглядит как дырка в мире, и по картинке её причину не найти.
    vertex_capacity = 131072

    // ---------------------------------------------------------------- биомы
    // БИОМ — ЭТО НАБОР ЧИСЕЛ ПЛЮС МЕСТО В КЛИМАТИЧЕСКОЙ ПЛОСКОСТИ, и ничего больше. Правило одно на
    // все биомы (запас по высоте плюс рельеф плюс детали минус пещеры), а различаются они тем, с
    // какими числами это правило считается — и складываются по весу, поэтому переход между биомами
    // непрерывен, как и всё остальное поле.
    //
    // Размер формы климата НАМНОГО больше рельефа: биом должен занимать область, иначе мир
    // превращается в мозаику, где ни один биом не успевает себя показать.
    climate_feature = 900.0
    biome_count = 5
    // Считать ВСЕ биомы, не отбрасывая далёкие. Существует ради проверки: результат обязан быть
    // ПОБИТОВО тем же, что при отбрасывании, и это и есть доказательство того, что компактный
    // носитель веса делает отбрасывание точным, а не приблизительным.
    force_all_biomes = 0

    // Радиус в климатических единицах — он же НОСИТЕЛЬ веса: за ним вес ровно нулевой, и только
    // поэтому «считать лишь присутствующие биомы» это точное равенство, а не приближение.
    //
    // Биом 1 — БАЗОВЫЙ, и его радиус объявлен таким, чтобы накрыть всю климатическую плоскость: у
    // взвешенного среднего должна быть гарантия, что сумма весов нигде не ноль, иначе в дырке
    // покрытия плотность обратилась бы в ноль — то есть там появилась бы поверхность.
    biome_1_warmth = 0.0
    biome_1_wetness = 0.0
    biome_1_reach = 9.0
    biome_1_gradient = 0.9
    biome_1_relief = 18.0
    biome_1_detail = 5.0
    biome_1_cave_width = 0.05
    biome_1_cave_strength = 60.0
    biome_1_shade = 0.18

    // Горы: мягкий градиент (форма правит высотой сильнее, чем глубина) и высокая амплитуда рельефа.
    biome_2_warmth = -0.55
    biome_2_wetness = 0.50
    biome_2_reach = 0.75
    biome_2_gradient = 0.55
    biome_2_relief = 46.0
    biome_2_detail = 9.0
    biome_2_cave_width = 0.04
    biome_2_cave_strength = 70.0
    biome_2_shade = 0.86

    // Карст: пещеры широкие и сильные, рельеф умеренный. Именно здесь мир становится сетью ходов, а
    // не поверхностью с дырками.
    biome_3_warmth = 0.55
    biome_3_wetness = 0.60
    biome_3_reach = 0.70
    biome_3_gradient = 1.0
    biome_3_relief = 20.0
    biome_3_detail = 6.0
    biome_3_cave_width = 0.12
    biome_3_cave_strength = 95.0
    biome_3_shade = 0.55

    // Степь: почти плоско и почти без ходов — нужна как контраст, иначе «биомы» читаются как «шум
    // разной силы».
    biome_4_warmth = 0.50
    biome_4_wetness = -0.60
    biome_4_reach = 0.70
    biome_4_gradient = 1.45
    biome_4_relief = 7.0
    biome_4_detail = 2.5
    biome_4_cave_width = 0.03
    biome_4_cave_strength = 40.0
    biome_4_shade = 0.32

    // Бэдленды: сильные детали при среднем рельефе — изрезанность вместо высоты.
    biome_5_warmth = -0.55
    biome_5_wetness = -0.55
    biome_5_reach = 0.65
    biome_5_gradient = 0.7
    biome_5_relief = 30.0
    biome_5_detail = 15.0
    biome_5_cave_width = 0.08
    biome_5_cave_strength = 85.0
    biome_5_shade = 0.70

    // ---------------------------------------------------------------- поверхность
    // Опорная высота: та, около которой поле меняет знак при нулевом шуме.
    surface_level = 0.0
    // РАЗМЕРЫ ФОРМ общие на все биомы, а АМПЛИТУДЫ — у каждого свои (см. таблицу биомов выше). Это не
    // экономия конфига, а цена: размер формы входит в частоту, поэтому биом с ДРУГИМ размером
    // потребовал бы пересчитать слой шума на биом, тогда как другая амплитуда стоит одно умножение.
    // Отсюда правило: биомы различаются числами при общем правиле, и первое, что стоит попробовать
    // изменить, — амплитуды и пороги, а не размеры.
    //
    // Размер задан В МЕТРАХ, а не частотой: частота это обратная величина, и в ней невозможно узнать
    // глазом «сто шестьдесят метров». Перевод делает движок — масштаб дерева шума он измеряет сам,
    // потому что это свойство ЧУЖИХ данных, и предположение о нём однажды соврало в девяносто раз.
    //
    // Про величину амплитуд в таблице биомов: типичный размах рельефа около 0.39 * amplitude, а самые
    // высокие вершины — до 1.35 * amplitude (измеренная статистика дерева, а не догадка).
    relief_feature = 160.0
    detail_feature = 38.0

    // ---------------------------------------------------------------- пещеры
    // Пещеры — не отдельная сущность, а вычитание из плотности там, где ТРЕТИЙ слой шума проходит
    // через нуль. Ноль изолинии шума — это поверхность, а её окрестность — труба; поэтому
    // получаются именно ходы, а не шары. Полоса |шум| < cave_width и есть толщина хода, и она у
    // каждого биома СВОЯ: этим карст и отличается от степи.
    cave_feature = 74.0
    // Толщина хода задаётся В ЕДИНИЦАХ ШУМА (полоса |шум| < width), и величина у неё измеренная: при
    // среднем модуле шума 0.385 полоса 0.05 занимает около десятой части объёма — это ходы, а не
    // пустота. Первая попытка стояла на 0.14 в расчёте на размах ±1 и выедала мир целиком.

    // ---------------------------------------------------------------- воздушные острова
    // Выше пола островов мир не кончается: там висят отдельные куски камня. Механизм тот же, что у
    // рельефа, но собран НАЛОЖЕНИЕМ (`maximum`), а не суммой: остров поднимается над пустотой, а не
    // прибавляется к запасу плотности — сумма делала бы его тем толще, чем ниже он висит.
    //
    // Островом становится редкий выброс шума: порог отрезает почти всё, поэтому остаются небольшие
    // отдельные глыбы, а не второй слой рельефа.
    island_feature = 55.0
    island_amplitude = 26.0
    // Порог в тех же единицах, что и амплитуда: чем выше, тем реже и мельче острова. При 20 из 26
    // остаётся примерно верхняя десятая доля выбросов шума.
    island_threshold = 20.0
    // Пол островов в метрах: ниже их нет вовсе. Держится выше самых высоких вершин рельефа (те
    // доходят до 1.35 амплитуды, то есть до тридцати с небольшим), иначе острова срастались бы с
    // землёй и читались бы как наросты, а не как висящие куски.
    island_floor = 48.0
    // Мягкость пола в метрах: на этой высоте острова разгораются от нуля до полной силы. Резкий пол
    // давал бы у всех островов ровное плоское днище на одной высоте.
    island_soft = 24.0
    // Спад с высотой: сколько плотности острова теряют на метр подъёма. Отсюда и есть высота, на
    // которой они кончаются: (амплитуда - порог) / island_fade метров над полом.
    island_fade = 0.10

    // ---------------------------------------------------------------- каркас мира
    // Каркас — ГРУБЫЙ проход: он считается один раз, не знает про чанки и покрывает область МНОГО
    // БОЛЬШЕ видимого мира. Числа его лежат здесь же, рядом с числами чанка, потому что радиус
    // коридора и высоту маршрута читают ОБА масштаба: продублированное число однажды разъедется, и
    // чанк начнёт вырезать коридор не там, где его проложил каркас.
    //
    // Сторона мира в метрах. Видимое окно — около трёхсот метров, то есть каркас крупнее его в
    // тринадцать раз: ровно та ситуация, ради которой чанк получает не весь каркас, а ЗАПРОС по своей
    // области.
    world_span = 4096.0
    node_count = 40
    node_capacity = 64
    // Опорная высота маршрута и разброс узлов вокруг неё. Каркас НЕ знает рельефа, и это решение: он
    // говорит, где маршрут проходит, а что там делает камень — знает чанк. Отсюда и «коридор внутри
    // горы»: где земля выше маршрута, чанк вырежет тоннель, где ниже — коридор пройдёт по воздуху.
    route_altitude = 6.0
    route_wander = 30.0
    // Точек ломаной на одно звено маршрута. Это и есть ГЛАДКОСТЬ коридора: движок не знает кривых,
    // распрямление живёт на грубом масштабе, где точек сотни.
    route_flatten = 8
    route_capacity = 1024
    // Цепочек может быть много: стиль выбирается на звено, поэтому у сорока узлов их до сорока.
    route_chain_capacity = 64

    // Сколько точек маршрута и цепочек может попасть в область одного чанка. Число ИЗМЕРЕНО: при
    // восьми точках на звено и шаге узлов около 650 метров в область чанка с полем запроса попадает
    // единицы точек, поэтому 96 — троекратный запас на более густой каркас.
    chunk_route_capacity = 96
    chunk_route_chain_capacity = 8

    // ---------------------------------------------------------------- коридор
    // Радиус проходимого коридора в метрах — И ОН ЖЕ РАДИУС ВЛИЯНИЯ КАРКАСА. Из него хост выводит,
    // насколько широко запрашивать маршрут для чанка: отрезок, проходящий рядом с чанком, гнёт поле
    // ВНУТРИ него, и не спросить его значило бы получить другой мир.
    corridor_radius = 7.0
    // Насколько круто плотность растёт за стеной коридора, на метр. Больше — тоньше стена и резче
    // край; меньше — коридор размывается в широкую ложбину.
    corridor_wall = 25.0
    // Шероховатость стен ЕСТЕСТВЕННОЙ пещеры: слой деталей прибавляется к расстоянию, поэтому радиус
    // перестаёт быть постоянным, и труба читается как промытая водой, а не как просверлённая.
    corridor_roughness = 2.5

    // ТОННЕЛЬ БУНКЕРА — второй стиль, и отличается он не числом, а ГЕОМЕТРИЕЙ: сечение угловатое
    // (метрика Чебышёва), стены ровные и кромка резкая. Радиус здесь — половина стороны квадрата.
    bunker_radius = 3.5
    bunker_wall = 60.0
    // Доля звеньев маршрута, которая становится рукотворным тоннелем. Стиль выбирается на ЗВЕНО, а
    // подряд идущие звенья одного стиля становятся одной цепочкой: так у мира получаются участки, а не
    // чередование через шаг.
    bunker_share = 0.35
    // На сколько метров за радиусом ещё считать расстояние. Дальше него влияние заведомо перекрыто
    // породой, и считать его незачем; это же число входит в поле запроса.
    corridor_falloff = 6.0

    // ---------------------------------------------------------------- сущности
    // Вехи по миру: простейшие сущности, у которых есть место, наклон и род. Ставятся они НЕ по
    // сетке, а по хешу: сетка дала бы видимую регулярность на швах чанков, потому что кандидаты в
    // каждом чанке начинались бы от его начала.
    //
    // Сколько столбцов пробуется в чанке. Не «сколько будет вех»: столбец может не иметь ни одного
    // пола (весь воздух или весь камень), а может иметь несколько — пол пещеры это тоже пол.
    prop_attempts = 40
    // Доля попыток, которая доживает до вехи. Ниже — реже, но распределение остаётся тем же.
    prop_chance = 0.55
    // Насколько крутым может быть пол под вехой. Величина — вертикальная компонента нормали, то есть
    // 1 это горизонтальная площадка, 0 — стена. Круче этого веха выглядит приклеенной к скале.
    prop_slope_limit = 0.55
    // Высота вехи в метрах, от и до: род выбирается полем, а размер разбросом.
    prop_size_min = 1.6
    prop_size_max = 4.2
    // На какой высоте над полом искать свод, чтобы назвать место пещерой. Восемь метров: ниже этого
    // «пещерой» становится любая ямка под нависанием.
    prop_roof_reach = 8.0
    // Сколько вех может выдать чанк. Ёмкость покрывает ВЕСЬ объявленный диапазон `prop_attempts`
    // (каждая попытка даёт не больше одной вехи), и это не запас «на всякий случай», а условие: при
    // переполнении шаг отказывается вслух, а тихая обрезка сделала бы мир другим при том же ключе —
    // память мира привязана к номеру попытки. Измерено при этом другое: на настройках по умолчанию
    // самый населённый чанк выборки дал 26 вех при сорока попытках.
    prop_capacity = 200

    // ---------------------------------------------------------------- поверхность нулевого уровня
    // Порог, по которому идёт поверхность. Ноль — не единственно возможное значение: сдвиг порога
    // «надувает» или «съедает» вещество, и на нём видно, что поверхность считается по полю, а не
    // хранится сеткой.
    iso = 0.0
  }

  // В каких границах и с каким шагом крутить значение. Хост строит настройки, НЕ ЗНАЯ, что число
  // означает: границы объявлены рядом с самим значением, и выйти за них окно не может.
  //
  // Геометрия чанка в этот список не входит намеренно: сменить размер чанка в рантайме означает
  // перевыделить буферы всех рабочих потоков и выбросить всю арену — это ключ командной строки, а
  // не ползунок.
  ranges = {
    relief_feature = [60.0, 400.0, 10.0]
    detail_feature = [12.0, 120.0, 2.0]
    climate_feature = [200.0, 4000.0, 50.0]
    cave_feature = [30.0, 200.0, 2.0]
    island_feature = [20.0, 160.0, 5.0]
    island_amplitude = [0.0, 60.0, 1.0]
    island_threshold = [0.0, 50.0, 1.0]
    island_floor = [-64.0, 256.0, 4.0]
    island_soft = [1.0, 64.0, 1.0]
    island_fade = [0.00, 1.00, 0.01]
    prop_attempts = [0, 200, 5]
    prop_chance = [0.00, 1.00, 0.05]
    prop_slope_limit = [0.00, 1.00, 0.05]
    prop_size_min = [0.2, 10.0, 0.2]
    prop_size_max = [0.4, 20.0, 0.2]
    prop_roof_reach = [2.0, 32.0, 1.0]
    corridor_radius = [0.0, 24.0, 0.5]
    corridor_wall = [1.0, 80.0, 1.0]
    corridor_roughness = [0.0, 8.0, 0.5]
    bunker_radius = [0.0, 12.0, 0.5]
    bunker_wall = [1.0, 120.0, 2.0]
    bunker_share = [0.00, 1.00, 0.05]
    route_altitude = [-64.0, 128.0, 2.0]
    route_wander = [0.0, 96.0, 2.0]
    iso = [-20.0, 20.0, 0.5]
  }

  strings = {
    // Дерево узлов FastNoise2 закодированной строкой: граф шума — данные конфига, а не код. Дерево
    // одно на все три слоя, а различаются слои частотой и смещением зерна — так же, как у планеты.
    tree = "DQkGDA=="
  }
}

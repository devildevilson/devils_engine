// Каркас мира — ГРУБЫЙ проход, отдельная точка входа.
//
// Он считается ОДИН раз, не знает про чанки вовсе и покрывает область много больше видимого мира.
// Это ровно то разделение масштабов, которое библиотека объявляет с GN01: грубый мировой проход
// (маленький, один раз: узлы, маршруты, сводки) и мелкий чанковый (большой, по требованию).
//
// Значения у него ОБЩИЕ с чанковым генератором (`./values.tavl`), и это не экономия файла: размер
// мира, радиус коридора и высота маршрута читают оба масштаба, а продублированное число однажды
// разъедется — и тогда чанк начнёт вырезать коридор не там, где его проложил каркас.

name = skeleton

values  = ./values.tavl
buffers = ./skeleton_buffers.tavl

steps = [
  // Геймплейные узлы: то, что маршрут обязан соединить. Здесь они просто разнесены по миру, но
  // важно, что они — ПЕРВЫЕ: маршрут выводится из них, а не наоборот.
  {
    name = nodes
    body = ./scripts/W01_nodes.lua
    writes = [ nodes, skeleton_state ]
  }

  // Маршрут: обход узлов и сглаженная кривая через них, распрямленная в ЛОМАНУЮ. Кривую движок не
  // знает намеренно — Безье, Катмулл-Ром и дуги распрямляются здесь, на грубом масштабе, где точек
  // сотни, а густота распрямления и есть гладкость коридора.
  {
    name = route
    body = ./scripts/W02_route.lua
    reads = [ nodes ]
    writes = [ route_points, route_offsets, route_styles, skeleton_state ]
  }
]

// Буферы каркаса. Он грубый, поэтому здесь всё маленькое: десятки узлов и сотни точек ломаной против
// сорока трёх тысяч отсчётов у одного чанка.

{
  name = nodes
  // Геймплейный узел: мировая позиция (АБСОЛЮТНАЯ — каркас не привязан ни к какому чанку) и род.
  format = [ position = v3, kind = ui1 ]
  layout = soa
  size = node_capacity
}

{
  name = route_points
  // Ломаная маршрута в МИРОВЫХ координатах. Именно ломаная, а не кривая: движок умеет расстояние до
  // ломаной, а распрямление кривой — дело того, кто её строил.
  format = [ position = v3 ]
  layout = soa
  size = route_capacity
}

{
  name = route_offsets
  // CSR-смещения цепочек: маршрутов может быть много, и конец одного не должен соединяться с началом
  // другого — иначе между ними появился бы коридор, которого никто не строил.
  format = [ offset = ui1 ]
  layout = soa
  size = route_chain_capacity
}

{
  name = skeleton_state
  // Сколько чего получилось: та же схема, что у вершин и сущностей — ёмкость объявлена, занятая
  // длина лежит в буфере на один элемент.
  format = [ node_count = ui1, point_count = ui1, chain_count = ui1 ]
  layout = soa
  size = state_count
}

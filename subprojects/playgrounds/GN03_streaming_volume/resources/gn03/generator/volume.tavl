// Генератор GN03 — ТОЧКА ВХОДА. Один id называет свои части: значения, буферы, шаги.
//
// Отличие от планеты не в числе шагов, а в том, ЧТО генератор отдаёт. У GN02 результат — поля на
// клетках, то есть данные фиксированной длины: сколько клеток, столько высот. Здесь результат —
// ГЕОМЕТРИЯ, и её длина заранее неизвестна: сколько треугольников даст поле плотности, знает только
// само поле. Поэтому у буфера вершин объявлена ЁМКОСТЬ, а сколько занято, лежит в буфере `state` —
// обычном буфере на один элемент, как любое другое состояние между шагами.
//
// Второе отличие: этот генератор чанковый по построению. Он не считает мир целиком ни разу, а
// считает окрестность наблюдателя по одному чанку, и результат чанка зависит только от (зерно мира,
// ключ чанка). Отсюда все правила ниже: шум берётся по МИРОВОЙ позиции (а не по индексу внутри
// чанка), а решётка отсчётов на один узел шире клеток с каждой стороны — см. buffers.tavl.

name = volume

values  = ./values.tavl
buffers = ./buffers.tavl

steps = [
  // Поле плотности чанка. Всё, что здесь происходит, — апертура pointwise, а она переживает
  // чанкование ТОЧНО: элемент считается по своей мировой позиции и ничего не знает о соседях.
  {
    name = field
    body = ./scripts/S01_field.lua
    writes = [ samples ]
  }

  // Поверхность: треугольники нулевого уровня плотности. Шаг читает поле и пишет вершины плюс их
  // число. Носитель ключа объявлен ЧАНКОВЫМ в самом вызове: список вершин целиком принадлежит
  // одному проходу, и чанк заканчивает его сам.
  {
    name = surface
    body = ./scripts/S02_surface.lua
    reads = [ samples ]
    writes = [ vertices, state ]
  }

  // Сущности чанка. Шаг читает то же поле, что и поверхность, и ставит вехи на пол — то есть
  // сущность появляется НЕ рядом с миром, а ИЗ мира: место, наклон и род выводятся из поля.
  //
  // Это единственный шаг, которому нужно ВТОРОЕ зерно (`chunk_seed`): разброс внутри чанка обязан
  // быть независимым в каждом чанке, тогда как поле обязано быть непрерывным через шов. Оба зерна
  // библиотека даёт с самого начала, и здесь наконец используются оба.
  {
    name = props
    body = ./scripts/S03_props.lua
    reads = [ samples ]
    writes = [ props, state ]
  }
]

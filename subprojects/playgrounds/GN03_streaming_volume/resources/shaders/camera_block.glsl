// БЛОК КАМЕРЫ ОДИН НА ВСЕ ШЕЙДЕРЫ, и лежит он отдельным файлом не ради краткости.
//
// Блок в std140 читается по СМЕЩЕНИЯМ, а не по именам, поэтому пропуск одного поля в одной копии не
// даёт ни ошибки компиляции, ни предупреждения: все следующие поля просто читаются с чужого места.
// У GN02 на этом однажды исчез весь интерфейс — оверлей брал размер окна оттуда, где лежат параметры
// отрисовки. Пять копий раскладки руками — это пять мест, где можно забыть.
//
// - `params.x` — размер чанка в метрах: по нему рисуется сетка чанков;
// - `params.y` — дальность видимости в метрах, выведенная из ОКНА чанков: туман обязан прятать ровно
//   ту границу, за которой геометрии нет, иначе край окна виден ступенькой;
// - `params.z` — режим представления (0 затенение, 1 нормали, 2 уклон);
// - `params.w` — сила сетки чанков (0 нет, 1 есть);
// - `viewport_near` — ширина и высота окна в пикселях, ближняя плоскость, клеток в чанке.
layout(set = 0, binding = 0, std140) uniform CameraBlock {
  mat4 view_projection;
  mat4 inverse_view_projection;
  vec4 camera_position;
  vec4 sun_direction;
  vec4 sky_colour;
  vec4 params;
  vec4 viewport_near;
  vec4 reserved[3];
} camera;

{
  name = pf10_planet
  startup = true
  passes = [
    {
      name = pf10_scene
      render_target = scene_target
      subpasses = [
        { scene_color = (undefined, clear), scene_depth = (undefined, clear) },
        { scene_color = (color_attachment, store), scene_depth = (depth_attachment, store) },
        { scene_color = (color_attachment, store), scene_depth = (depth_read, store) }
      ]
      steps = [ draw_planet, draw_markers ]
    },
    {
      name = pf10_surface_decals
      render_target = label_target
      subpasses = [
        { scene_color = (color_attachment, store), scene_depth = (depth_read, store) },
        { scene_color = (color_attachment, store), scene_depth = (depth_read, store) },
        { scene_color = (transfer_src, store), scene_depth = (depth_read, store) }
      ]
      steps = [ draw_hydrology, draw_borders, draw_labels, draw_overlay ]
    },
    {
      name = pf10_present
      wait_for = [ swapchain_image ]
      subpasses = [
        { scene_color = (transfer_src, store), swapchain_image = (transfer_dst, store) },
        { scene_color = (color_attachment, store), swapchain_image = (present, store) }
      ]
      steps = [ present_scene ]
    }
  ]
  present_source = swapchain_image
}

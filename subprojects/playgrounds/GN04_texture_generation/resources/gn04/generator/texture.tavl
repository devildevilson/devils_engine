// Генератор GN04 — ТОЧКА ВХОДА.
//
// Шаг один, и это правильно: вся работа объявлена очередью внутри его тела, а тело только связывает
// поля и называет границу. Разбивать это на несколько шагов значило бы разрезать очередь ровно там,
// где она должна быть целой.

name = gn04

values  = ./values.tavl
buffers = ./buffers.tavl

steps = [
  {
    name = texture
    body = ./scripts/S01_texture.lua
    writes = [ sites, pixels, summary ]
  }
]

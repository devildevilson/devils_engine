// Буферы генератора GN04.
//
// ФОРМА вместо размера: растр объявляет `extent`, и число элементов — это произведение осей. Второго
// способа назвать ширину нет ни у одного инструмента: и разметка, и фильтр берут её У ПРИВЯЗКИ.

// Сайты областей. Их мало, поэтому позиции расставляет сама lua поэлементно — это ровно тот случай,
// который правилом разрешён: скрипт обходит множество, которое сам же перечислил.
{
  name = sites
  format = [ position = v2 ]
  layout = soa
  size = site_count
}

// Растр. Роды выбраны по СМЫСЛУ, а не по удобству: номер области и упакованный цвет — целые, потому
// что метку и байты усреднять нельзя, а близость к границе и её сглаженная версия — плавающие.
//
// Раскладка обязана быть `soa`: поле с шагом элемента непрерывным блоком на устройство не передать,
// а страйд там стоит линейно по шагу.
{
  name = pixels
  format = [
    region = ui1
    edge = v1
    smoothed = v1
    colour = ui1
  ]
  layout = soa
  extent = [ side, side ]
}

// СВОДКА — единственное, что уезжает с устройства обратно на хост. Счётчик целый: целое сложение от
// порядка не зависит, и только поэтому свёртку атомиками вообще можно пускать в очередь.
{
  name = summary
  format = [ count = ui1 ]
  layout = soa
  size = site_count
}

// Общие значения пайплайна GN04.
//
// Порогов здесь ровно столько, сколько решений принимает генератор, и каждый объявлен ОДИН раз.

{
  numbers = {
    // Разброс сайтов: доля ширины растра, на которую дрожание сдвигает регулярную россыпь.
    spread = 0.37

    // Радиус чтения фильтром, в текселях. Ноль означал бы четыре отсчёта в одной точке, то есть
    // копирование, а не сглаживание.
    blur_radius = 1.0

    // Ширина каймы у границы области, в текселях: на этом расстоянии затенение доходит до полного.
    border = 12.0

    // Насколько темна область вплотную к границе. Ноль дал бы чёрную кайму, единица — отсутствие
    // каймы вовсе.
    dim = 0.25

    // ГДЕ СЧИТАЕТСЯ ОЧЕРЕДЬ. Величина живёт в манифесте, а не подбирается на месте: все машины берут
    // одну ветку, а та, что исполнить её не может, отказывает громко (§6.4). Площадка переключает её
    // ради сверки двух путей — то есть меняет МАНИФЕСТ, а не решает по машине.
    on_device = 1

    // ЕДЕТ ЛИ РАСТР НА ХОСТ. Ноль — производственная граница: наружу только сводка, а всё остальное
    // остаётся на устройстве. Единица — граница ОСМОТРА: наружу едет весь растр, потому что смотреть
    // на него больше неоткуда.
    //
    // Работа при этом ОДНА И ТА ЖЕ, меняется только объявленная граница, и разница в передаче между
    // двумя планами и есть смысл всей площадки. Заодно это ловушка, в которую площадка уже попадала:
    // поле, не названное в `output`, на хосте так и остаётся прежним — устройство посчитало его и
    // там же и оставило, ровно как обещано.
    download_all = 0
  }
}

{
  name = frame_linear
  filter = linear
  address = clamp
  // Между уровнями цепочки интерполируем: пирамида читается через textureLod, и без этого переход между
  // уровнями был бы ступенчатым
  mipmap = linear
}
{
  // Глубина, нормали и motion читаются точечно: интерполировать их между пикселями нельзя
  name = frame_nearest
  filter = nearest
  address = clamp
}

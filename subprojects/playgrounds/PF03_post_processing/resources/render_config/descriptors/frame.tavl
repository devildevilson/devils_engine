{
  name = frame_data
  layout = [
    { resource = frame_buffer, usage = uniform, stage = all }
  ]
}
{
  // Вот и весь per-object motion: вершинный шейдер получает трансформ этого кадра и трансформ прошлого из
  // истории того же ресурса. Опознавать объекты на экране не нужно — фрагмент уже знает свой инстанс.
  name = object_data
  layout = [
    { resource = object_transforms, usage = storage_read, stage = vertex },
    { resource = object_transforms, usage = storage_read, stage = vertex, history = 1 }
  ]
}
{
  name = gbuffer_inputs
  layout = [
    { resource = scene_depth, usage = depth_read, sampler = frame_nearest, stage = compute },
    { resource = gbuffer_normal, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = gbuffer_motion, usage = sampled, sampler = frame_nearest, stage = compute }
  ]
}
{
  name = shade_write
  layout = [
    { resource = scene_color, usage = texel_write, stage = compute }
  ]
}
{
  // Репроекция: текущий кадр читается обычным биндингом, прошлый — через 'history = 1'. Из этого же
  // объявления движок выводит и порядок между кадрами: пасс-читатель ждёт пасс-затенения ПРОШЛОГО кадра.
  name = compose_inputs
  layout = [
    { resource = taa_color, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute, history = 1 },
    { resource = exposure_state, usage = texel_read, stage = compute },
    // AO здесь только для отладочного вида: сам шейдинг читает его своим сетом. Держим в этом же наборе,
    // потому что гарантированный минимум Vulkan — 4 привязанных сета, а пятый уже вне переносимости.
    { resource = ao_blurred, usage = sampled, sampler = frame_nearest, stage = compute },
    // Сырой AO нужен для отладочного вида: только сравнив его с отфильтрованным, можно судить, что делает
    // блюр — а он часть техники, а не улучшение.
    { resource = ao_raw, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = bloom_half, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = shafts_quarter, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = ao_write
  layout = [
    { resource = ao_raw, usage = texel_write, stage = compute }
  ]
}
{
  name = ao_read
  layout = [
    { resource = ao_raw, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = bloom_half, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = shafts_quarter, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = ao_blur_write
  layout = [
    { resource = ao_blurred, usage = texel_write, stage = compute }
  ]
}
{
  // Затенение читает ШЕЙДИНГ, а не пост-обработка: AO ослабляет ambient, и умножать им готовую картинку
  // значит гасить ещё и прямой солнечный свет, чего в природе не происходит.
  name = ao_final_read
  layout = [
    { resource = ao_blurred, usage = sampled, sampler = frame_nearest, stage = compute },
    // Сырой AO нужен для отладочного вида: только сравнив его с отфильтрованным, можно судить, что делает
    // блюр — а он часть техники, а не улучшение.
    { resource = ao_raw, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = bloom_half, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = shafts_quarter, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = scene_read
  layout = [
    { resource = scene_color, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = fog_write
  layout = [
    { resource = fogged_color, usage = texel_write, stage = compute }
  ]
}
{
  // Экспозиция замеряет кадр УЖЕ с туманом: туман меняет среднюю яркость, и мерить до него значило бы
  // экспонировать не ту картинку, которую увидит зритель.
  name = fogged_read
  layout = [
    { resource = fogged_color, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  // Замер экспозиции пишет новое состояние и читает прошлое (адаптация) — тот же случай «писатель он же
  // читатель», что и у накопления, и порядок между кадрами движок выводит сам.
  name = exposure_io
  layout = [
    { resource = exposure_state, usage = texel_write, stage = compute },
    { resource = exposure_state, usage = texel_read, stage = compute, history = 1 }
  ]
}
{
  // Экспозиция мерит то, что увидит зритель — то есть уже накопленный кадр
  name = taa_read
  layout = [
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  // Накопление TAA: пишем новый кадр и читаем прошлый накопленный. Снова «писатель он же читатель», и
  // кросс-кадровый порядок движок выводит сам.
  name = taa_io
  layout = [
    { resource = taa_color, usage = texel_write, stage = compute },
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute, history = 1 }
  ]
}
{
  // Понижение: читаем предыдущий уровень, пишем следующий. Первый шаг читает накопленный кадр и заодно
  // выполняет яркий проход (prefilter).
  name = bloom_down_0
  layout = [
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom_half, usage = texel_write, stage = compute },
    // Порог яркого прохода имеет смысл только ПОСЛЕ экспозиции: «ярко» — это относительно принятого
    // среднего серого, а в линейном HDR выше любой абсолютной планки оказывается почти вся сцена.
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  name = bloom_down_1
  layout = [
    { resource = bloom_half, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom_quarter, usage = texel_write, stage = compute },
    // Биндинг экспозиции есть у всех уровней, хотя нужен только первому: шейдер один на все четыре шага, и
    // layout обязан совпадать с объявленным в нём набором, даже если ветка отключена spec-константой.
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  name = bloom_down_2
  layout = [
    { resource = bloom_quarter, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom_eighth, usage = texel_write, stage = compute },
    // Биндинг экспозиции есть у всех уровней, хотя нужен только первому: шейдер один на все четыре шага, и
    // layout обязан совпадать с объявленным в нём набором, даже если ветка отключена spec-константой.
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  name = bloom_down_3
  layout = [
    { resource = bloom_eighth, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom_sixteenth, usage = texel_write, stage = compute },
    // Биндинг экспозиции есть у всех уровней, хотя нужен только первому: шейдер один на все четыре шага, и
    // layout обязан совпадать с объявленным в нём набором, даже если ветка отключена spec-константой.
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  // Повышение аддитивное: цель одновременно читается и пишется, поэтому объявлена как 'general' —
  // read-write storage image. Отдельного ресурса на каждый шаг подъёма так не требуется.
  name = bloom_up_2
  layout = [
    { resource = bloom_sixteenth, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom_eighth, usage = general, stage = compute }
  ]
}
{
  name = bloom_up_1
  layout = [
    { resource = bloom_eighth, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom_quarter, usage = general, stage = compute }
  ]
}
{
  name = bloom_up_0
  layout = [
    { resource = bloom_quarter, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom_half, usage = general, stage = compute }
  ]
}
{
  // Лучи: маска берётся с четверти пирамиды, глубина нужна чтобы лучи шли только оттуда, где нет геометрии
  name = shafts_io
  layout = [
    { resource = bloom_quarter, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = scene_depth, usage = depth_read, sampler = frame_nearest, stage = compute },
    { resource = shafts_quarter, usage = texel_write, stage = compute }
  ]
}
{
  name = compose_write
  layout = [
    { resource = composed_color, usage = texel_write, stage = compute }
  ]
}

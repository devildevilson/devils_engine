{
  name = frame_data
  layout = [
    { resource = frame_buffer, usage = uniform, stage = all }
  ]
}
{
  // Вот и весь per-object motion: вершинный шейдер получает трансформ этого кадра и трансформ прошлого из
  // истории того же ресурса. Опознавать объекты на экране не нужно — фрагмент уже знает свой инстанс.
  name = object_data
  layout = [
    { resource = object_transforms, usage = storage_read, stage = vertex },
    { resource = object_transforms, usage = storage_read, stage = vertex, history = 1 }
  ]
}
{
  name = gbuffer_inputs
  layout = [
    { resource = scene_depth, usage = depth_read, sampler = frame_nearest, stage = compute },
    { resource = gbuffer_normal, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = gbuffer_motion, usage = sampled, sampler = frame_nearest, stage = compute }
  ]
}
{
  name = shade_write
  layout = [
    { resource = scene_color, usage = texel_write, stage = compute }
  ]
}
{
  // Репроекция: текущий кадр читается обычным биндингом, прошлый — через 'history = 1'. Из этого же
  // объявления движок выводит и порядок между кадрами: пасс-читатель ждёт пасс-затенения ПРОШЛОГО кадра.
  name = compose_inputs
  layout = [
    { resource = blur_color, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute, history = 1 },
    { resource = exposure_state, usage = texel_read, stage = compute },
    // AO здесь только для отладочного вида: сам шейдинг читает его своим сетом. Держим в этом же наборе,
    // потому что гарантированный минимум Vulkan — 4 привязанных сета, а пятый уже вне переносимости.
    { resource = ao_blurred, usage = sampled, sampler = frame_nearest, stage = compute },
    // Сырой AO нужен для отладочного вида: только сравнив его с отфильтрованным, можно судить, что делает
    // блюр — а он часть техники, а не улучшение.
    { resource = ao_raw, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 0 },
    { resource = shafts_quarter, usage = sampled, sampler = frame_linear, stage = compute },
    // Гистограмма для отладочного вида. Обнуление стоит в НАЧАЛЕ своего пасса именно поэтому: иначе к моменту
    // компоновки буфер уже пуст, и посмотреть на распределение нечем.
    { resource = luminance_histogram, usage = storage_read, stage = compute },
    // Таблица грейда. Читается ЛИНЕЙНЫМ сэмплером: интерполяция — часть техники, а не сглаживание. Измерено:
    // при nearest даже ТОЖДЕСТВО через таблицу уезжает на 8.6 RMSE (максимум 23 уровня) против 0.41 с
    // линейным, то есть в 21 раз.
    { resource = color_lut, usage = sampled, sampler = frame_linear, stage = compute },
    // ПРОШЛОЕ ПОКОЛЕНИЕ таблицы: на условном счётчике 'history = 1' считает не кадры, а сдвиги счётчика, то
    // есть даёт предыдущую запечённую таблицу. Нужна для плавного перехода при смене настроек грейда — иначе
    // картинка скачком меняет цвет в кадре запекания. Платой служит частота сдвигов: движок требует у такого
    // счётчика разрыв не меньше frames_in_flight, и тогда прошлое поколение записано за горизонтом фенса.
    { resource = color_lut, usage = sampled, sampler = frame_linear, stage = compute, history = 1 },
    // Пирамида глубины для отладочных видов. Биндинг БЕЗ уровня — вид на всю цепочку, потому что проверка
    // консервативности обращается к каждому уровню через texelFetch с явным LOD.
    { resource = hiz, usage = sampled, sampler = frame_nearest, stage = compute },
    // Диагностика марша SSR: шаги и судьба луча. Только для отладочных видов — сама картинка её не читает.
    { resource = ssr_stats, usage = sampled, sampler = frame_nearest, stage = compute },
    // Маска CoC для отладочного вида
    { resource = dof_coc, usage = sampled, sampler = frame_nearest, stage = compute },
    // Расширенный максимум motion по плиткам: отладочный вид показывает, откуда берётся длина шлейфа
    { resource = motion_tile_dilated, usage = sampled, sampler = frame_nearest, stage = compute },
    // Temporal metadata отдельно от цвета: rejection нужен отладочному виду, а alpha цвета сохраняет туман.
    { resource = taa_meta, usage = sampled, sampler = frame_nearest, stage = compute }
  ]
}
{
  name = ao_write
  layout = [
    { resource = ao_raw, usage = texel_write, stage = compute }
  ]
}
{
  name = ao_read
  layout = [
    { resource = ao_raw, usage = sampled, sampler = frame_nearest, stage = compute }
  ]
}
{
  name = ao_blur_write
  layout = [
    { resource = ao_blurred, usage = texel_write, stage = compute }
  ]
}
{
  // Затенение читает ШЕЙДИНГ, а не пост-обработка: AO ослабляет ambient, и умножать им готовую картинку
  // значит гасить ещё и прямой солнечный свет, чего в природе не происходит.
  name = ao_final_read
  layout = [
    { resource = ao_blurred, usage = sampled, sampler = frame_nearest, stage = compute }
  ]
}
{
  name = scene_read
  layout = [
    { resource = scene_color, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = fog_write
  layout = [
    { resource = fogged_color, usage = texel_write, stage = compute }
  ]
}
{
  // Сбор гистограммы: атомарные сложения, поэтому 'general' (read-modify-write)
  name = histogram_build
  layout = [
    { resource = blur_color, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = luminance_histogram, usage = general, stage = compute }
  ]
}
{
  // Разбор гистограммы ТОЛЬКО читает её. Разные юсаджи у сбора и разбора — не формальность: барьеры движок
  // выводит из смены юсаджа, и при одинаковом юсадже между двумя шагами барьера не будет вовсе, то есть
  // разбор прочитал бы недописанную гистограмму.
  name = exposure_resolve
  layout = [
    { resource = luminance_histogram, usage = storage_read, stage = compute },
    { resource = exposure_state, usage = texel_write, stage = compute },
    { resource = exposure_state, usage = texel_read, stage = compute, history = 1 }
  ]
}
{
  // Обнуление после разбора отдельным шагом с юсаджем ЗАПИСИ — по той же причине: иначе не будет барьера
  // между чтением и обнулением.
  name = histogram_clear
  layout = [
    { resource = luminance_histogram, usage = storage_write, stage = compute }
  ]
}
{
  // Накопление TAA: пишем новый кадр и читаем прошлый накопленный. Снова «писатель он же читатель», и
  // кросс-кадровый порядок движок выводит сам.
  name = taa_io
  layout = [
    { resource = taa_color, usage = texel_write, stage = compute },
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute, history = 1 },
    { resource = taa_meta, usage = texel_write, stage = compute },
    { resource = taa_meta, usage = sampled, sampler = frame_nearest, stage = compute, history = 1 }
  ]
}
{
  // Понижение: читаем уровень k, пишем уровень k+1 ОДНОГО ресурса. Конфликта юсаджей тут нет, потому что
  // проверка ведётся по паре (ресурс, уровень): это разные подресурсы с разными layout.
  name = bloom_down_0
  layout = [
    { resource = blur_color, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = bloom, usage = texel_write, stage = compute, mip = 0 },
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  name = bloom_down_1
  layout = [
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 0 },
    { resource = bloom, usage = texel_write, stage = compute, mip = 1 },
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  name = bloom_down_2
  layout = [
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 1 },
    { resource = bloom, usage = texel_write, stage = compute, mip = 2 },
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  name = bloom_down_3
  layout = [
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 2 },
    { resource = bloom, usage = texel_write, stage = compute, mip = 3 },
    { resource = exposure_state, usage = texel_read, stage = compute }
  ]
}
{
  // Подъём аддитивный: цель одновременно читается и пишется, поэтому 'general' — read-write storage image,
  // и обязательно с указанием уровня: storage-вид на цепочку невозможен.
  name = bloom_up_2
  layout = [
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 3 },
    { resource = bloom, usage = general, stage = compute, mip = 2 }
  ]
}
{
  name = bloom_up_1
  layout = [
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 2 },
    { resource = bloom, usage = general, stage = compute, mip = 1 }
  ]
}
{
  name = bloom_up_0
  layout = [
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 1 },
    { resource = bloom, usage = general, stage = compute, mip = 0 }
  ]
}
{
  // Лучи: маска берётся с четверти пирамиды, глубина нужна чтобы лучи шли только оттуда, где нет геометрии
  name = shafts_io
  layout = [
    { resource = bloom, usage = sampled, sampler = frame_linear, stage = compute, mip = 1 },
    { resource = scene_depth, usage = depth_read, sampler = frame_nearest, stage = compute },
    { resource = shafts_quarter, usage = texel_write, stage = compute }
  ]
}
{
  name = compose_write
  layout = [
    { resource = composed_color, usage = texel_write, stage = compute }
  ]
}
{
  // Запекание таблицы грейда. Ни одного входа кроме кадровой юниформы: таблица — чистая функция настроек,
  // а не кадра, поэтому пасс от него не зависит вообще.
  name = lut_write
  layout = [
    { resource = color_lut, usage = texel_write, stage = compute }
  ]
}
{
  // Нулевой уровень пирамиды: из буфера глубины. Уровень называется явно — у storage-вида нет LOD.
  name = hiz_first
  layout = [
    { resource = scene_depth, usage = depth_read, sampler = frame_nearest, stage = compute },
    { resource = hiz, usage = texel_write, stage = compute, mip = 0 }
  ]
}
{
  name = hiz_down_1
  layout = [
    { resource = hiz, usage = sampled, sampler = frame_nearest, stage = compute, mip = 0 },
    { resource = hiz, usage = texel_write, stage = compute, mip = 1 }
  ]
}
{
  name = hiz_down_2
  layout = [
    { resource = hiz, usage = sampled, sampler = frame_nearest, stage = compute, mip = 1 },
    { resource = hiz, usage = texel_write, stage = compute, mip = 2 }
  ]
}
{
  name = hiz_down_3
  layout = [
    { resource = hiz, usage = sampled, sampler = frame_nearest, stage = compute, mip = 2 },
    { resource = hiz, usage = texel_write, stage = compute, mip = 3 }
  ]
}
{
  name = hiz_down_4
  layout = [
    { resource = hiz, usage = sampled, sampler = frame_nearest, stage = compute, mip = 3 },
    { resource = hiz, usage = texel_write, stage = compute, mip = 4 }
  ]
}
{
  name = hiz_down_5
  layout = [
    { resource = hiz, usage = sampled, sampler = frame_nearest, stage = compute, mip = 4 },
    { resource = hiz, usage = texel_write, stage = compute, mip = 5 }
  ]
}
{
  // Входы SSR: затуманенный кадр и пирамида глубины (вид на всю цепочку — марш обращается к любому уровню)
  name = ssr_read
  layout = [
    { resource = fogged_color, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = hiz, usage = sampled, sampler = frame_nearest, stage = compute }
  ]
}
{
  name = ssr_write
  layout = [
    { resource = reflected_color, usage = texel_write, stage = compute },
    { resource = ssr_stats, usage = texel_write, stage = compute }
  ]
}
{
  // Накопление TAA читает кадр УЖЕ с отражениями
  name = reflected_read
  layout = [
    { resource = reflected_color, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = dof_coc_write
  layout = [
    { resource = dof_coc, usage = texel_write, stage = compute }
  ]
}
{
  // Нулевой уровень пирамиды боке: из накопленного кадра и маски CoC
  name = dof_down_0
  layout = [
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = dof_coc, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = dof_pyramid, usage = texel_write, stage = compute, mip = 0 }
  ]
}
{
  name = dof_down_1
  layout = [
    { resource = dof_pyramid, usage = sampled, sampler = frame_linear, stage = compute, mip = 0 },
    { resource = dof_coc, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = dof_pyramid, usage = texel_write, stage = compute, mip = 1 }
  ]
}
{
  name = dof_down_2
  layout = [
    { resource = dof_pyramid, usage = sampled, sampler = frame_linear, stage = compute, mip = 1 },
    { resource = dof_coc, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = dof_pyramid, usage = texel_write, stage = compute, mip = 2 }
  ]
}
{
  name = dof_down_3
  layout = [
    { resource = dof_pyramid, usage = sampled, sampler = frame_linear, stage = compute, mip = 2 },
    { resource = dof_coc, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = dof_pyramid, usage = texel_write, stage = compute, mip = 3 }
  ]
}
{
  // Сбор боке: кадр, маска и вся цепочка пирамиды (уровень выбирается по радиусу, поэтому биндинг без 'mip')
  name = dof_gather_read
  layout = [
    { resource = taa_color, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = dof_coc, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = dof_pyramid, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = dof_write
  layout = [
    { resource = dof_color, usage = texel_write, stage = compute }
  ]
}
{
  name = motion_tile_write
  layout = [
    { resource = gbuffer_motion, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = motion_tile_max, usage = texel_write, stage = compute }
  ]
}
{
  name = motion_dilate_write
  layout = [
    { resource = motion_tile_max, usage = sampled, sampler = frame_nearest, stage = compute },
    { resource = motion_tile_dilated, usage = texel_write, stage = compute }
  ]
}
{
  name = motion_blur_read
  layout = [
    { resource = dof_color, usage = sampled, sampler = frame_linear, stage = compute },
    { resource = motion_tile_dilated, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}
{
  name = motion_blur_write
  layout = [
    { resource = blur_color, usage = texel_write, stage = compute }
  ]
}
{
  // Forward-ветвь: истории объекта не нужно, потому что motion-векторы нужны репроекции и motion blur, а их
  // в MSAA-ветви нет. Один биндинг вместо двух — развилка видна уже в объявлении.
  name = forward_objects
  layout = [
    { resource = object_transforms, usage = storage_read, stage = vertex }
  ]
}
{
  name = resolved_read
  layout = [
    { resource = resolved_color, usage = sampled, sampler = frame_linear, stage = compute }
  ]
}

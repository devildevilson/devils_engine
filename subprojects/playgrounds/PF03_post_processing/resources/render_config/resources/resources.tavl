{
  name = swapchain_image
  format = swapchain4
  role = present
  size = viewport
  swap = swapchain
}
{
  // Тонкий G-buffer: глубина + нормаль + motion. Альбедо в него НЕ кладём — площадка остаётся forward,
  // G-buffer здесь нужен как набор атрибутов для экранных эффектов, а не как переход на deferred.
  name = scene_depth
  format = d32
  role = depth
  size = viewport_render
  swap = per_frame
}
{
  // Мировая нормаль в октаэдральной упаковке: две компоненты вместо трёх при том же качестве.
  name = gbuffer_normal
  format = sf2
  role = gbuffer_normal
  size = viewport_render
  swap = per_frame
}
{
  // Motion vector в UV кадра: prev_uv - cur_uv, то есть куда СМЕСТИТЬСЯ, чтобы попасть в прошлый кадр.
  name = gbuffer_motion
  format = sf2
  role = gbuffer_velocity
  size = viewport_render
  swap = per_frame
}
{
  // Затенённый кадр до тумана/SSR/TAA. Историей служит уже итог temporal resolve, а не этот промежуточный свет.
  name = scene_color
  format = sf4
  role = hdr_color
  size = viewport_render
  swap = per_frame
}
{
  // Сырое ambient occlusion: .r = множитель затенения, .g = линейная глубина этого текселя. Глубина нужна
  // для depth-aware блюра и апсемпла — обычный bilinear протекает через силуэты (урок PF02).
  name = ao_raw
  format = sf2
  role = shadow_mask
  size = viewport_render_half
  swap = per_frame
}
{
  name = ao_blurred
  format = sf2
  role = shadow_mask
  size = viewport_render_half
  swap = per_frame
}
{
  // Кадр после тумана. Отдельный ресурс, а не запись на месте: пасс не может держать одну копию сразу как
  // цель записи и как источник выборки — это два разных layout, и один биндинг не обещает оба.
  name = fogged_color
  format = sf4
  role = hdr_color
  size = viewport_render
  swap = per_frame
}
{
  // Накопленный кадр TAA. Историей служит он сам: копить надо РЕЗУЛЬТАТ накопления, а не сырой кадр —
  // иначе усреднения по многим кадрам не получится, будет смешивание всего двух. Альфа сохраняет
  // пропускание тумана; temporal-метаданные намеренно вынесены отдельно, чтобы у канала не было двух смыслов.
  name = taa_color
  format = sf4
  role = history_color
  size = viewport
  swap = per_frame
}
{
  // Состояние temporal resolve в разрешении дисплея: .r = накопленный эффективный вес low-resolution
  // отсчётов с учётом их tent-footprint, .g = доля отвергнутой истории. Отдельный ресурс нужен не ради удобства:
  // taa_color.a уже принадлежит пропусканию тумана, а счётчик сам является историей и репроецируется.
  name = taa_meta
  format = sf2
  role = postprocess_output
  size = viewport
  swap = per_frame
}
{
  // Пирамида bloom ОДНИМ ресурсом с мип-цепочкой: уровень 0 — половина кадра, дальше вдвое. Раньше это были
  // четыре отдельных ресурса с размерами через declare_values — работало, но стоило четырёх объявлений,
  // четырёх контейнеров и четырёх наборов дескрипторов.
  name = bloom
  format = sf4
  role = bloom_mip
  size = viewport_half
  mips = 4
  swap = per_frame
}
{
  // Световые лучи считаются на четверти той же пирамиды: маска ярких пикселей у них общая с bloom, различается
  // только фильтр — радиальный вместо изотропного.
  name = shafts_quarter
  format = sf4
  role = bloom
  size = viewport_quarter
  swap = per_frame
}
{
  // Что показываем на экране: выбранный debug-режим либо итоговая картинка
  name = composed_color
  format = sf4
  role = hdr_color
  size = viewport
  swap = per_frame
}
{
  // Трансформы объектов: только ТЕКУЩИЙ кадр. Прошлый не дублируется руками — его отдаёт история этого же
  // ресурса (`history = 1` в дескрипторе). Ресурс живёт на per_frame, поэтому «кадр назад» здесь честно кадр.
  name = object_transforms
  format = v4v4
  role = upload
  size = scene_instances
  swap = per_frame
}
{
  // Гистограмма яркости кадра. Буфер, а не картинка: сюда пишут атомарными сложениями, и это единственная
  // структура в цепочке, которой нужен read-modify-write из множества инвокаций.
  name = luminance_histogram
  format = ui1
  role = material_data
  size = histogram_bins
  swap = per_frame
}
{
  // Состояние экспозиции: картинка 1x1. История нужна для АДАПТАЦИИ — новая экспозиция считается от
  // прошлой, иначе яркость дёргалась бы каждый кадр вместо плавного привыкания глаза.
  name = exposure_state
  format = sf4
  role = exposure
  size = one
  swap = per_frame
}
{
  name = frame_buffer
  format = mat4mat4mat4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4v4
  role = upload
  size = one
  swap = per_frame
}
{
  // Запечённая таблица грейда: трёхмерная картинка на УСЛОВНОМ счётчике. Таблица — чистая функция настроек,
  // то есть кэш: её перезапекает пасс `pf03_grade_lut`, привязанный к тому же счётчику, и только в кадрах,
  // где хост этот счётчик сдвинул. Копий две, а не одна: в момент перезаписи кадры в полёте ещё читают старое
  // содержимое. Период объявлен явно, потому что счётчик хостовый и движок его частоту знать не может.
  // У объёмного ресурса копия — ОТДЕЛЬНЫЙ образ (слои у 3D-образа Vulkan запрещает), и это цена третьей оси.
  // Хранится в кодированных shaper'ом координатах — тогда
  // нейтральный грейд становится ТОЖДЕСТВОМ в этих координатах, а трилинейная интерполяция воспроизводит
  // линейную функцию точно, то есть у тождества нет ошибки табулирования по построению.
  name = color_lut
  format = sf4
  role = color_lut
  size = color_lut_size
  swap = grade_cache
  type = doublebuffer
}
{
  // Пирамида глубины (Hi-Z): .r = минимум, .g = максимум по блоку. Инфраструктура, а не эффект: её просят SSR,
  // отсечение и depth of field, поэтому она строится раньше своих потребителей.
  //
  // Формат ТРИДЦАТИДВУХБИТНЫЙ сознательно. У половинной точности шаг около единицы на 5e-4, а округление идёт
  // к ближайшему — то есть минимум может округлиться ВВЕРХ, а максимум ВНИЗ, и пирамида перестаёт быть
  // консервативной именно там, где марш на неё полагается.
  //
  // Шесть уровней, а не 'auto' (для 1280x720 их было бы одиннадцать): каждому уровню в конфиге нужен свой шаг
  // и свой дескриптор с 'mip = k', и способа записать «шаг на каждый уровень» одной строкой пока нет.
  name = hiz
  format = v2
  role = hi_z
  size = viewport_render
  mips = 6
  swap = per_frame
}
{
  // Кадр с добавленными отражениями. Отдельный ресурс, а не запись на месте: пасс не может держать одну копию
  // сразу целью записи и источником выборки. SSR читает ЗАТУМАНЕННЫЙ кадр, поэтому отражения наследуют
  // аэроперспективу, и стоит он ДО накопления — тогда шум марша усредняет TAA, а не отдельный денойзер.
  name = reflected_color
  format = sf4
  role = hdr_color
  size = viewport_render
  swap = per_frame
}
{
  // Диагностика марша: шаги, судьба луча, вес. Нужна не для картинки, а чтобы сравнить иерархический марш с
  // эталонным линейным численно — «выглядит так же» про марш ничего не доказывает.
  name = ssr_stats
  format = sf4
  role = postprocess_output
  size = viewport_render
  swap = per_frame
}
{
  // Круг нерезкости: .r = CoC в пикселях СО ЗНАКОМ (минус — передний план), .g = линейная глубина для
  // depth-aware выборки. Отдельным ресурсом, потому что его читают и пирамида, и сбор, и отладочный вид.
  name = dof_coc
  format = sf2
  role = postprocess_output
  size = viewport
  swap = per_frame
}
{
  // Пирамида цвета для боке: .rgb = цвет, .a = средний |CoC| по блоку. Уровень 0 — половина кадра.
  // Пирамида покупает ПОКРЫТИЕ пятна при фиксированном числе проб, а не скорость (см. README, срез 11).
  name = dof_pyramid
  format = sf4
  role = postprocess_input
  size = viewport_half
  mips = 4
  swap = per_frame
}
{
  // Кадр после глубины резкости. Дальше по цепочке его читают замер экспозиции, пирамида bloom и компоновка:
  // размытие делает ОБЪЕКТИВ, то есть сенсор видит уже размытый свет.
  name = dof_color
  format = sf4
  role = hdr_color
  size = viewport
  swap = per_frame
}
{
  // Максимальный по модулю motion-вектор плитки и он же после расширения на соседей. Два ресурса, а не запись
  // на месте: расширение читает всю окрестность, поэтому источник и цель обязаны быть разными.
  name = motion_tile_max
  format = sf2
  role = gbuffer_velocity
  size = viewport_tile
  swap = per_frame
}
{
  name = motion_tile_dilated
  format = sf2
  role = gbuffer_velocity
  size = viewport_tile
  swap = per_frame
}
{
  // Кадр после motion blur. Дальше по цепочке его читают замер экспозиции, пирамида bloom и компоновка:
  // шторка — часть съёмки, значит сенсор видит уже смазанный свет.
  name = blur_color
  format = sf4
  role = hdr_color
  size = viewport
  swap = per_frame
}
{
  // МНОГОСЭМПЛОВЫЙ цвет forward-ветви. 'samples' — свойство ресурса, потому что определяет аллокацию: память
  // вложения растёт линейно по сэмплам, и это главная цена MSAA, а не арифметика.
  name = forward_color
  format = sf4
  role = lighting_result
  size = viewport
  samples = 4
  swap = per_frame
}
{
  // Многосэмпловая ГЛУБИНА. В Vulkan 1.0 это совершенно законно — нельзя только её РЕЗОЛВИТЬ (для этого нужен
  // depth_stencil_resolve, ядро с 1.2). Forward-рендеру резолв глубины и не нужен: глубина живёт ровно внутри
  // пасса, для теста. А экранные эффекты, которым нужна глубина ПОСЛЕ пасса, с MSAA не согласуются в принципе —
  // они читают один сэмпл.
  name = forward_depth
  format = d32
  role = depth
  size = viewport
  samples = 4
  swap = per_frame
}
{
  // Цель resolve: односэмпловая по определению. Альфа несёт долю покрытых сэмплов, поэтому по ней же
  // подмешивается небо — в forward-ветви нет G-buffer'а, и «пустой пиксель» опознаётся именно так.
  name = resolved_color
  format = sf4
  role = lighting_result
  size = viewport
  swap = per_frame
}

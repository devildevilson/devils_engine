{
  name = pf03_post
  startup = true
  passes = [
    {
      // Тонкий G-buffer одним проходом: нормаль, motion и глубина
      name = pf03_gbuffer
      render_target = gbuffer_target
      subpasses = [
        {
          gbuffer_normal = (undefined, clear),
          gbuffer_motion = (undefined, clear),
          scene_depth = (undefined, clear)
        },
        {
          gbuffer_normal = (color_attachment, store),
          gbuffer_motion = (color_attachment, store),
          scene_depth = (depth_attachment, store)
        },
        {
          gbuffer_normal = (sampled, store),
          gbuffer_motion = (sampled, store),
          scene_depth = (depth_read, store)
        }
      ]
      steps = [ draw_gbuffer ]
    },
    {
      // Пирамида глубины. Стоит сразу за G-buffer, потому что это ИНФРАСТРУКТУРА: её ждут SSR, отсечение и
      // depth of field, а не какой-то один эффект. Шесть шагов одним пассом — барьеры между уровнями движок
      // выводит из дескрипторов (у пары (ресурс, уровень) свой layout), а группы submit'а не тратятся.
      name = pf03_hiz
      subpasses = [
        {
          scene_depth = (depth_read, store),
          hiz = (texel_write, store)
        }
      ]
      steps = [ build_hiz_0, build_hiz_1, build_hiz_2, build_hiz_3, build_hiz_4, build_hiz_5 ]
    },
    {
      // SSAO в половинном разрешении плюс depth-aware блюр: сырой AO всегда шумный, и блюр — часть техники,
      // а не улучшение. Оба пасса до шейдинга, потому что AO нужен именно ему.
      name = pf03_ao
      subpasses = [
        {
          scene_depth = (depth_read, store),
          gbuffer_normal = (sampled, store),
          ao_raw = (texel_write, store)
        }
      ]
      steps = [ compute_ao ]
    },
    {
      name = pf03_ao_blur
      subpasses = [
        {
          ao_raw = (sampled, store),
          ao_blurred = (texel_write, store)
        }
      ]
      steps = [ blur_ao ]
    },
    {
      name = pf03_shade
      subpasses = [
        {
          scene_depth = (depth_read, store),
          gbuffer_normal = (sampled, store),
          ao_blurred = (sampled, store),
          scene_color = (texel_write, store)
        }
      ]
      steps = [ shade_scene ]
    },
    {
      // Туман и аэроперспектива: применяются в ЛИНЕЙНОМ HDR до экспозиции, потому что это яркость сцены,
      // а не постобработка изображения.
      name = pf03_fog
      subpasses = [
        {
          scene_depth = (depth_read, store),
          scene_color = (sampled, store),
          fogged_color = (texel_write, store)
        }
      ]
      steps = [ apply_fog ]
    },
    {
      // Отражения в экранном пространстве по пирамиде глубины. Стоят ПОСЛЕ тумана и ДО накопления: отражения
      // это свет, поэтому они должны попасть и в замер экспозиции, и в bloom, а шум марша усредняет TAA.
      name = pf03_ssr
      subpasses = [
        {
          scene_depth = (depth_read, store),
          gbuffer_normal = (sampled, store),
          hiz = (sampled, store),
          fogged_color = (sampled, store),
          reflected_color = (texel_write, store),
          ssr_stats = (texel_write, store)
        }
      ]
      steps = [ trace_ssr ]
    },
    {
      // Накопление TAA: репроекция прошлого накопленного кадра по motion-векторам плюс neighbourhood clamp
      name = pf03_taa
      subpasses = [
        {
          gbuffer_motion = (sampled, store),
          scene_depth = (depth_read, store),
          reflected_color = (sampled, store),
          taa_color = (texel_write, store)
        }
      ]
      steps = [ resolve_taa ]
    },
    {
      // Глубина резкости. Стоит ПОСЛЕ накопления и ДО замера экспозиции, потому что размывает ОБЪЕКТИВ: сенсор
      // видит уже размытый свет, значит и замер, и bloom обязаны работать по размытому кадру. Пять шагов одним
      // пассом: маска CoC, четыре уровня пирамиды боке и сбор.
      name = pf03_dof
      subpasses = [
        {
          scene_depth = (depth_read, store),
          taa_color = (sampled, store),
          dof_coc = (texel_write, store),
          dof_pyramid = (texel_write, store),
          dof_color = (texel_write, store)
        }
      ]
      steps = [ compute_dof_coc, dof_down_half, dof_down_1, dof_down_2, dof_down_3, gather_dof ]
    },
    {
      // Motion blur: интеграл яркости за время открытой шторки. Стоит ПОСЛЕ глубины резкости (сначала объектив,
      // потом шторка) и ДО замера экспозиции. Три шага одним пассом: максимум motion по плиткам, расширение
      // максимума на соседние плитки и сам сбор вдоль вектора.
      name = pf03_motion_blur
      subpasses = [
        {
          gbuffer_motion = (sampled, store),
          scene_depth = (depth_read, store),
          dof_color = (sampled, store),
          motion_tile_max = (texel_write, store),
          motion_tile_dilated = (texel_write, store),
          blur_color = (texel_write, store)
        }
      ]
      steps = [ build_motion_tiles, dilate_motion_tiles, apply_motion_blur ]
    },
    {
      // Замер яркости кадра и адаптация экспозиции. Отдельным пассом, потому что сводит весь кадр в один
      // тексель: следующему пассу нужен уже готовый результат.
      name = pf03_exposure
      subpasses = [
        {
          blur_color = (sampled, store),
          luminance_histogram = (general, store),
          exposure_state = (texel_write, store)
        }
      ]
      steps = [ clear_histogram, build_histogram, measure_exposure ]
    },
    {
      // Пирамида bloom: четыре понижения одним пассом. Каждый шаг читает предыдущий уровень и пишет следующий,
      // барьеры между ними выводятся из дескрипторов шагов. Отдельные пассы тут не нужны и вредны: submit
      // ограничен шестнадцатью группами.
      name = pf03_bloom_down
      subpasses = [
        {
          blur_color = (sampled, store),
          exposure_state = (texel_read, store),
          bloom = (texel_write, store)
        }
      ]
      steps = [ bloom_down_half, bloom_down_quarter, bloom_down_eighth, bloom_down_sixteenth ]
    },
    {
      // Подъём аддитивный, цель читается и пишется как general
      name = pf03_bloom_up
      subpasses = [
        {
          bloom = (general, store)
        }
      ]
      steps = [ bloom_up_eighth, bloom_up_quarter, bloom_up_half ]
    },
    {
      name = pf03_shafts
      subpasses = [
        {
          bloom = (sampled, store),
          scene_depth = (depth_read, store),
          shafts_quarter = (texel_write, store)
        }
      ]
      steps = [ draw_shafts ]
    },
    {
      // Запекание таблицы грейда. Отдельный пасс, потому что он не зависит НИ ОТ ЧЕГО в кадре: таблица —
      // функция настроек. Отсюда и условный счётчик: перезапекать её каждый кадр не нужно, и в кадрах без
      // сдвига пасс не пишет ни одной команды — в отчёте таймстемпов это видно как ~0 мс.
      name = pf03_grade_lut
      // Пасс исполняется только в кадрах, где хост сдвинул этот счётчик. Объявлено ЯВНО, чтобы из конфига было
      // видно: исполнение зависит от внешних событий, а не от кадра.
      counter = grade_cache
      subpasses = [
        {
          color_lut = (texel_write, store)
        }
      ]
      steps = [ bake_grade_lut ]
    },
    {
      // Читает историю scene_color: кросс-кадровый порядок с pf03_shade выводится, а не объявляется
      name = pf03_compose
      subpasses = [
        {
          color_lut = (sampled, store),
          hiz = (sampled, store),
          ssr_stats = (sampled, store),
          dof_coc = (sampled, store),
          blur_color = (sampled, store),
          motion_tile_dilated = (sampled, store),
          scene_depth = (depth_read, store),
          gbuffer_motion = (sampled, store),
          taa_color = (sampled, store),
          ao_blurred = (sampled, store),
          ao_raw = (sampled, store),
          bloom = (sampled, store),
          shafts_quarter = (sampled, store),
          luminance_histogram = (storage_read, store),
          exposure_state = (texel_read, store),
          composed_color = (texel_write, store)
        }
      ]
      steps = [ compose_frame ]
    },
    {
      name = pf03_present
      wait_for = [ swapchain_image ]
      subpasses = [
        { composed_color = (transfer_src, store), swapchain_image = (transfer_dst, store) },
        { composed_color = (transfer_src, store), swapchain_image = (present, store) }
      ]
      steps = [ present_composed ]
    }
  ]
  present_source = swapchain_image
}
{
  // РЕФЕРЕНСНЫЙ FORWARD С MSAA — отдельный граф, а не тумблер, и это главное про MSAA. Здесь нет G-buffer'а,
  // нет накопления, нет экранных эффектов: почти всё, что делает цепочка pf03_post, простому проекту не нужно,
  // а часть из этого с MSAA и не согласуется. Три пасса: рисуем со сглаживанием и резолвим, приводим к
  // отображаемому диапазону, показываем.
  name = pf03_forward
  passes = [
    {
      // Освещение считается прямо при растеризации. Многосэмпловые цвет и глубина плюс цель resolve одним
      // пассом: resolve делает фиксированная функция в конце подпасса, то есть даром по сравнению с ручным
      // проходом.
      name = pf03_forward_draw
      render_target = forward_target
      subpasses = [
        {
          forward_color = (undefined, clear),
          forward_depth = (undefined, clear),
          resolved_color = (undefined, clear)
        },
        {
          forward_color = (color_attachment, store),
          forward_depth = (depth_attachment, store),
          resolved_color = (resolve_attachment, store)
        },
        {
          forward_color = (color_attachment, store),
          forward_depth = (depth_attachment, store),
          resolved_color = (sampled, store)
        }
      ]
      steps = [ draw_forward ]
    },
    {
      // Экспозиция, кривая, дизер и небо по покрытию — ровно то, что нужно простому проекту, и ничего больше
      name = pf03_forward_output
      subpasses = [
        {
          resolved_color = (sampled, store),
          composed_color = (texel_write, store)
        }
      ]
      steps = [ forward_output ]
    },
    {
      name = pf03_forward_present
      wait_for = [ swapchain_image ]
      subpasses = [
        { composed_color = (transfer_src, store), swapchain_image = (transfer_dst, store) },
        { composed_color = (transfer_src, store), swapchain_image = (present, store) }
      ]
      steps = [ present_composed ]
    }
  ]
  present_source = swapchain_image
}
{
  // Тот же forward БЕЗ MSAA — честная база для сравнения. Отличается от pf03_forward ровно многосэмпловостью:
  // ни резолва, ни многосэмпловых вложений, дальше та же пара пассов. Именно на этой паре графов и мерится,
  // что MSAA даёт и чего стоит.
  name = pf03_forward_plain
  passes = [
    {
      name = pf03_plain_draw
      render_target = forward_plain_target
      subpasses = [
        {
          resolved_color = (undefined, clear),
          scene_depth = (undefined, clear)
        },
        {
          resolved_color = (color_attachment, store),
          scene_depth = (depth_attachment, store)
        },
        {
          resolved_color = (sampled, store),
          scene_depth = (depth_read, store)
        }
      ]
      steps = [ draw_forward_plain ]
    },
    {
      name = pf03_plain_output
      subpasses = [
        {
          resolved_color = (sampled, store),
          composed_color = (texel_write, store)
        }
      ]
      steps = [ forward_output ]
    },
    {
      name = pf03_plain_present
      wait_for = [ swapchain_image ]
      subpasses = [
        { composed_color = (transfer_src, store), swapchain_image = (transfer_dst, store) },
        { composed_color = (transfer_src, store), swapchain_image = (present, store) }
      ]
      steps = [ present_composed ]
    }
  ]
  present_source = swapchain_image
}

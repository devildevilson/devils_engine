{
  name = draw_gbuffer
  material = gbuffer_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ frame_data, object_data ]
  command = "draw"
}
{
  // Нулевой уровень: копия глубины в (min, max). Дальше пять понижений min/max по блокам 2x2.
  name = build_hiz_0
  material = hiz_first_material
  sets = [ frame_data, hiz_first ]
  command = "dispatch constant screen_dispatch"
}
{
  name = build_hiz_1
  material = hiz_down_material
  sets = [ frame_data, hiz_down_1 ]
  command = "dispatch constant half_dispatch"
}
{
  name = build_hiz_2
  material = hiz_down_material
  sets = [ frame_data, hiz_down_2 ]
  command = "dispatch constant quarter_dispatch"
}
{
  name = build_hiz_3
  material = hiz_down_material
  sets = [ frame_data, hiz_down_3 ]
  command = "dispatch constant eighth_dispatch"
}
{
  name = build_hiz_4
  material = hiz_down_material
  sets = [ frame_data, hiz_down_4 ]
  command = "dispatch constant sixteenth_dispatch"
}
{
  name = build_hiz_5
  material = hiz_down_material
  sets = [ frame_data, hiz_down_5 ]
  command = "dispatch constant thirtysecond_dispatch"
}
{
  // Число проб — specialization-константа шага: это тир качества, а его смена стоит только пересборки
  // pipeline, а не нового варианта шейдера (правило заведено в PF02).
  name = compute_ao
  material = ao_material
  sets = [ frame_data, gbuffer_inputs, ao_write ]
  shader_constants = [ ao_samples = "16" ]
  command = "dispatch constant half_dispatch"
}
{
  name = blur_ao
  material = ao_blur_material
  sets = [ frame_data, ao_read, ao_blur_write ]
  command = "dispatch constant half_dispatch"
}
{
  name = shade_scene
  material = shade_material
  sets = [ frame_data, gbuffer_inputs, ao_final_read, shade_write ]
  command = "dispatch constant screen_dispatch"
}
{
  name = apply_fog
  material = fog_material
  sets = [ frame_data, gbuffer_inputs, scene_read, fog_write ]
  command = "dispatch constant screen_dispatch"
}
{
  // Способ марша — тир качества: смена стоит пересборки pipeline, поэтому specialization-константа, а не UBO.
  // По умолчанию ЛИНЕЙНЫЙ, и это результат измерения, а не упрощение: в этой сцене иерархический марш по
  // пирамиде оказался дороже линейного при той же точности (см. README, срез 10).
  name = trace_ssr
  material = ssr_material
  sets = [ frame_data, gbuffer_inputs, ssr_read, ssr_write ]
  shader_constants = [ ssr_hierarchical = "0" ]
  command = "dispatch constant screen_dispatch"
}
{
  name = resolve_taa
  material = taa_material
  sets = [ frame_data, gbuffer_inputs, reflected_read, taa_io ]
  command = "dispatch constant screen_dispatch"
}
{
  // Первый шаг понижения делает и яркий проход: specialization-константа отличает его от остальных, поэтому
  // шейдер один, а вариантов два — ровно тот случай, для которого spec-константы и нужны.
  name = bloom_down_half
  material = bloom_down_material
  sets = [ frame_data, bloom_down_0 ]
  shader_constants = [ bloom_prefilter = "1" ]
  command = "dispatch constant half_dispatch"
}
{
  name = bloom_down_quarter
  material = bloom_down_material
  sets = [ frame_data, bloom_down_1 ]
  shader_constants = [ bloom_prefilter = "0" ]
  command = "dispatch constant quarter_dispatch"
}
{
  name = bloom_down_eighth
  material = bloom_down_material
  sets = [ frame_data, bloom_down_2 ]
  shader_constants = [ bloom_prefilter = "0" ]
  command = "dispatch constant eighth_dispatch"
}
{
  name = bloom_down_sixteenth
  material = bloom_down_material
  sets = [ frame_data, bloom_down_3 ]
  shader_constants = [ bloom_prefilter = "0" ]
  command = "dispatch constant sixteenth_dispatch"
}
{
  name = bloom_up_eighth
  material = bloom_up_material
  sets = [ frame_data, bloom_up_2 ]
  command = "dispatch constant eighth_dispatch"
}
{
  name = bloom_up_quarter
  material = bloom_up_material
  sets = [ frame_data, bloom_up_1 ]
  command = "dispatch constant quarter_dispatch"
}
{
  name = bloom_up_half
  material = bloom_up_material
  sets = [ frame_data, bloom_up_0 ]
  command = "dispatch constant half_dispatch"
}
{
  name = draw_shafts
  material = shafts_material
  sets = [ frame_data, shafts_io ]
  shader_constants = [ shaft_samples = "24" ]
  command = "dispatch constant quarter_dispatch"
}
{
  name = compute_dof_coc
  material = dof_coc_material
  sets = [ frame_data, gbuffer_inputs, dof_coc_write ]
  command = "dispatch constant screen_dispatch"
}
{
  name = dof_down_half
  material = dof_down_material
  sets = [ frame_data, dof_down_0 ]
  shader_constants = [ dof_from_frame = "1" ]
  command = "dispatch constant half_dispatch"
}
{
  name = dof_down_1
  material = dof_down_material
  sets = [ frame_data, dof_down_1 ]
  shader_constants = [ dof_from_frame = "0" ]
  command = "dispatch constant quarter_dispatch"
}
{
  name = dof_down_2
  material = dof_down_material
  sets = [ frame_data, dof_down_2 ]
  shader_constants = [ dof_from_frame = "0" ]
  command = "dispatch constant eighth_dispatch"
}
{
  name = dof_down_3
  material = dof_down_material
  sets = [ frame_data, dof_down_3 ]
  shader_constants = [ dof_from_frame = "0" ]
  command = "dispatch constant sixteenth_dispatch"
}
{
  // Число проб и использование пирамиды — тиры качества, поэтому specialization-константы
  name = gather_dof
  material = dof_gather_material
  sets = [ frame_data, dof_gather_read, dof_write ]
  shader_constants = [ dof_taps = "24", dof_use_pyramid = "1" ]
  command = "dispatch constant screen_dispatch"
}
{
  name = build_histogram
  material = histogram_material
  sets = [ frame_data, histogram_build ]
  command = "dispatch constant histogram_dispatch"
}
{
  name = measure_exposure
  material = exposure_material
  sets = [ frame_data, exposure_resolve ]
  command = "dispatch constant exposure_dispatch"
}
{
  name = clear_histogram
  material = histogram_clear_material
  sets = [ frame_data, histogram_clear ]
  command = "dispatch constant exposure_dispatch"
}
{
  name = bake_grade_lut
  material = grade_lut_material
  sets = [ frame_data, lut_write ]
  command = "dispatch constant lut_dispatch"
}
{
  name = compose_frame
  material = compose_material
  sets = [ frame_data, gbuffer_inputs, compose_inputs, compose_write ]
  command = "dispatch constant screen_dispatch"
}
{
  name = present_composed
  command = "blit composed_color swapchain_image"
}

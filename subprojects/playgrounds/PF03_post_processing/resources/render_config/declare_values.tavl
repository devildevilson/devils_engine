{
  name = viewport
  type = screensize
}
{
  // SSAO считается в половинном разрешении. Размер объявлен ОТНОСИТЕЛЬНО окна, а не константой, поэтому
  // качество не зависит от разрешения — цена эффекта остаётся той же долей кадра.
  name = viewport_half
  type = screensize
  scale = [0.5, 0.5, 1.0]
}
{
  // Лучи считаются на четверти кадра отдельным ресурсом: у них своя маска и свой фильтр, к пирамиде bloom
  // они относятся только источником данных.
  name = viewport_quarter
  type = screensize
  scale = [0.25, 0.25, 1.0]
}
{
  // Число корзин гистограммы яркости. 256 — обычный выбор: при диапазоне в 14 стопов это ~0.055 стопа на
  // корзину, то есть точнее, чем человек замечает.
  name = histogram_bins
  type = fixed
  value = [256, 0, 0]
}
{
  name = one
  type = fixed
  value = [1, 0, 0]
}
{
  name = scene_instances
  type = fixed
  value = [16, 0, 0]
}
{
  name = scene_draws
  type = fixed
  value = [2, 0, 0]
}
{
  // Размер таблицы грейда. Раскладка — полоса: ширина = N*N (плитка на каждый синий срез), высота = N.
  // Ресурсы render graph пока только двумерные, поэтому 3D-таблица разложена полосой (пробел движка записан).
  // Смена размера — это ПЕРЕСОЗДАНИЕ РЕСУРСА: тот самый рычаг «размеры целей» из аудита, а не число в UBO.
  name = color_lut_size
  type = fixed_2d
  value = [1024, 32, 0]
}

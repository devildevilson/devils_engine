{
  name = viewport
  type = screensize
}
{
  // SSAO считается в половинном разрешении. Размер объявлен ОТНОСИТЕЛЬНО окна, а не константой, поэтому
  // качество не зависит от разрешения — цена эффекта остаётся той же долей кадра.
  name = viewport_half
  type = screensize
  scale = [0.5, 0.5, 1.0]
}
{
  // Уровни bloom-пирамиды объявлены относительно окна, поэтому радиус свечения в ДОЛЯХ кадра не зависит от
  // разрешения. Отдельные ресурсы на уровень, а не мипы одного: ресурсы render graph пока однослойные по мипам.
  name = viewport_quarter
  type = screensize
  scale = [0.25, 0.25, 1.0]
}
{
  name = viewport_eighth
  type = screensize
  scale = [0.125, 0.125, 1.0]
}
{
  name = viewport_sixteenth
  type = screensize
  scale = [0.0625, 0.0625, 1.0]
}
{
  name = one
  type = fixed
  value = [1, 0, 0]
}
{
  name = scene_instances
  type = fixed
  value = [16, 0, 0]
}
{
  name = scene_draws
  type = fixed
  value = [2, 0, 0]
}

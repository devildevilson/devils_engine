#ifndef PF03_FRAME_GLSL
#define PF03_FRAME_GLSL

// Единственный источник раскладки FrameBlock: и сцена, и темпоральный пасс включают этот файл, поэтому
// раскладка не может разъехаться между шейдерами (в PF02 именно дублирование записи стоило регрессии).
#define PF03_FRAME_BLOCK_BODY  \
  vec4 viewport_time;          \
  vec4 controls;

// viewport_time: xy = размер кадра в пикселях, z = время в секундах, w = номер кадра с последнего сброса
// controls:      x = вес истории (0 — без накопления), y = скорость движения, z/w = резерв

#endif

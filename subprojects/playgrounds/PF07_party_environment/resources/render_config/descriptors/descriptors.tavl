{ name = camera_data, layout = [ { resource = camera_buffer, usage = uniform, stage = all } ] }
{
  name = transmittance_write
  layout = [
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = transmittance_lut, usage = texel_write, stage = compute }
  ]
}
{
  name = sky_view_write
  layout = [
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = transmittance_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = sky_view_lut, usage = texel_write, stage = compute }
  ]
}
{
  name = sky_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = fragment },
    { resource = sky_buffer, usage = uniform, stage = fragment },
    { resource = transmittance_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = sky_view_lut, usage = sampled, stage = fragment, sampler = linear_sampler }
  ]
}
{
  name = compose_data
  layout = [
    { resource = sky_color, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = sky_buffer, usage = uniform, stage = fragment }
  ]
}
{
  name = ui_textures
  texture_count = 16
  sampler_pool = [ linear_sampler ]
  texture_stage = fragment
}

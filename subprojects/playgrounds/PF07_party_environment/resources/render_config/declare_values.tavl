{ name = viewport, type = screensize }
{ name = one, type = fixed, value = [1, 0, 0] }
// Таблица прохождения атмосферы. 256 отсчётов по расстоянию до края и 64 по высоте — классический
// размер: функция гладкая, и по обеим осям параметризация выбрана так, чтобы у горизонта отсчёты
// сгущались сами. Смена размера — это ПЕРЕСОЗДАНИЕ ресурса, а не число в UBO.
//
// Тип обязан быть fixed_2d, а не fixed: `fixed` задуман для буферов и делает образ КВАДРАТНЫМ x на x,
// молча игнорируя вторую компоненту. Таблица получалась 257x257, шейдер писал в неё по своей сетке
// 256x64, верхняя половина оставалась нулями, а выборка шла со сдвигом — небо темнело и по нему
// проходила дуга.
{ name = transmittance_lut_size, type = fixed_2d, value = [256, 64, 1] }
// Небо целиком в 192x108 отсчётов. Именно этот размер отвязывает цену неба от разрешения экрана.
{ name = sky_view_lut_size, type = fixed_2d, value = [192, 108, 1] }
{ name = ui_vertices_bytes, type = fixed, value = [524288, 0, 0] }
{ name = ui_indices_bytes, type = fixed, value = [131072, 0, 0] }
{ name = ui_commands_bytes, type = fixed, value = [16384, 0, 0] }

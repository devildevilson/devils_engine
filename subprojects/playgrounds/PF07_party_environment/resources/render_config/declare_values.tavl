{ name = viewport, type = screensize }
{ name = one, type = fixed, value = [1, 0, 0] }
// Таблица прохождения атмосферы. 256 отсчётов по расстоянию до края и 64 по высоте — классический
// размер: функция гладкая, и по обеим осям параметризация выбрана так, чтобы у горизонта отсчёты
// сгущались сами. Смена размера — это ПЕРЕСОЗДАНИЕ ресурса, а не число в UBO.
//
// Тип обязан быть fixed_2d, а не fixed: `fixed` задуман для буферов и делает образ КВАДРАТНЫМ x на x,
// молча игнорируя вторую компоненту. Таблица получалась 257x257, шейдер писал в неё по своей сетке
// 256x64, верхняя половина оставалась нулями, а выборка шла со сдвигом — небо темнело и по нему
// проходила дуга.
{ name = transmittance_lut_size, type = fixed_2d, value = [256, 64, 1] }
// Небо целиком в 192x108 отсчётов. Именно этот размер отвязывает цену неба от разрешения экрана.
{ name = sky_view_lut_size, type = fixed_2d, value = [192, 108, 1] }
// Многократное рассеяние считается изотропным, поэтому от направления взгляда не зависит и двух осей
// «высота × зенитный угол светила» достаточно. Функция очень гладкая — 32x32 хватает с запасом.
{ name = multiscatter_lut_size, type = fixed_2d, value = [32, 32, 1] }
// Воздушная перспектива: две экранные оси и ось расстояния. Настоящий куб, третья ось доезжает до
// образа, а не только до размера буфера.
{ name = aerial_lut_size, type = fixed_3d, value = [32, 32, 32] }
{ name = ui_vertices_bytes, type = fixed, value = [524288, 0, 0] }
{ name = ui_indices_bytes, type = fixed, value = [131072, 0, 0] }
{ name = ui_commands_bytes, type = fixed, value = [16384, 0, 0] }
// Бюджет опорной геометрии среза 4. Настоящий ландшафт придёт срезом 5 и попросит совсем других
// чисел, поэтому запас здесь скромный и намеренно тесный.
// Две пары в группе: кастеры-коробки и диск земли. Бюджет инстансов общий на обе, поэтому в нём
// лежит запас коробок ПЛЮС единственный инстанс земли.
{ name = scene_instances, type = fixed, value = [80, 0, 0] }
{ name = scene_draws, type = fixed, value = [80, 0, 0] }
// Атлас каскадов: три тайла по 1024 в ряд и два ряда — по одному ряду на теневой источник.
{ name = shadow_atlas_size, type = fixed_2d, value = [3072, 2048, 1] }
{ name = cascade_records, type = fixed, value = [6, 0, 0] }
{ name = shadow_region_bytes, type = fixed, value = [1024, 0, 0] }

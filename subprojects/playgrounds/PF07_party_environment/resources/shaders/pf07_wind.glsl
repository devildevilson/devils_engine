// Общее ветровое поле.
//
// Живёт отдельным файлом по одной причине, и она важнее всех прочих: качание считают ДВА шейдера —
// основной проход и построение карты теней. Разойдись они хоть на слагаемое, тень куста поедет
// относительно самого куста, и это не даст ни ошибки сборки, ни предупреждения. Тот же урок, что с
// общей моделью среды и общей моделью поверхности, только про движение.
//
// Поле ОДНО на весь мир: ветер — свойство погоды, а не отдельного растения. Индивидуальна у куста
// только фаза, и без неё все заросли качаются как один предмет.

#ifndef PF07_WIND_GLSL
#define PF07_WIND_GLSL

// wind.xy — направление в горизонтальной плоскости, wind.z — сила в метрах отклонения верхушки,
// wind.w — время в секундах.
vec3 pf07_wind_sway(const vec3 world_position, const float height_fraction, const float phase,
                    const vec4 wind) {
  if (wind.z <= 0.0) return vec3(0.0);

  // Волна БЕЖИТ по полю: сдвиг фазы вдоль направления ветра. Без него вся долина качается синхронно,
  // и вместо ветра получается пульсация.
  const float travel = dot(world_position.xz, wind.xy) * 0.055;
  const float sway = sin(wind.w * 1.9 - travel + phase);
  // Порывы — вторая, куда более медленная волна поверх первой. Ровное качание читается механическим.
  const float gust = 0.55 + 0.45 * sin(wind.w * 0.31 - travel * 0.22 + phase * 0.15);

  // Квадрат доли высоты: корень не двигается вовсе, верхушка ходит сильнее всего. Линейная зависимость
  // отрывала бы растение от земли.
  const float amount = wind.z * gust * sway * height_fraction * height_fraction;
  return vec3(wind.x * amount, -abs(amount) * 0.18, wind.y * amount);
}

#endif

{
  name = draw_scene
  material = scene_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ camera_data, cel_settings ]
  command = "draw"
}
{
  name = draw_cel_outline
  material = cel_outline_material
  geometry = fullscreen_geometry
  sets = [ camera_data, decal_scene, cel_settings ]
  command = "draw constant fullscreen_draw"
  // The outline belongs to opaque lighting. Decals, particles and text are later layers and may cover it.
  blending = { scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{
  name = draw_screen_decals
  material = screen_decal_material
  geometry = decal_volume_geometry
  draw_group = decal_draw_group
  sets = [ camera_data, decal_scene, text_textures ]
  command = "draw"
  blending = { scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{
  name = simulate_particles
  material = particle_simulation_material
  sets = [ camera_data, particle_simulation ]
  command = "dispatch constant particle_dispatch"
}
{
  name = draw_sparks
  material = particle_material
  geometry = particle_geometry
  sets = [ camera_data, particle_render ]
  command = "draw constant spark_draw"
  // Additive sparks are order-independent, so this first lifecycle proof does not smuggle in a sort problem.
  blending = { scene_color = { enable = true, color = "src_alpha add one", alpha = "zero add one" } }
}
{
  name = draw_weather
  material = particle_material
  geometry = particle_geometry
  sets = [ camera_data, particle_render ]
  command = "draw constant weather_draw"
  // Weather is deliberately non-additive. This exposes the remaining unsorted-alpha policy instead of
  // making snow glow merely to avoid it; rain's narrow streaks and sparse snow keep the artifact bounded.
  blending = { scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{
  name = draw_world_text
  material = world_msdf_material
  geometry = glyph_geometry
  draw_group = world_glyph_draw_group
  sets = [ camera_data, text_textures ]
  command = "draw"
  blending = { scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{
  name = draw_billboard_text
  material = billboard_msdf_material
  geometry = glyph_geometry
  draw_group = billboard_glyph_draw_group
  sets = [ camera_data, text_textures ]
  command = "draw"
  blending = { scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{
  name = draw_playground_overlay
  material = ui_overlay_material
  geometry = ui_geometry
  command = "draw_ui ui_vertices ui_indices ui_commands"
  sets = [ camera_data, text_textures ]
  push_constants = [ ui_push ]
  blending = { scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{ name = present_scene, command = "blit scene_color swapchain_image" }

{
  name = pf05_scene_effects
  startup = true
  passes = [
    {
      name = pf05_scene
      render_target = scene_target
      subpasses = [
        { scene_color = (undefined, clear), scene_normal = (undefined, clear), scene_depth = (undefined, clear) },
        { scene_color = (color_attachment, store), scene_normal = (color_attachment, store), scene_depth = (depth_attachment, store) },
        { scene_color = (color_attachment, store), scene_normal = (sampled, store), scene_depth = (depth_read, store) }
      ]
      steps = [ draw_scene ]
    },
    {
      // Current-frame depth/normal are already complete: collision need not lag one camera frame behind.
      name = pf05_particle_simulation
      subpasses = [
        {
          particle_emitter_buffer = (uniform, store),
          particle_state = (storage_write, store),
          scene_depth = (depth_read, store),
          scene_normal = (sampled, store)
        }
      ]
      steps = [ simulate_particles ]
    },
    {
      name = pf05_decals
      render_target = decal_target
      subpasses = [
        { scene_color = (color_attachment, store), scene_normal = (sampled, store), scene_depth = (depth_read, store) },
        { scene_color = (color_attachment, store), scene_normal = (sampled, store), scene_depth = (depth_read, store) },
        { scene_color = (color_attachment, store), scene_normal = (sampled, store), scene_depth = (depth_read, store) }
      ]
      steps = [ draw_cel_outline, draw_screen_decals ]
    },
    {
      name = pf05_text
      render_target = text_target
      subpasses = [
        { scene_color = (color_attachment, store), scene_depth = (depth_read, store), particle_state = (storage_read, store) },
        { scene_color = (color_attachment, store), scene_depth = (depth_attachment, store), particle_state = (storage_read, store) },
        { scene_color = (color_attachment, store), scene_depth = (depth_attachment, store), particle_state = (storage_read, store) }
      ]
      steps = [ draw_weather, draw_sparks, draw_world_text, draw_billboard_text, draw_world_ui ]
    },
    {
      // UI is a separate final pass so dense weather can never be reordered over diagnostics.
      name = pf05_ui
      render_target = ui_target
      subpasses = [
        { scene_color = (color_attachment, store) },
        { scene_color = (color_attachment, store) },
        { scene_color = (transfer_src, store) }
      ]
      steps = [ draw_playground_overlay ]
    },
    {
      name = pf05_present
      wait_for = [ swapchain_image ]
      subpasses = [
        { scene_color = (transfer_src, store), swapchain_image = (transfer_dst, store) },
        { scene_color = (transfer_src, store), swapchain_image = (present, store) }
      ]
      steps = [ present_scene ]
    }
  ]
  present_source = swapchain_image
}

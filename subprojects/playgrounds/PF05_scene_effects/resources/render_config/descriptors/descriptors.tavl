{
  name = camera_data
  layout = [ { resource = camera_buffer, usage = uniform, stage = all } ]
}
{
  name = cel_settings
  layout = [ { resource = cel_settings_buffer, usage = uniform, stage = fragment } ]
}
{
  name = decal_scene
  layout = [
    { resource = scene_depth, usage = depth_read, sampler = nearest_sampler, stage = fragment },
    { resource = scene_normal, usage = sampled, sampler = nearest_sampler, stage = fragment }
  ]
}
{
  // Every invocation owns one stable slot: no freelist atomics are needed for this bounded pool.
  name = particle_simulation
  layout = [
    { resource = particle_emitter_buffer, usage = uniform, stage = compute },
    { resource = particle_state, usage = storage_write, stage = compute },
    { resource = particle_state, usage = storage_read, stage = compute, history = 1 },
    { resource = scene_depth, usage = depth_read, sampler = nearest_sampler, stage = compute },
    { resource = scene_normal, usage = sampled, sampler = nearest_sampler, stage = compute }
  ]
}
{
  name = particle_render
  layout = [
    { resource = particle_state, usage = storage_read, stage = vertex },
    { resource = particle_emitter_buffer, usage = uniform, stage = vertex }
  ]
}
{
  name = world_ui_data
  layout = [ { resource = world_ui_transforms, usage = storage_read, stage = vertex } ]
}
{
  // The same asset array contains the Crimson atlas used by world text and the Visage overlay.
  name = text_textures
  texture_count = 16
  sampler_pool = [ linear_sampler ]
  texture_stage = fragment
}

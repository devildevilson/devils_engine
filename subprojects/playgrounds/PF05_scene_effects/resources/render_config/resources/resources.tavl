{ name = swapchain_image, format = swapchain4, role = present, size = viewport, swap = swapchain }
{ name = scene_color, format = sf4, role = hdr_color, size = viewport, swap = per_frame }
{ name = scene_normal, format = sf4, role = gbuffer_normal, size = viewport, swap = per_frame }
{ name = scene_depth, format = d32, role = depth, size = viewport, swap = per_frame }
{ name = camera_buffer, format = mat4mat4v4v4mat4v4, role = upload, size = one, swap = per_frame }
{
  // Project-owned runtime cel controls: lighting bands do not require a graph/pipeline rebuild.
  name = cel_settings_buffer
  format = v4v4v4
  role = upload
  size = one
  swap = per_frame
}
{
  // GPU simulation ping-pongs implicitly through per-frame history: current copy is written, history=1 read.
  name = particle_state
  format = v4v4v4
  role = material_data
  size = particle_capacity
  swap = per_frame
}
{
  name = particle_emitter_buffer
  format = v4v4v4v4v4ui4ui4v4v4
  role = upload
  size = one
  swap = per_frame
}
{ name = ui_vertices, format = c1, role = upload, size = ui_vertices_bytes, swap = per_frame }
{ name = ui_indices, format = c1, role = upload, size = ui_indices_bytes, swap = per_frame }
{ name = ui_commands, format = c1, role = upload, size = ui_commands_bytes, swap = per_frame }
{
  name = world_ui_transforms
  format = v4v4v4
  role = upload
  size = world_ui_windows
  swap = per_frame
}
{ name = world_ui_vertices, format = c1, role = upload, size = world_ui_vertices_bytes, swap = per_frame }
{ name = world_ui_indices, format = c1, role = upload, size = world_ui_indices_bytes, swap = per_frame }
{ name = world_ui_commands, format = c1, role = upload, size = world_ui_commands_bytes, swap = per_frame }

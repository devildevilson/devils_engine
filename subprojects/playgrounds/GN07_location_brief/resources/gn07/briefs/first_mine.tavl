// Обязательства конкретной шахты — то, во что верхний уровень перевёл бы графы ландшафта,
// политики и квестов. Порты здесь не пишутся: они следуют из связей узла во фрагменте мира.
// Бюджет размещения — контент по пути от обычного входа; допуск `content` — общий контент
// локации. Генератор вправе дать больше обязательного, но не больше допуска.
name = first_mine
location = mine_1
content = [30, 55]

placements = [
  { name = miners, what = npc_group, count = 2, place = camp_spot, budget = [0, 4] }
  { name = quest_n_item, what = item, place = deep_hideout, budget = [12, 18] }
]

// Квест Y: у шахтёров узнаём, где примерно лежит предмет.
lore = [
  { from = miners, to = quest_n_item, kind = knows_where }
]

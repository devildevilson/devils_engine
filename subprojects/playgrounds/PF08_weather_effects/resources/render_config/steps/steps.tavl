{
  name = build_transmittance
  material = transmittance_material
  sets = [ transmittance_write ]
  command = "dispatch constant transmittance_dispatch"
}
{
  name = build_multiscatter
  material = multiscatter_material
  sets = [ multiscatter_write ]
  command = "dispatch constant multiscatter_dispatch"
}
{
  name = build_sky_view
  material = sky_view_material
  sets = [ sky_view_write ]
  command = "dispatch constant sky_view_dispatch"
}
{
  name = build_aerial
  material = aerial_material
  sets = [ aerial_write ]
  command = "dispatch constant aerial_dispatch"
}
{
  name = draw_sky
  material = sky_material
  geometry = fullscreen_geometry
  sets = [ sky_data, shadow_sample ]
  command = "draw constant fullscreen_draw"
}
{
  name = compose_sky
  material = compose_material
  geometry = fullscreen_geometry
  sets = [ compose_data ]
  command = "draw constant fullscreen_draw"
}
{
  name = draw_overlay
  material = ui_material
  geometry = ui_geometry
  command = "draw_ui ui_vertices ui_indices ui_commands"
  sets = [ camera_data, ui_textures ]
  push_constants = [ ui_push ]
  blending = { final_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{ name = present_scene, command = "blit final_color swapchain_image" }
{
  name = measure_scene
  material = meter_material
  sets = [ meter_write ]
  command = "dispatch constant meter_dispatch"
}
{
  name = draw_scene
  material = scene_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ camera_data, shadow_sample, scene_lighting ]
  command = "draw"
}
{
  name = draw_shadow_cascades
  material = shadow_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ shadow_write ]
  push_constants = [ region_index_push ]
  command = "draw_regions cascade_buffer shadow_region_commands"
}
{
  name = build_fog_volume
  material = fog_material
  sets = [ fog_write, shadow_sample ]
  command = "dispatch constant fog_dispatch"
}
{
  name = apply_fog
  material = fog_apply_material
  geometry = fullscreen_geometry
  sets = [ fog_apply_data ]
  command = "draw constant fullscreen_draw"
}
{
  name = simulate_rain
  material = rain_simulation_material
  sets = [ rain_simulation_data ]
  command = "dispatch constant rain_dispatch"
}
{
  name = update_surface_memory
  material = surface_memory_material
  sets = [ surface_memory_update ]
  command = "dispatch constant surface_memory_dispatch"
}
{
  name = draw_rain
  material = rain_material
  geometry = rain_geometry
  sets = [ rain_render_data ]
  command = "draw constant rain_draw"
  blending = { weather_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}
{
  name = draw_mid_precipitation
  material = mid_precipitation_material
  geometry = rain_geometry
  sets = [ mid_precipitation_data ]
  command = "draw constant mid_precipitation_draw"
  blending = { weather_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" } }
}

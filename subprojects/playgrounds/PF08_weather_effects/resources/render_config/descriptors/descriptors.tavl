{ name = camera_data, layout = [ { resource = camera_buffer, usage = uniform, stage = all } ] }
{
  name = transmittance_write
  layout = [
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = transmittance_lut, usage = texel_write, stage = compute }
  ]
}
{
  name = multiscatter_write
  layout = [
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = transmittance_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = multiscatter_lut, usage = texel_write, stage = compute }
  ]
}
{
  name = sky_view_write
  layout = [
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = transmittance_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = multiscatter_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = sky_view_lut, usage = texel_write, stage = compute }
  ]
}
{
  name = aerial_write
  layout = [
    { resource = camera_buffer, usage = uniform, stage = compute },
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = transmittance_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = multiscatter_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = aerial_lut, usage = texel_write, stage = compute }
  ]
}
{
  name = sky_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = fragment },
    { resource = sky_buffer, usage = uniform, stage = fragment },
    { resource = transmittance_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = multiscatter_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = sky_view_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = aerial_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = surface_precipitation_memory, usage = storage_read, stage = fragment }
  ]
}
{
  name = compose_data
  layout = [
    { resource = weather_color, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = sky_buffer, usage = uniform, stage = fragment }
  ]
}
{
  name = ui_textures
  texture_count = 16
  sampler_pool = [ linear_sampler ]
  texture_stage = fragment
}
{
  name = meter_write
  layout = [
    { resource = weather_color, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = exposure_meter, usage = storage_write, stage = compute }
  ]
}
{
  name = scene_lighting
  layout = [
    { resource = sky_buffer, usage = uniform, stage = all },
    { resource = transmittance_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = sky_view_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = aerial_lut, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = surface_precipitation_memory, usage = storage_read, stage = fragment }
  ]
}
{
  name = surface_memory_update
  layout = [
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = surface_precipitation_memory, usage = storage_write, stage = compute },
    { resource = surface_precipitation_memory, usage = storage_read, stage = compute, history = 1 }
  ]
}
{
  // Блок неба нужен и построению теней: там же считается качание зарослей, и считаться оно обязано
  // ровно тем же кодом и теми же данными, что в основном проходе.
  name = shadow_write
  layout = [
    { resource = cascade_buffer, usage = storage_read, stage = all },
    { resource = sky_buffer, usage = uniform, stage = all }
  ]
}
{
  name = shadow_sample
  layout = [
    { resource = cascade_buffer, usage = storage_read, stage = all },
    { resource = shadow_atlas, usage = depth_read, sampler = shadow_compare, stage = all }
  ]
}
{
  name = fog_write
  layout = [
    { resource = camera_buffer, usage = uniform, stage = compute },
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = transmittance_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = sky_view_lut, usage = sampled, stage = compute, sampler = linear_sampler },
    { resource = fog_volume, usage = texel_write, stage = compute }
  ]
}
{
  name = fog_apply_data
  layout = [
    { resource = sky_color, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = scene_depth, usage = depth_read, stage = fragment, sampler = nearest_sampler },
    { resource = fog_volume, usage = sampled, stage = fragment, sampler = linear_sampler },
    { resource = camera_buffer, usage = uniform, stage = fragment },
    { resource = sky_buffer, usage = uniform, stage = fragment }
  ]
}
{
  name = rain_simulation_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = compute },
    { resource = sky_buffer, usage = uniform, stage = compute },
    { resource = rain_particle_state, usage = storage_write, stage = compute },
    { resource = rain_particle_state, usage = storage_read, stage = compute, history = 1 },
    { resource = scene_depth, usage = depth_read, stage = compute, sampler = nearest_sampler }
  ]
}
{
  name = rain_render_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = vertex },
    { resource = sky_buffer, usage = uniform, stage = vertex },
    { resource = rain_particle_state, usage = storage_read, stage = vertex },
    { resource = scene_depth, usage = depth_read, stage = fragment, sampler = nearest_sampler }
  ]
}
{
  name = mid_precipitation_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = vertex },
    { resource = sky_buffer, usage = uniform, stage = vertex },
    { resource = scene_depth, usage = depth_read, stage = fragment, sampler = nearest_sampler }
  ]
}

//--- Именованные состояния неба.
//
// Каждый пресет фиксирует время, наведение камеры И экспозицию. Последнее обязательно: сравнивать
// два состояния можно только при фиксированном EV, иначе дамп сравнивает работу адаптации, а не то,
// что менялось в сцене. Правило пришло из PF03 и здесь стало требованием к самому понятию пресета.
//
// Времена выбраны не «на глаз»: каждое найдено сканированием небесной механики и соответствует
// настоящему состоянию системы, а не удачному кадру.
//
// Время задаётся КАЛЕНДАРЁМ: абсолютный год, сутки года и час. Сырое число суток от эпохи было
// непрозрачным вдвойне — оно не говорило ни в каком году состояние, ни какой это час. Семь лет дают
// только близкий beat двойной с остаточной ошибкой; фазы лун в него вообще не входят, поэтому сворачивать
// абсолютный год по модулю семь нельзя.
//
// Значения EV сняты автоматической экспозицией КАЖДОГО пресета с его собственным наведением камеры и
// затем зафиксированы. Наведение здесь не оформление: замер идёт по яркости кадра, и тот же момент
// времени при взгляде на восходящее светило и в противоположную сторону просит разной экспозиции.

presets = [
  {
    name = "noon"
    // Оба светила высоко в разгар лета: 65.8° и 64.5°.
    year = 1
    day = 140
    hour = 12.0
    look_azimuth_deg = 168.0
    look_altitude_deg = 25.0
    ev100 = 12.47
    aurora_intensity = -1.0
    scotopic_strength = -1.0
  }
  {
    name = "double_sunset"
    // Aurin уже села на 3.8°, Ember ещё стоит на 8.3° — те самые вторые сумерки.
    year = 1
    day = 0
    hour = 17.6
    look_azimuth_deg = 253.0
    look_altitude_deg = 6.0
    ev100 = 9.28
    aurora_intensity = -1.0
    scotopic_strength = -1.0
  }
  {
    name = "double_rainbow"
    // Оба светила над западным горизонтом и разнесены примерно на 13.7°. Камера смотрит в
    // anti-solar сектор: вершина дуги Aurin лежит около 29°, Ember — около 18°.
    year = 1
    day = 0
    hour = 16.0
    look_azimuth_deg = 60.0
    look_altitude_deg = 28.0
    ev100 = 11.0
    aurora_intensity = -1.0
    scotopic_strength = -1.0
  }
  {
    name = "snow_glint"
    // Низкая Ember отражается в лежащем снегу почти навстречу камере. Aurin уже под горизонтом:
    // пресет одновременно доказывает, что художественный снег не зашит в star index 0.
    year = 1
    day = 0
    hour = 17.6
    look_azimuth_deg = 253.0
    look_altitude_deg = -8.0
    ev100 = 9.28
    aurora_intensity = -1.0
    scotopic_strength = -1.0
  }
  {
    name = "aurora"
    // Полная Selen всё ещё даёт читаемый ландшафт, но камера смотрит вдоль authored магнитного овала.
    // Showcase намеренно включает сильную emission и цветное зрение; явные CLI overrides всё равно главнее.
    year = 1
    day = 11
    hour = 0.0
    look_azimuth_deg = 150.0
    look_altitude_deg = 15.0
    ev100 = 0.99
    aurora_intensity = 4.0
    scotopic_strength = 0.0
  }
  {
    name = "night"
    // Selen почти полная (фаза 0.995) и стоит на 63.7° в самую полночь: 0.64 лк.
    year = 1
    day = 11
    hour = 0.0
    look_azimuth_deg = 175.0
    look_altitude_deg = 36.0
    ev100 = 0.99
    aurora_intensity = -1.0
    scotopic_strength = -1.0
  }
  {
    name = "eclipse"
    // Selen полностью закрывает Aurin на высоте 14°, Ember рядом на 19.7°. Вклад компаньона скачком
    // становится 100%: свет падает вдвое и целиком уходит в оранжевый, оставаясь при этом днём.
    //
    // Затмение выбрано в ПЯТОМ году не случайно: полных затмений Aurin за первые семь лет всего шесть,
    // и почти все приходятся на ночные часы, когда светило под горизонтом и смотреть не на что.
    year = 5
    day = 279
    hour = 8.82
    look_azimuth_deg = 128.0
    look_altitude_deg = 16.0
    ev100 = 10.49
    aurora_intensity = -1.0
    scotopic_strength = -1.0
  }
]

//--- Небесная система PF08: P-type двойная, планета вокруг барицентра, три луны.
//
// Система решает две задачи сразу, и их нельзя разделять при правках.
//
// ПЕРВАЯ — физическая самосогласованность. Два требования — год ровно 365.25 суток и средняя
// инсоляция ровно одна солнечная постоянная — связывают массы и светимости жёстким соотношением
// L_суммарная = M_суммарная^(2/3), а большая полуось планеты выводится из них и не является
// свободным параметром. Отношение a_планеты / a_двойной = 3.95 проходит критерий устойчивости
// Холмана-Вигерта с запасом 1.53. Компаньон выбран K-типа, а не M-карликом, потому что видимая
// вторая тень требует отношения ВИДИМЫХ освещённостей около 0.2: у M-карлика оно равно 0.013, и
// второй тени не возникает вовсе. Периоды не задаются: они выводятся третьим законом Кеплера.
// Система соответствует архетипу «золотое + оранжевое, 0.30 а.е.» из circumbinary_earth_atlas.md
// с чуть более сильным компаньоном.
//
// ВТОРАЯ — бюджет событий. Редкое эффектное явление ценнее частого, поэтому НАКЛОНЕНИЯ здесь не
// декоративны: именно они задают частоту затмений. При почти нулевом наклонении затмение случается
// на каждом соединении и превращается в шум; наклонение загоняет их в узкие сезоны у линии узлов.
// Проверять правки нужно через `--survey`, разделы «бюджет событий» и «малые и крупные эффекты».
// Цель, от которой подобраны наклонения: КРУПНОЕ явление примерно раз в 47 игровых суток, что при
// темпе «игровая минута за реальную секунду» даёт 18.9 часа реального времени, и МАЛОЕ раз в
// 21 сутки, то есть 8.2 часа. Крупным считается потеря 15% света либо угасание светила на 90%.

primary = {
  name = "Aurin"
  mass_solar = 1.05
  radius_solar = 1.04
  temperature_kelvin = 5926.0
}

companion = {
  name = "Ember"
  mass_solar = 0.79
  radius_solar = 0.76
  temperature_kelvin = 4900.0
}

// Относительная орбита компаньона вокруг главной звезды. Её плоскость является опорной,
// поэтому наклонение и узел здесь равны нулю по определению.
binary = {
  semi_major_axis = 0.31
  eccentricity = 0.05
  inclination_deg = 0.0
  ascending_node_deg = 0.0
  periapsis_argument_deg = 0.0
  mean_anomaly_epoch_deg = 0.0
}

planet = {
  radius_km = 6371.0
  mass_earth = 1.0
  // Сколько СОЛНЕЧНЫХ суток в году, целым числом. Год задан орбитой и массами и ни от чего больше не
  // зависит, поэтому целым делается он, а длина суток подгоняется под него делением. Единица игрового
  // времени — ровно эти сутки, и полдень в них приходится на 12:00 по построению.
  solar_days_per_year = 365

  // Наклон оси отсчитывается от нормали к плоскости двойной и СКЛАДЫВАЕТСЯ с наклонением орбиты
  // ниже. 15.5 + 5.0 даёт эффективную обликвность около 20.5°, то есть земные сезоны.
  // Менять эти два числа нужно вместе.
  axial_tilt_deg = 15.5
  axis_azimuth_deg = 35.0
  prime_meridian_epoch_deg = 0.0

  // Наклонение орбиты планеты к плоскости двойной — главная ручка частоты ВЗАИМНЫХ ЗАТМЕНИЙ СОЛНЦ.
  // Ноль дал бы затмение на каждом соединении, то есть каждые 26.6 суток. Пять градусов оставляют
  // затмения только у линии узлов и растягивают интервал примерно до 170 суток, собирая их в два
  // сезона в год. Это сознательное отступление от наблюдаемой выборки циркумбинарных планет, где
  // компланарность держится в пределах градуса: физика допускает наклон, а игре нужна редкость.
  orbit = {
    semi_major_axis = 1.2254
    eccentricity = 0.017
    inclination_deg = 5.0
    ascending_node_deg = 0.0
    periapsis_argument_deg = 102.0
    mean_anomaly_epoch_deg = 0.0
  }
}

observer = {
  latitude_deg = 42.0
  longitude_deg = 0.0
}

// Луны разнесены далеко не ради масштаба, а ради редкости: близкая луна физически не может давать
// редкие лунные затмения. Она и обращается слишком быстро, и видит конус тени планеты слишком
// широким, поэтому попадает в тень почти каждый оборот. Радиусы Selen и Kolo подобраны так, чтобы
// угловые размеры дисков остались 0.90° и 0.30°: яркость ночи зависит именно от них, и при переносе
// лун наружу полнолуние Selen сохранило свои 0.64 лк, то есть 2.5 земных полнолуния.
//
// Selen и Kolo намеренно почти компланарны (узлы разведены на 17°, взаимная наклонность 3.5°):
// именно малая, а не большая взаимная наклонность делает ПОКРЫТИЕ ЛУНЫ ЛУНОЙ возможным, но редким.
//
// `disc_boost` — множитель яркости РИСУЕМОГО диска, `disc_visual_scale` — множитель его размера.
// Обе величины — осознанная неправда. Физически Kolo и Iskra
// дают доли процента общего света и найти их на небе почти невозможно; для игрока же они должны быть
// различимыми телами, а не пикселем. Множитель не трогает ни освещённость сцены, ни лунные затмения,
// ни бюджет событий — только то, каким тело нарисовано. Для Iskra решающим оказался именно размер:
// её диск 0.126° занимает шесть пикселей на 1080p, и никакая яркость не делает шесть пикселей заметными.
//
// Iskra — намеренно МАЛОЕ тело: диск 0.12°, вчетверо меньше земной Луны. Она не участвует в световом
// бюджете вообще, перекрывая максимум 4% диска светила, то есть меньше процента общего света. Её
// роль — движение: наклонение 30° ведёт её по небу под заметно другим углом, чем остальные луны,
// и период 7.4 суток делает это движение быстрым. Это чистая фактура неба, а не источник событий.
moons = [
  {
    name = "Selen"
    radius_km = 2042
    albedo = 0.13
    disc_boost = 1.0
    disc_visual_scale = 1.0
    orbit = {
      semi_major_axis = 260000.0
      eccentricity = 0.03
      inclination_deg = 12.0
      ascending_node_deg = 15.0
      periapsis_argument_deg = 0.0
      mean_anomaly_epoch_deg = 200.0
    }
  }
  {
    name = "Kolo"
    radius_km = 1126
    albedo = 0.09
    disc_boost = 2.5
    disc_visual_scale = 1.6
    orbit = {
      semi_major_axis = 430000.0
      eccentricity = 0.03
      inclination_deg = 12.0
      ascending_node_deg = 32.0
      periapsis_argument_deg = 0.0
      mean_anomaly_epoch_deg = 60.0
    }
  }
  {
    name = "Iskra"
    radius_km = 168
    albedo = 0.21
    disc_boost = 3.0
    disc_visual_scale = 3.0
    orbit = {
      semi_major_axis = 160000.0
      eccentricity = 0.03
      inclination_deg = 30.0
      ascending_node_deg = 260.0
      periapsis_argument_deg = 0.0
      mean_anomaly_epoch_deg = 310.0
    }
  }
]

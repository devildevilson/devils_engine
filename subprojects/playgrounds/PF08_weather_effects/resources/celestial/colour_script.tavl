//--- Цветовой сценарий: настроение по времени суток.
//
// Это ЕДИНСТВЕННОЕ место, где картинка отходит от физики намеренно, и потому оно вынесено в данные, а
// не растворено в шейдере. Небо, освещённость и цвета светил остаются физическими; сценарий работает
// поверх готового кадра и ограничен по величине — он подчёркивает то, что уже происходит, а не
// подменяет собой атмосферу.
//
// Ключи заданы по высоте ГЛАВНОГО светила, потому что именно она задаёт время суток. Между ключами
// идёт линейная интерполяция.

keys = [
  {
    // Глубокая ночь. Насыщенность занижена не ради стиля: при такой яркости колбочки почти не
    // работают, и цвет действительно уходит. Холодный сдвиг — тот же эффект Пуркинье.
    sun_altitude_deg = -18.0
    tint = [ 0.93, 0.97, 1.09 ]
    saturation = 0.55
    contrast = 1.06
  }
  {
    // Сумерки. Сдвиг здесь почти нулевой, и это исправление: прежние значения толкали синий вверх, а
    // небо в этот момент и без того уходит в лавандовый из-за озона, который вырезает зелёный. Сценарий
    // складывался с физикой и давал тот самый «цветастый» пурпур. Он обязан подчёркивать, а не подменять.
    sun_altitude_deg = -4.0
    tint = [ 0.98, 0.99, 1.02 ]
    saturation = 0.88
    contrast = 1.04
  }
  {
    // Светило у горизонта. Тёплый сдвиг минимален — рассеяние уже сделало закат тёплым само,
    // и добавлять сверх этого значит врать дважды.
    sun_altitude_deg = 2.0
    tint = [ 1.05, 1.00, 0.95 ]
    saturation = 1.08
    contrast = 1.02
  }
  {
    sun_altitude_deg = 20.0
    tint = [ 1.01, 1.00, 0.99 ]
    saturation = 1.02
    contrast = 1.00
  }
  {
    // Полдень: сценарий выключен. Физика в этой точке и так убедительна.
    sun_altitude_deg = 60.0
    tint = [ 1.00, 1.00, 1.00 ]
    saturation = 1.00
    contrast = 1.00
  }
]

{
  name = shadow_resolution
  type = fixed
  value = [2048, 0, 0]
  presets = [ low = [1024, 0, 0], mid = [2048, 0, 0], high = [4096, 0, 0] ]
}
{
  // Атлас каскадов отделён от spot-атласа: бюджету каскадов нужно расти независимо (шесть каскадов в
  // 2048 не влезают), а платить за это удвоением spot-атласа незачем.
  // Можно объявить как `type = screensize` со scale — тогда качество перестанет зависеть от разрешения
  // окна, потому что размер тайла будет расти вместе с ним.
  name = directional_atlas_resolution
  type = fixed
  value = [2048, 0, 0]
  presets = [ low = [1024, 0, 0], mid = [2048, 0, 0], high = [4096, 0, 0] ]
}
{
  name = spot_light_count
  type = fixed
  value = [4, 0, 0]
}
{
  name = directional_cascade_count
  type = fixed
  // БЮДЖЕТ записей каскадов, а не фактическое число: раскладку задаёт рантайм (--cascade-tiles).
  value = [6, 0, 0]
}
{
  name = directional_region_commands_bytes
  type = fixed
  value = [4096, 0, 0]
}
{
  name = spot_region_commands_bytes
  type = fixed
  value = [4096, 0, 0]
}
{
  name = ui_vertices_bytes
  type = fixed
  value = [524288, 0, 0]
}
{
  name = ui_indices_bytes
  type = fixed
  value = [131072, 0, 0]
}
{
  name = ui_commands_bytes
  type = fixed
  value = [16384, 0, 0]
}

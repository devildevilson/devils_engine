{
  name = scene_data
  layout = [
    { resource = scene_buffer, usage = uniform, stage = all }
  ]
}
{
  name = directional_scene_data
  layout = [
    { resource = scene_buffer, usage = uniform, stage = all },
    { resource = directional_cascade_buffer, usage = storage_read, stage = all }
  ]
}
{
  name = spot_scene_data
  layout = [
    { resource = scene_buffer, usage = uniform, stage = all },
    { resource = spot_light_buffer, usage = storage_read, stage = all },
    { resource = directional_cascade_buffer, usage = storage_read, stage = all }
  ]
}
{
  name = shadow_inputs
  layout = [
    { resource = directional_shadow, usage = depth_read, sampler = shadow_nearest, stage = fragment },
    { resource = spot_shadow_atlas, usage = depth_read, sampler = shadow_nearest, stage = fragment }
  ]
}
{
  // Сцена читает атласы дважды: сравнивающим сэмплером (аппаратный PCF) и обычным nearest
  // (hard-режим A/B и blocker search PCSS, которым нужно СЫРОЕ значение глубины).
  name = shadow_scene_inputs
  layout = [
    { resource = directional_shadow, usage = depth_read, sampler = shadow_compare, stage = fragment },
    { resource = spot_shadow_atlas, usage = depth_read, sampler = shadow_compare, stage = fragment },
    { resource = directional_shadow, usage = depth_read, sampler = shadow_nearest, stage = fragment },
    { resource = spot_shadow_atlas, usage = depth_read, sampler = shadow_nearest, stage = fragment }
  ]
}
{
  name = scene_depth_input
  layout = [
    { resource = scene_depth, usage = depth_read, sampler = shadow_nearest, stage = compute }
  ]
}
{
  name = contact_shadow_write
  layout = [
    { resource = contact_directional, usage = texel_write, stage = compute },
    { resource = contact_spots, usage = texel_write, stage = compute }
  ]
}
{
  name = contact_shadow_read
  layout = [
    { resource = contact_directional, usage = sampled, sampler = contact_linear, stage = fragment },
    { resource = contact_spots, usage = sampled, sampler = contact_linear, stage = fragment }
  ]
}
{
  name = ui_textures
  texture_count = 16
  sampler_pool = [ ui_linear ]
  texture_stage = fragment
}

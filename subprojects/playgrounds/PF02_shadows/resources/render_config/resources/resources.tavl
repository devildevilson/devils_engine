{
  name = swapchain_image
  format = swapchain4
  role = present
  size = viewport
  swap = swapchain
}
{
  name = hdr_color
  format = sf4
  role = hdr_color
  size = viewport
  swap = per_frame
}
{
  name = scene_depth
  format = d32
  role = depth
  size = viewport
  swap = per_frame
}
{
  name = contact_directional
  // .r = маска, .g = линейная view-глубина источника: нужна для depth-aware upsample половинного
  // разрешения (обычный bilinear протекает через силуэты).
  format = sf2
  role = shadow_mask
  size = viewport_half
  swap = per_frame
}
{
  name = contact_spots
  format = rgba8
  role = shadow_mask
  size = viewport_half
  swap = per_frame
}
{
  name = directional_shadow
  format = d32
  role = shadow_map
  size = directional_atlas_resolution
  swap = per_frame
}
{
  name = spot_shadow_atlas
  format = d32
  role = shadow_map
  size = shadow_resolution
  swap = per_frame
}
{
  name = scene_buffer
  format = mat4mat4mat4v4v4v4v4v4v4v4
  role = upload
  size = one
  swap = per_frame
}
{
  name = spot_light_buffer
  format = mat4v4v4v4v4v4
  role = upload
  size = spot_light_count
  swap = per_frame
}
{
  name = directional_cascade_buffer
  format = mat4v4v4v4
  role = upload
  size = directional_cascade_count
  swap = per_frame
}
{
  name = directional_region_commands
  format = c1
  role = upload
  size = directional_region_commands_bytes
  swap = per_frame
}
{
  name = spot_region_commands
  format = c1
  role = upload
  size = spot_region_commands_bytes
  swap = per_frame
}
{
  name = ui_vertices
  format = c1
  role = upload
  size = ui_vertices_bytes
  swap = per_frame
}
{
  name = ui_indices
  format = c1
  role = upload
  size = ui_indices_bytes
  swap = per_frame
}
{
  name = ui_commands
  format = c1
  role = upload
  size = ui_commands_bytes
  swap = per_frame
}

{
  name = depth_prepass
  material = depth_prepass_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ scene_data ]
  command = "draw"
}
{
  name = build_contact_shadows
  material = contact_shadow_material
  sets = [ spot_scene_data, scene_depth_input, contact_shadow_write ]
  shader_constants = [ contact_ray_steps = "8", contact_refine_steps = "3" ]
  command = "dispatch constant contact_dispatch"
}
{
  name = draw_directional_shadow
  material = directional_shadow_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ directional_scene_data ]
  push_constants = [ region_index_push ]
  command = "draw_regions directional_cascade_buffer directional_region_commands"
}
{
  name = draw_spot_shadow_regions
  material = spot_shadow_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ spot_scene_data ]
  push_constants = [ region_index_push ]
  command = "draw_regions spot_light_buffer spot_region_commands"
}
{
  name = draw_scene
  material = shadowed_scene_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ spot_scene_data, shadow_scene_inputs, contact_shadow_read ]
  shader_constants = [ pcf_radius = "1", pcf_min_screen_pixels = "3.0", pcf_max_radius_scale = "8.0" ]
  command = "draw"
}
{
  name = draw_shadow_debug
  material = shadow_debug_material
  geometry = shadow_debug_geometry
  draw_group = shadow_debug_draw_group
  sets = [ scene_data, shadow_inputs, contact_shadow_read ]
  command = "draw"
}
{
  name = draw_playground_overlay
  material = ui_overlay_material
  geometry = ui_geometry
  command = "draw_ui ui_vertices ui_indices ui_commands"
  sets = [ scene_data, ui_textures ]
  push_constants = [ ui_push ]
  blending = {
    hdr_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = present_hdr
  command = "blit hdr_color swapchain_image"
}

// Буферы генератора места GN09.

// Вход пещеры: что известно о месте до раскладки.
{
  name = site
  format = [
    centre = v3
    // Ядро прохода: R + охранный слой. Полуоси любой формы не меньше него.
    core = v1
    // Насколько стены гарантированного ядра уходят наружу (неровность и сдвиг) — для зазоров колонн.
    relief = v1
    // Радиус полости узла (комната 0).
    main_radius = v1
    // Граница места: стены с кольцом породы не дальше от узла. Жёсткая, её держит cave_fits.
    extent = v1
    // 0 karst, 1 rift, 2 chimney
    biome = ui1
    // 0 ore_cave, 1 nest_cave, 2 thermal_cave
    recipe = ui1
    // Сколько старших соседей в `elders`.
    elders = ui1
  ]
  size = one
}

// Старшие соседи: ключи их мест (сектор, узел). Пещеры этих мест строятся раньше, и эта их обходит.
{
  name = elders
  format = [
    sector = ul2
    node = ul1
  ]
  size = elder_capacity
}

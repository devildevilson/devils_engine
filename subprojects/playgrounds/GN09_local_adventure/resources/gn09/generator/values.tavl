// Числа пещер GN09.
//
// Длины — в метрах, углы — в градусах, доли — от 0 до 1. «core» в комментариях — ядро прохода из
// входа `site` (R + охранный слой): размеры ходов и ниш считаются от него, чтобы проход всегда
// оставался внутри формы. «scale» — масштаб облика этой пещеры (style_scale_*).

{
  numbers = {
    // ------------------------------------------------------------ облик пещеры
    // Свой у каждой пещеры, чтобы планировку нельзя было угадать заранее.
    style_scale_min = 0.85
    style_scale_max = 1.25
    // Извилистость: с вероятностью половина — плавные повороты, иначе резкие.
    turn_gentle_min = 15
    turn_gentle_max = 55
    turn_sharp_min = 40
    turn_sharp_max = 100
    // N — радиосвязь с лодкой: залежи и крупное гнездо обещаны дальше 3/4 N по пути.
    radio_min = 25
    radio_max = 50
    chambers_min = 3
    chambers_extra = 3
    resources_min = 3
    resources_extra = 3
    vestibule_chance = 0.35
    second_entrance_chance = 0.35

    // ------------------------------------------------------------ устья
    // Лучи из центра узла: сколько направлений по кругу и как далеко искать стену.
    mouth_rays = 24
    mouth_search = 40
    mouth_step = 0.5
    // Попыток роста от одного устья в каждом проходе.
    attempts = 3
    // Компактный проход: отрезки и глубина короче на четверть.
    compact_size = 0.75

    // ------------------------------------------------------------ ходы
    // Отрезок хода: (min..max) * core * scale.
    segment_min = 1.8
    segment_max = 3.2
    // Узкий проход от устья в систему, метров.
    entry_passage_min = 10
    entry_passage_max = 25
    entry_narrow = 0.3
    // Ходы между нишами, метров.
    passage_min = 10
    passage_max = 22
    passage_narrow_min = 0.3
    passage_narrow_max = 0.9
    // Вариантов поворота на один отрезок, прежде чем ход признан неудачным.
    segment_variants = 6

    // ------------------------------------------------------------ ниши
    // Предзал за устьем: core + (min..max) * scale; лодка заходит в него носом.
    vestibule_min = 3
    vestibule_max = 5
    // Первая крупная ниша: core + (min..max) * scale.
    first_chamber_min = 7
    first_chamber_max = 11
    first_chamber_narrow = 0.6
    // Новая ниша на конце хода: вероятность, доля крупных и их размеры.
    chamber_chance = 0.7
    large_chamber_chance = 0.4
    large_chamber_min = 6
    large_chamber_max = 10
    small_chamber_min = 3
    small_chamber_max = 6
    // Слитые части крупной ниши: из одной части другую не видно.
    hall_part_large = 5
    hall_part_chance_large = 0.6
    hall_part_chance_small = 0.4
    // Тупик (кандидат в залежь): core + (min..max).
    dead_end_min = 0.8
    dead_end_max = 2.0
    // Ходов из первой ниши: first_exits + (0|1); из остальных: exits_min + (0..2).
    first_exits = 3
    exits_min = 2

    // ------------------------------------------------------------ петли и второй вход
    loops_max = 2
    loop_straight_min = 12
    loop_straight_max = 45
    // Петля имеет смысл, если путь в обход хотя бы во столько раз длиннее прямой.
    loop_detour = 2
    loop_skip_chance = 0.4
    second_entrance_min_depth = 8
    second_entrance_reach_min = 6
    second_entrance_reach_max = 22
    second_entrance_spacing = 18

    // ------------------------------------------------------------ цели и логово
    plug_chance = 0.5
    lair_attempts = 4
    // Боковой карман-логово: core + (min..max) * scale.
    lair_pocket_min = 1.5
    lair_pocket_max = 2.5

    // ------------------------------------------------------------ колонны (шаг dress)
    pillar_room = 5
    pillar_room_double = 7
    pillar_chance_double = 0.6
    pillar_chance_single = 0.5
    pillar_attempts = 12
    pillar_radius_min = 1.0
    pillar_radius_max = 2.0
  }
  strings = {
    // СЛОВАРЬ НАЗНАЧЕНИЙ КОМНАТ. Номер в rooms.purpose — позиция слова здесь; хост переводит его
    // обратно в имя. Хост понимает: mouth, entrance, vestibule, neck, nest, lair, pocket:*, shelter:*
    // (по ним ставятся залежи, кладки, монстры и пробки); остальные слова — для глаза и отчётов.
    purposes = "main_chamber mouth entrance vestibule bend neck chamber hall_part dead_end nest lair pocket:ore_vein pocket:crystal_shelf pocket:mineral_pool pocket:cache pocket:fault pocket:ore_pocket pocket:warm_pool pocket:crystal pocket:shaft pocket:shelter pocket:vent_mouth shelter:shelter shelter:molt shelter:feeding shelter:nursery shelter:lair shelter:refuse"
    ore_uses = "ore_vein crystal_shelf mineral_pool cache fault ore_pocket"
    thermal_uses = "warm_pool crystal shaft shelter vent_mouth cache"
    shelter_uses = "shelter molt feeding nursery lair refuse"
    // Словарь предметов пещеры (features.kind).
    feature_kinds = "metal_ore mineral_vein thermal_crystal egg_cluster monster_group ice_plug"
  }
}

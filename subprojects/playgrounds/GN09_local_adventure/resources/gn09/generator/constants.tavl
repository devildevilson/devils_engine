// Общие константы мира GN09. Мод заменяет документ целиком.
// Метры и градусы; chunk_cells и ёмкости буферов задаёт хост.
{
  numbers = {
    // Макромир.
    sector_size = 96
    region_size = 768
    world_y_min = -500
    world_y_max = 500
    surface_guard = 2
    // Корпус и согласованные радиусы. При изменении размеров обновляйте связанные числа:
    // sub_radius = sub_beam / 2; sub_axis_half = (sub_length - sub_beam) / 2;
    // sub_path_radius = sub_radius + surface_guard;
    // sub_turn_radius = sub_length / 2 + surface_guard.
    sub_length = 34
    sub_beam = 12
    sub_axis_half = 11
    sub_path_radius = 8
    sub_turn_radius = 19
    macro_scale = 1.6
    // macro_scale = sub_path_radius / 5; базовая полость = sub_turn_radius + 9.
    base_cavern_radius = 28
    cave_extent = 200
    // Области влияния нужны и локаторам чанка, и независимой проверке.
    site_reach = 220
    sub_radius = 6
    station_reach = 150
    tunnel_partner_reach = 95
    tunnel_max_slope_deg = 25
    station_cell = 0.5
    hall_reach = 520
    pillar_flare = 0.35
  }
}

// Присутствие крупного существа в окрестности зала: домен (залы, узлы, проходы, где тело помещается) и
// убежища — внешние концы входов, между которыми есть обход вне домена. Мета для ИИ и режиссуры, поле
// существо не меняет. Объявление поля `passage` — в world.tavl.
//
// В этом файле НЕТ отделителей `//---`.

name = creature
buffers = ./creature_buffers.tavl
steps = [
  { name = domain, body = ./03_creature.lua,
    reads = [ creature_home, nodes, edges, graph_meta ],
    writes = [ creature_meta, creature_halls, creature_nodes, creature_passages, creature_refuges, creature_counts, probes ] }
]

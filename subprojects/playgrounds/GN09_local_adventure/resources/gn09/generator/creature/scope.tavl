// Места, чьи пещеры может задеть проверка «тело проходит»: надмножество рёбер, которые обойдёт домен
// существа (без поля), и природные узлы в досягаемости их проб. Пещеры остальных мест окна существу не
// нужны и не строятся.
//
// В этом файле НЕТ отделителей `//---`.

name = creature_scope
buffers = ./scope_buffers.tavl
steps = [
  { name = scope, body = ./scripts/scope.lua, reads = [ nodes, edges, graph_meta ], writes = [ places, place_counts ] }
]

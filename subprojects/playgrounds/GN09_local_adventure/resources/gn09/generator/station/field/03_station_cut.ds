// Один объём выреза станции: помещение со срезами углов, дверь либо люк. Строка station_cuts.
// Оси, прямоугольник и высоты полностью заданы ресурсом станции; хост только читает итоговые буферы.
{
  ctx_save = { dx = x - origin_x, dz = z - origin_z, h = y - origin_y }
  ctx_save = { u = ctx:saved:dx * axis_u_x + ctx:saved:dz * axis_u_z,
               v = ctx:saved:dx * axis_v_x + ctx:saved:dz * axis_v_z }
  ctx_save = { edge = max(max(rect_x - ctx:saved:u, ctx:saved:u - rect_z),
                          max(rect_y - ctx:saved:v, ctx:saved:v - rect_w)) }
  ctx_save = { c0 = (chamfer_x - ((ctx:saved:u - rect_x) + (ctx:saved:v - rect_y))) / sqrt(2),
               c1 = (chamfer_y - (-(ctx:saved:u - rect_z) + (ctx:saved:v - rect_y))) / sqrt(2),
               c2 = (chamfer_z - (-(ctx:saved:u - rect_z) - (ctx:saved:v - rect_w))) / sqrt(2),
               c3 = (chamfer_w - ((ctx:saved:u - rect_x) - (ctx:saved:v - rect_w))) / sqrt(2) }
  max(max(ctx:saved:edge, max(max(ctx:saved:c0, ctx:saved:c1), max(ctx:saved:c2, ctx:saved:c3))),
      max(heights_x - ctx:saved:h, ctx:saved:h - heights_y)) - 0.75
}

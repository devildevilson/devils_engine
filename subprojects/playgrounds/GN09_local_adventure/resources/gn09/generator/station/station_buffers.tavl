// Буферы генератора станции. Клетка плана — 0.5 м; оси станции: u — в породу, v — вправо, y — вверх от
// пола.

// Станция целиком: место (поза, опора, причал), люк, якорь и коробка всего, что она строит и вырезает.
// built = 0 — места нет или программа не уместилась.
{
  name = station_meta
  format = [
    built = ui1
    // 0 wall, 1 floor, 2 ceiling
    pose = ui1
    outer_cells = i1
    origin = d3
    yaw = d1
    node_centre = d3
    berth = d3
    berth_axis = d3
    tilt = d1
    residual = d1
    reach = d1
    rock_distance = d1
    hatch = i4
    anchor_key = ul1
    anchor_centre = d3
    kind = ui1
    recipe = ui1
    preferred = i1
    hall_key = ul1
    rooms = ui1
    doors = ui1
    cut_rows = ui1
    triangles = ui1
    voxel_origin = i3
    voxel_size = i3
    voxels = ui1
    // прямоугольник ленивой маски плана в клетках: i0, k0, ширина, глубина
    mask = i4
    low = d3
    high = d3
    // строк своей породы (station_rock): 1 — воротник вокруг заглублённых помещений, 0 — без него
    rock_rows = ui1
    sub_axis_half = d1
    sub_path_radius = d1
  ]
  size = one
}

// Комнаты, двери и люк как строки выреза в осях станции. Прямоугольник и срезы углов — в метрах;
// отсутствие среза обозначено отрицательным числом, чтобы DS не проверял его в каждой точке.
{
  name = station_cuts
  format = [ origin = d3, axis_u = d3, axis_v = d3, low = d3, high = d3,
             rect = d4, heights = d2, chamfer = d4 ]
  size = station_cut_capacity
}

// СВОЯ ПОРОДА аванпоста — тонкий воротник вокруг заглублённых помещений: чуть поправляет местную
// геометрию (щели между стенами и неровной скалой), шов вправе заходить в стены (station/field/01_outpost_rock.ds,
// роль заливки). Помещения вырезаются поверх. Строк — station_meta.rock_rows. half — полуоси по u, y, v;
// local_low/local_high — коробка в локальных осях станции, метры (для хоста).
{
  name = station_rock
  format = [ centre = d3, axis_u = d3, axis_v = d3, half = d3, relief = d1, rounding = d1, local_low = d3, local_high = d3 ]
  size = one
}

// Помещение: внутренность [u0,u1)x[v0,v1) в клетках, срезы углов, назначение (номер в словаре),
// внутреннее ли, родитель по росту.
{
  name = station_rooms
  format = [ rect = i4, chamfer = ub4, purpose = ui1, inner = ui1, parent = ui1 ]
  size = station_room_capacity
}

// Проём — клетки стены между помещениями a и b.
{
  name = station_doors
  format = [ a = ui1, b = ui1, rect = i4 ]
  size = station_door_capacity
}

{
  name = station_mesh
  format = [ a = d3, b = d3, c = d3, normal = d3, shade = ub1 ]
  size = station_triangle_capacity
}

{
  name = station_voxels
  format = [ solid = ub1, shade = ub1 ]
  size = station_voxel_capacity
}

// Запретная геометрия в осях станции (u, y, v): маршруты, шары поворота, путь лодки, коридоры залов.
{ name = keep_routes, format = [ a = d3, b = d3 ], size = station_keep_capacity }
{ name = keep_turns, format = [ centre = d3 ], size = station_keep_capacity }
{ name = keep_berth, format = [ a = d3, b = d3 ], size = station_keep_capacity }
{ name = keep_tubes, format = [ a = d3, b = d3, radius = d1 ], size = station_keep_capacity }

// Ленивая маска плана (112 x 96 клеток): классы считаются при первом запросе и запоминаются здесь.
{ name = mask_band, format = [ value = ub1 ], size = station_mask_cells }
{ name = mask_held, format = [ value = ub1 ], size = station_mask_cells }
{ name = mask_margin, format = [ value = ub1 ], size = station_mask_cells }
{ name = mask_cells, format = [ value = ub1 ], size = station_mask_cells }

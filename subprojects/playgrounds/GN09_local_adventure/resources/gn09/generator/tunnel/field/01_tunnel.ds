// Вырез одного прямоугольного куска сухого туннеля. Оси и полуразмеры — строка tunnel_pieces;
// поле знакового расстояния совпадает с piece_field, запас выреза — 0.75 м.
{
  ctx_save = { dx = x - centre_x, dy = y - centre_y, dz = z - centre_z }
  ctx_save = { lx = ctx:saved:dx * x_x + ctx:saved:dy * x_y + ctx:saved:dz * x_z,
               ly = ctx:saved:dx * y_x + ctx:saved:dy * y_y + ctx:saved:dz * y_z,
               lz = ctx:saved:dx * z_x + ctx:saved:dy * z_y + ctx:saved:dz * z_z }
  ctx_save = { qx = abs(ctx:saved:lx) - half_x, qy = abs(ctx:saved:ly) - half_y, qz = abs(ctx:saved:lz) - half_z }
  ctx_save = { ox = max(ctx:saved:qx, 0), oy = max(ctx:saved:qy, 0), oz = max(ctx:saved:qz, 0) }
  sqrt(ctx:saved:ox * ctx:saved:ox + ctx:saved:oy * ctx:saved:oy + ctx:saved:oz * ctx:saved:oz) + min(max(ctx:saved:qx, max(ctx:saved:qy, ctx:saved:qz)), 0) - 0.75
}

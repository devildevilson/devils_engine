// Туннель: кандидаты в пару якоря (ключ — ключ станции якоря): якоря его канонической окрестности не
// дальше tunnel_partner_reach.
//
// В этом файле НЕТ отделителей `//---`.

name = tunnel_candidates
buffers = ./candidates_buffers.tavl
steps = [
  { name = candidates, body = ./01_candidates.lua, reads = [ nodes, graph_meta ],
    writes = [ tunnel_self, tunnel_candidates, candidate_counts ] }
]

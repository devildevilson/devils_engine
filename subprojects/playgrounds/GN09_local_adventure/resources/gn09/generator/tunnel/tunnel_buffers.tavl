// built = 0 — ни одна трасса не уложилась в породу.
{
  name = tunnel_meta
  format = [ built = ui1, key = ul1, first = ul1, second = ul1, span = d1, slope = d1, pieces = ui1, triangles = ui1,
             low = d3, high = d3, seed = ul1 ]
  size = one
}
// Коробка внутренности куска: центр, рамка (x — вдоль), полуразмеры; station — нога, входящая в стену этой
// станции (ключ якоря), иначе 0.
{
  name = tunnel_pieces
  format = [ centre = d3, x = d3, y = d3, z = d3, half = d3, station = ul1 ]
  size = tunnel_piece_capacity
}
{
  name = tunnel_mesh
  format = [ a = d3, b = d3, c = d3, normal = d3, shade = ub1 ]
  size = tunnel_triangle_capacity
}
{ name = samples, format = [ position = d3, value = d1 ], size = tunnel_sample_capacity }

// Залы региона GN09 — ТОЧКА ВХОДА генератора halls (ключ — регион x, z). Правила — в скрипте; блок
// hall_niche_fits держит обещание скрытости ниш.
//
// В этом файле НЕТ отделителей `//---`.

name = halls
buffers = ./halls_buffers.tavl
steps = [
  { name = shape, body = ./scripts/halls.lua, writes = [ halls, hall_pillars, hall_ledges, hall_niches, hall_loop, hall_outposts, hall_counts, hall_probe ] }
]

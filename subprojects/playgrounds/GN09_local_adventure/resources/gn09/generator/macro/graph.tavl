// Граф окна макрографа: базы секторов окна и маршруты, оба конца которых в окне. Узел на краю окна
// получает ранг по соседям ВНУТРИ окна — граф на краю обрезан, внутренность от окна не зависит.
//
// В этом файле НЕТ отделителей `//---`.

name = graph
buffers = ./graph_buffers.tavl
steps = [
  { name = assemble, body = ./06_graph.lua, reads = [ area_counts ], writes = [ nodes, edges, graph_meta ] }
]

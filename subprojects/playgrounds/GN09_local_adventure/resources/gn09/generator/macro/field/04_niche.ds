// Ниша: две вертикально вытянутые трубки, раструб у входа и шар разворота в колене.
{
  ctx_save = { dx = x - centre_x, dz = z - centre_z, ly = y - centre_y }
  ctx_save = { u = ctx:saved:dx * forward_x + ctx:saved:dz * forward_z,
               v = -ctx:saved:dx * forward_z + ctx:saved:dz * forward_x }
  ctx_save = { a1x = ctx:saved:u - child_mouth_x, a1y = ctx:saved:ly - child_mouth_y, a1z = ctx:saved:v - child_mouth_z,
               b1x = child_elbow_x - child_mouth_x, b1y = child_elbow_y - child_mouth_y, b1z = child_elbow_z - child_mouth_z,
               a2x = ctx:saved:u - child_elbow_x, a2y = ctx:saved:ly - child_elbow_y, a2z = ctx:saved:v - child_elbow_z,
               b2x = child_end_x - child_elbow_x, b2y = child_end_y - child_elbow_y, b2z = child_end_z - child_elbow_z }
  ctx_save = { t1 = clamp((ctx:saved:a1x * ctx:saved:b1x + ctx:saved:a1y * ctx:saved:b1y + ctx:saved:a1z * ctx:saved:b1z) / max(ctx:saved:b1x * ctx:saved:b1x + ctx:saved:b1y * ctx:saved:b1y + ctx:saved:b1z * ctx:saved:b1z, 1e-12), 0, 1),
               t2 = clamp((ctx:saved:a2x * ctx:saved:b2x + ctx:saved:a2y * ctx:saved:b2y + ctx:saved:a2z * ctx:saved:b2z) / max(ctx:saved:b2x * ctx:saved:b2x + ctx:saved:b2y * ctx:saved:b2y + ctx:saved:b2z * ctx:saved:b2z, 1e-12), 0, 1) }
  ctx_save = { p1x = ctx:saved:a1x - ctx:saved:t1 * ctx:saved:b1x,
               p1y = (ctx:saved:a1y - ctx:saved:t1 * ctx:saved:b1y) / 1.35,
               p1z = ctx:saved:a1z - ctx:saved:t1 * ctx:saved:b1z,
               p2x = ctx:saved:a2x - ctx:saved:t2 * ctx:saved:b2x,
               p2y = (ctx:saved:a2y - ctx:saved:t2 * ctx:saved:b2y) / 1.35,
               p2z = ctx:saved:a2z - ctx:saved:t2 * ctx:saved:b2z,
               flare = max(1 - ctx:saved:t1 / 0.45, 0) }
  min(min(sqrt(ctx:saved:p1x * ctx:saved:p1x + ctx:saved:p1y * ctx:saved:p1y + ctx:saved:p1z * ctx:saved:p1z) - child_radius * (1 + 0.6 * ctx:saved:flare * ctx:saved:flare),
          sqrt(ctx:saved:p2x * ctx:saved:p2x + ctx:saved:p2y * ctx:saved:p2y + ctx:saved:p2z * ctx:saved:p2z) - child_radius),
      sqrt(ctx:saved:a2x * ctx:saved:a2x + ctx:saved:a2y * ctx:saved:a2y + ctx:saved:a2z * ctx:saved:a2z) - sub_turn_radius) - 2.5 + 2.5 * (0.6 * hall_small + 0.4 * hall_grain)
}

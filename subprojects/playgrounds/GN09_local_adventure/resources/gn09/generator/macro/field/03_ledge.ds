// Твёрдый уступ внутри одного зала: минус signed distance до локальной коробки.
{
  ctx_save = { dx = x - centre_x, dz = z - centre_z, ly = y - centre_y }
  ctx_save = { u = ctx:saved:dx * forward_x + ctx:saved:dz * forward_z,
               v = -ctx:saved:dx * forward_z + ctx:saved:dz * forward_x }
  ctx_save = { qx = abs(ctx:saved:u - child_centre_x) - child_half_x,
               qy = abs(ctx:saved:ly - child_centre_y) - child_half_y,
               qz = abs(ctx:saved:v - child_centre_z) - child_half_z }
  -sqrt(max(ctx:saved:qx, 0) * max(ctx:saved:qx, 0) + max(ctx:saved:qy, 0) * max(ctx:saved:qy, 0) + max(ctx:saved:qz, 0) * max(ctx:saved:qz, 0)) - min(max(ctx:saved:qx, max(ctx:saved:qy, ctx:saved:qz)), 0) + 5 * hall_large + 1.5 * hall_small
}

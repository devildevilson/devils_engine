// Один отрезок петли патруля: минимум отрезков даёт коридор внутри зала.
{
  ctx_save = { dx = x - centre_x, dz = z - centre_z, ly = y - centre_y }
  ctx_save = { u = ctx:saved:dx * forward_x + ctx:saved:dz * forward_z,
               v = -ctx:saved:dx * forward_z + ctx:saved:dz * forward_x }
  ctx_save = { ax = ctx:saved:u - child_point_x, ay = ctx:saved:ly - child_point_y, az = ctx:saved:v - child_point_z,
               bx = child_next_x - child_point_x, by = child_next_y - child_point_y, bz = child_next_z - child_point_z }
  ctx_save = { t = clamp((ctx:saved:ax * ctx:saved:bx + ctx:saved:ay * ctx:saved:by + ctx:saved:az * ctx:saved:bz) / max(ctx:saved:bx * ctx:saved:bx + ctx:saved:by * ctx:saved:by + ctx:saved:bz * ctx:saved:bz, 1e-12), 0, 1) }
  ctx_save = { px = ctx:saved:ax - ctx:saved:t * ctx:saved:bx,
               py = ctx:saved:ay - ctx:saved:t * ctx:saved:by,
               pz = ctx:saved:az - ctx:saved:t * ctx:saved:bz }
  sqrt(ctx:saved:px * ctx:saved:px + ctx:saved:py * ctx:saved:py + ctx:saved:pz * ctx:saved:pz) - body_radius - surface_guard - 4 + 4 * hall_large
}

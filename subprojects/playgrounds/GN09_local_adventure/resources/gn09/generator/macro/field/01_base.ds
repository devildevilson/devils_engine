// Зал до деталей: эллипсоид и плоское дно. Значение — расстояние до воды со стеновым рельефом.
{
  ctx_save = { dx = x - centre_x, dz = z - centre_z, ly = y - centre_y }
  ctx_save = { u = ctx:saved:dx * forward_x + ctx:saved:dz * forward_z,
               v = -ctx:saved:dx * forward_z + ctx:saved:dz * forward_x }
  ctx_save = { a = ctx:saved:u / half_x, b = ctx:saved:ly / half_z, c = ctx:saved:v / half_y }
  ctx_save = { k0 = sqrt(ctx:saved:a * ctx:saved:a + ctx:saved:b * ctx:saved:b + ctx:saved:c * ctx:saved:c),
               k1 = sqrt((ctx:saved:a / half_x) * (ctx:saved:a / half_x) + (ctx:saved:b / half_z) * (ctx:saved:b / half_z) + (ctx:saved:c / half_y) * (ctx:saved:c / half_y)) }
  ctx_save = { shell = { value_or = { ctx:saved:k1 > 0,
               ctx:saved:k0 * (ctx:saved:k0 - 1) / max(ctx:saved:k1, 1e-12),
               -min(half_x, min(half_y, half_z)) } } }
  max(ctx:saved:shell, floor - ctx:saved:ly) + 5 * hall_large + 1.5 * hall_small
}

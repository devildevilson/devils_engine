{
  name = route_nodes
  format = [
    key = ul1
    centre = d3
    // 0 empty, 3 grotto, 4 vent
    kind = ui1
    rank = ub1
    // 1 восток, 2 юг
    direction = ub1
  ]
  size = route_node_capacity
}
{
  name = route_edges
  format = [ a = i1, b = i1, direction = ub1 ]
  size = route_edge_capacity
}
{
  name = route_counts
  format = [ nodes = ui1, edges = ui1 ]
  size = one
}

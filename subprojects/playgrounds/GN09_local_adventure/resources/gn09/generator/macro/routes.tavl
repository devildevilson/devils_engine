// Маршруты сектора макрографа: на восток (к x + 1) и на юг (к z + 1), каждый со своими
// промежуточными узлами, вертикальным профилем, местом-ориентиром и тупиком. Узлы и рёбра — по
// направлениям; концы рёбер — номера узлов маршрута, -1 (своя база) и -2 (база соседа). Окно само
// решает, какие маршруты в него попадают.
//
// В этом файле НЕТ отделителей `//---`.

name = routes
buffers = ./routes_buffers.tavl
steps = [
  { name = lay, body = ./scripts/routes.lua, reads = [ sector_counts ], writes = [ route_nodes, route_edges, route_counts ] }
]

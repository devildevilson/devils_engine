// Каноническая окрестность места — ЛОКАТОР: из сектора (x, z) — ключ окна 3x3 секторов вокруг него.
// В этом окне решения о месте не зависят от того, каким окном на мир смотрят.
//
// В этом файле НЕТ отделителей `//---`.

name = context
buffers = ./context_buffers.tavl
steps = [
  { name = locate, body = ./scripts/context.lua, writes = [ canonical ] }
]

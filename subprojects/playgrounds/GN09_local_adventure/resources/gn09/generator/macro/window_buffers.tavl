// Буферы нативного генератора window: обещания хоста о месте — константы, на которые опираются
// отсечения по коробке. Скрипт их читает, но не задаёт. Сам мир окна (граф и залы как C++-структура)
// идёт нативным потребителям объектом хоста.
{
  name = limits
  format = [
    // Ядро прохода: R + охранный слой.
    core = v1
    // Радиус полости узла (комната 0 пещеры).
    main_radius = v1
    // Граница места: стены с кольцом породы не дальше от узла.
    extent = v1
    // Радиус гарантированно проходящей сферы (ныряльщик), метры.
    clearance = d1
  ]
  size = one
}

// Строки форм окружения — общий документ shapes/shape_buffers.tavl (тот же у пещер мест).

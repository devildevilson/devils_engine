{
  name = nodes
  format = [
    key = ul1
    centre = d3
    // 0 empty, 1 outpost, 2 derelict, 3 grotto, 4 vent
    kind = ui1
    rank = ub1
  ]
  size = graph_node_capacity
}
{
  name = edges
  format = [ a = ui1, b = ui1 ]
  size = graph_edge_capacity
}
{
  name = graph_meta
  format = [ nodes = ui1, edges = ui1, entry = ui1, destination = ui1, min_x = i1, min_z = i1, max_x = i1, max_z = i1 ]
  size = one
}

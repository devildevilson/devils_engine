// База сектора макрографа: позиция на террасе рельефа слоя и вид. Сектор, чья база попала бы в ярус
// зала, базы не получает — на её месте пустой узел внутри зала, и маршруты соседей входят в зал.
//
// В этом файле НЕТ отделителей `//---`.

name = base
buffers = ./base_buffers.tavl
steps = [
  { name = place, body = ./scripts/base.lua, reads = [ sector_counts ], writes = [ base ] }
]

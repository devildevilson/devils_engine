// Сектор макрографа — ЛОКАТОР: из ключа (x, z) считает ключи, которые нужны генераторам базы и
// маршрутов: регионы залов, способных дотянуться до сектора и его маршрутов, концы маршрутов (свой
// сектор, восточный, южный) и окрестность 4x4 для зазора тупиков. Арифметика ключей живёт здесь, а не
// в хосте: у цепочки нет функций ключа.
//
// В этом файле НЕТ отделителей `//---`.

name = sector
buffers = ./sector_buffers.tavl
steps = [
  { name = locate, body = ./scripts/sector.lua, writes = [ regions, ends, around, sector_counts ] }
]

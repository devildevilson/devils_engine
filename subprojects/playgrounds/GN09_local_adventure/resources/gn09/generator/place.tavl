// Место природного узла GN09 — ТОЧКА ВХОДА. Находит свой узел в графе канонической окрестности
// (ключ экземпляра — сектор и ключ узла) и отдаёт вход пещеры и список старших соседей. Генератор
// пещеры связан с ним по тому же ключу.
//
// В этом файле НЕТ отделителей `//---`: они разложили бы его на суб-ресурсы.

name = place

buffers = ./place_buffers.tavl

steps = [
  {
    name = find
    body = ./scripts/S00_place.lua
    reads = [ nodes, graph_meta, limits ]
    writes = [ site, elders ]
  }
]

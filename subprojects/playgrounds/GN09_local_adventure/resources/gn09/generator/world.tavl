// Цепочка генераторов GN09 — что из чего строится. Хост просит экземпляр по имени генератора и
// ключу; связи ниже говорят, какие экземпляры других генераторов нужны раньше, и кэш цепочки
// строит каждый из них один раз. Правила живут в скриптах генераторов; нативные тела — залы (пока) и
// сборка C++-структуры мира для нативных потребителей.
//
// МАКРОГРАФ (macro/):
//   halls    залы региона (ключ — регион 8x8 секторов): эллипсоид, стопки, колонны, уступы, ниши, петля.
//   sector   локатор, ключ (x, z): регионы залов, концы маршрутов, окрестность 4x4.
//   base     база сектора: позиция на террасе слоя, вид; в ярусе зала — пустой узел в зале.
//   routes   маршруты сектора на восток и юг: изгибы, вертикальный профиль, ориентир, тупик.
//   area     локатор окна, ключ (min_x, min_z, ширина | высота << 32): сектора и регионы окна.
//   graph    граф окна: базы и маршруты внутри окна, ранги по соседям в окне.
//   window   ключ окна: обещания хоста о месте и ОКРУЖЕНИЕ для лодки — формы природного поля (галереи
//            рёбер, шары поворота) буферами. C++-мир окна для нативных потребителей — представление
//            буферов графа и залов (world_view).
//   context  локатор, ключ (x, z): ключ канонического окна 3x3 вокруг сектора.
//
// МЕСТА:
//   place    место узла, ключ (сектор x, сектор z, ключ узла): вход пещеры и СТАРШИЕ соседи.
//   cave     пещера места: место связью same, канонический мир через context, старшие пещеры —
//            fan-in на себя. Рекурсия сходится, потому что старшинство идёт только к меньшему ключу.
//
// ЧАНК (chunk/), ключ (x, y, z) — номера чанка по 16 м:
//   chunk             локатор: ключ окна 5x5 секторов вокруг сектора чанка.
//   chunk_places      места окна, чьи пещеры дотягиваются до чанка.
//   chunk_anchors     якоря станций в досягаемости чанка (их станции — fan-in поля).
//   chunk_tunnels     туннели этих якорей без повторов.
//   chunk_field       поле `solid`, сэмплы на решётке узлов чанка с полосой, поверхность и постройки.
//
// СТАНЦИЯ (station/), ключ (сектор якоря x, z, ключ якоря): база графа или аванпост зала, решённая в
// канонической окрестности якоря; место, маска, план, воксели и сетка.
//
// ТУННЕЛЬ (tunnel/), ключ — станция якоря: tunnel_candidates (якоря в досягаемости пары), tunnel_partner
// (ближайший с построенной станцией), tunnel_link (взаимность, первый якорь, окрестность середины),
// tunnel_scope и tunnel — ключ станции ПЕРВОГО якоря: станции у середины и сама трасса.
//
// window_places — природные места окна (ключ окна): fan-in пещер для полей существа и станции.
//
// СУЩЕСТВО (creature/), ключ (регион x, регион z, ключ зала):
//   creature_home     локатор: окно графа вокруг области влияния зала с запасом в два сектора.
//   creature_scope    места, чьи пещеры может задеть проверка прохода (надмножество без поля).
//   creature          домен существа и убежища; «тело проходит» — по полю `passage`.
//
// `trim` — выходы уходят в кэш обрезанными до занятого числа: ёмкость объявлена на худшее окно, а
// кэш держит сотни экземпляров.
//
// В этом файле НЕТ отделителей `//---`: они разложили бы его на суб-ресурсы.

name = gn09

// Общие модули: правила, нужные нескольким генераторам, в одной копии (`modules.world` в теле шага).
modules = [ { name = world, path = ./modules/world.lua } ]

generators = [
  { name = halls, entry = ./macro/halls.tavl, key = 2, outputs = [ halls, hall_pillars, hall_ledges, hall_niches, hall_loop, hall_outposts, hall_counts ],
    capacity = 256,
    trim = { halls = hall_counts.halls, hall_pillars = hall_counts.pillars, hall_ledges = hall_counts.ledges,
             hall_niches = hall_counts.niches, hall_loop = hall_counts.loop, hall_outposts = hall_counts.outposts } },
  { name = sector, entry = ./macro/sector.tavl, key = 2, outputs = [ regions, ends, around, sector_counts ], capacity = 8192,
    trim = { regions = sector_counts.regions } },
  {
    name = base
    entry = ./macro/base.tavl
    key = 2
    outputs = [ base ]
    capacity = 8192
    links = [
      { name = sector, from = sector, key = same },
      { name = halls, from = halls, keys = [ regions.key ], count = sector_counts.regions }
    ]
  },
  {
    name = routes
    entry = ./macro/routes.tavl
    key = 2
    outputs = [ route_nodes, route_edges, route_counts ]
    trim = { route_nodes = route_counts.nodes, route_edges = route_counts.edges }
    capacity = 8192
    links = [
      { name = sector, from = sector, key = same },
      { name = halls, from = halls, keys = [ regions.key ], count = sector_counts.regions },
      { name = ends, from = base, keys = [ ends.key ], count = sector_counts.ends },
      { name = around, from = base, keys = [ around.key ], count = sector_counts.around }
    ]
  },
  { name = area, entry = ./macro/area.tavl, key = 3, outputs = [ cells, area_regions, area_counts ], capacity = 1024,
    trim = { cells = area_counts.cells, area_regions = area_counts.regions } },
  {
    name = graph
    entry = ./macro/graph.tavl
    key = 3
    outputs = [ nodes, edges, graph_meta ]
    trim = { nodes = graph_meta.nodes, edges = graph_meta.edges }
    capacity = 1024
    links = [
      { name = area, from = area, key = same },
      { name = bases, from = base, keys = [ cells.key ], count = area_counts.cells },
      { name = routes, from = routes, keys = [ cells.key ], count = area_counts.cells }
    ]
  },
  {
    name = window
    entry = ./macro/window.tavl
    key = 3
    outputs = [ limits, galleries, turns, environment_counts ]
    trim = { galleries = environment_counts.galleries, turns = environment_counts.turns }
    capacity = 1024
    links = [
      { name = area, from = area, key = same },
      { name = graph, from = graph, key = same },
      { name = halls, from = halls, keys = [ area_regions.key ], count = area_counts.regions }
    ]
  },
  { name = context, entry = ./macro/context.tavl, key = 2, outputs = [ canonical ], capacity = 8192 },
  {
    name = place
    entry = ./place.tavl
    key = 3
    outputs = [ site, elders ]
    trim = { elders = site.elders }
    capacity = 2048
    links = [
      { name = context, from = context, project = [ 0, 1 ] },
      { name = graph, from = graph, keys = [ canonical.corner, canonical.size ] },
      { name = window, from = window, keys = [ canonical.corner, canonical.size ] }
    ]
  },
  {
    name = cave
    entry = ./cave.tavl
    key = 3
    outputs = [ rooms, links, pillars, state, features ]
    trim = { rooms = state.rooms, links = state.links, pillars = state.pillars, features = state.features }
    capacity = 1024
    links = [
      { name = context, from = context, project = [ 0, 1 ] },
      { name = window, from = window, keys = [ canonical.corner, canonical.size ] },
      { name = place, from = place, key = same },
      { name = older, from = cave, keys = [ elders.sector, elders.node ], count = site.elders }
    ]
    // Природное поле канонической окрестности без пещер мест и построек: по нему место выбирает
    // свою пещеру. Шаги спрашивают его field_march, блоки пещеры — сэмплером того же поля.
    fields = [ { name = natural, terms = [ { kind = gallery, link = window }, { kind = turn, link = window }, { kind = hall, link = window } ] } ]
  },
  { name = chunk, entry = ./chunk/chunk.tavl, key = 3, outputs = [ home ], capacity = 4096 },
  {
    name = chunk_places
    entry = ./chunk/places.tavl
    key = 3
    outputs = [ places, chunk_counts ]
    trim = { places = chunk_counts.places }
    capacity = 4096
    links = [
      { name = chunk, from = chunk, key = same },
      { name = graph, from = graph, keys = [ home.area ] }
    ]
  },
  {
    name = chunk_anchors
    entry = ./chunk/anchors.tavl
    key = 3
    outputs = [ anchors, anchor_counts ]
    trim = { anchors = anchor_counts.anchors }
    capacity = 4096
    links = [
      { name = chunk, from = chunk, key = same },
      { name = area, from = area, keys = [ home.area ] },
      { name = graph, from = graph, keys = [ home.area ] },
      { name = regions, from = halls, keys = [ area_regions.key ], count = area_counts.regions }
    ]
  },
  {
    name = chunk_tunnels
    entry = ./chunk/tunnels.tavl
    key = 3
    outputs = [ chunk_tunnels, tunnel_counts ]
    trim = { chunk_tunnels = tunnel_counts.tunnels }
    capacity = 4096
    links = [
      { name = anchors, from = chunk_anchors, key = same },
      { name = links, from = tunnel_link, keys = [ anchors.station ], count = anchor_counts.anchors }
    ]
  },
  {
    name = chunk_field
    entry = ./chunk/field.tavl
    key = 3
    outputs = [ samples, surface, structure_surface, props, surface_counts ]
    trim = { surface = surface_counts.vertices, structure_surface = surface_counts.structure, props = surface_counts.props }
    capacity = 1024
    links = [
      { name = chunk, from = chunk, key = same },
      { name = window, from = window, keys = [ home.area ] },
      { name = places, from = chunk_places, key = same },
      { name = caves, from = cave, keys = [ places.sector, places.node ], count = chunk_counts.places },
      { name = anchors, from = chunk_anchors, key = same },
      { name = stations, from = station, keys = [ anchors.station ], count = anchor_counts.anchors },
      { name = tunnel_list, from = chunk_tunnels, key = same },
      { name = tunnels, from = tunnel, keys = [ chunk_tunnels.tunnel ], count = tunnel_counts.tunnels }
    ]
    // Порядок членов — порядок слагаемых минимума у prepare_field: от него зависит только метка при
    // равных значениях.
    fields = [ { name = solid, terms = [ { kind = gallery, link = window }, { kind = turn, link = window },
                                         { kind = site, link = caves }, { kind = hall, link = window },
                                         { kind = station, link = stations }, { kind = tunnel, link = tunnels } ] } ]
  },
  {
    name = creature_home
    entry = ./creature/home.tavl
    key = 3
    outputs = [ creature_home ]
    capacity = 512
    links = [ { name = halls, from = halls, project = [ 0, 1 ] } ]
  },
  {
    name = window_places
    entry = ./places_window/places.tavl
    key = 3
    outputs = [ places, place_counts ]
    trim = { places = place_counts.places }
    capacity = 1024
    links = [ { name = graph, from = graph, key = same } ]
  },
  {
    name = creature_scope
    entry = ./creature/scope.tavl
    key = 3
    outputs = [ places, place_counts ]
    trim = { places = place_counts.places }
    capacity = 512
    links = [
      { name = home, from = creature_home, key = same },
      { name = area, from = area, keys = [ creature_home.area ] },
      { name = graph, from = graph, keys = [ creature_home.area ] },
      { name = regions, from = halls, keys = [ area_regions.key ], count = area_counts.regions }
    ]
  },
  {
    name = creature
    entry = ./creature/creature.tavl
    key = 3
    outputs = [ creature_meta, creature_halls, creature_nodes, creature_passages, creature_refuges, creature_counts ]
    trim = { creature_halls = creature_counts.halls, creature_nodes = creature_counts.nodes,
             creature_passages = creature_counts.passages, creature_refuges = creature_counts.refuges }
    capacity = 512
    links = [
      { name = home, from = creature_home, key = same },
      { name = area, from = area, keys = [ creature_home.area ] },
      { name = graph, from = graph, keys = [ creature_home.area ] },
      { name = window, from = window, keys = [ creature_home.area ] },
      { name = regions, from = halls, keys = [ area_regions.key ], count = area_counts.regions },
      { name = places, from = creature_scope, key = same },
      { name = caves, from = cave, keys = [ places.sector, places.node ], count = place_counts.places }
    ]
    // Поле прохода: природная пещера окна вместе с пещерами мест, без построек — они только добавили бы
    // воды, так что ответ «тело проходит» честен.
    fields = [ { name = passage, terms = [ { kind = gallery, link = window }, { kind = turn, link = window },
                                           { kind = site, link = caves }, { kind = hall, link = window } ] } ]
  },
  {
    name = station
    entry = ./station/station.tavl
    key = 3
    outputs = [ station_meta, station_rooms, station_doors, station_mesh, station_voxels, mask_cells ]
    trim = { station_rooms = station_meta.rooms, station_doors = station_meta.doors,
             station_mesh = station_meta.triangles, station_voxels = station_meta.voxels }
    capacity = 256
    links = [
      { name = context, from = context, project = [ 0, 1 ] },
      { name = area, from = area, keys = [ canonical.corner, canonical.size ] },
      { name = graph, from = graph, keys = [ canonical.corner, canonical.size ] },
      { name = window, from = window, keys = [ canonical.corner, canonical.size ] },
      { name = regions, from = halls, keys = [ area_regions.key ], count = area_counts.regions },
      { name = places, from = window_places, keys = [ canonical.corner, canonical.size ] },
      { name = caves, from = cave, keys = [ places.sector, places.node ], count = place_counts.places }
    ]
    // Поле пещеры до монтажа канонической окрестности, с пещерами мест: по нему ищется место и растёт план.
    fields = [ { name = natural_sites, terms = [ { kind = gallery, link = window }, { kind = turn, link = window },
                                                 { kind = site, link = caves }, { kind = hall, link = window } ] } ]
  },
  {
    name = tunnel_candidates
    entry = ./tunnel/candidates.tavl
    key = 3
    outputs = [ tunnel_self, tunnel_candidates, candidate_counts ]
    trim = { tunnel_candidates = candidate_counts.candidates }
    capacity = 512
    links = [
      { name = context, from = context, project = [ 0, 1 ] },
      { name = area, from = area, keys = [ canonical.corner, canonical.size ] },
      { name = graph, from = graph, keys = [ canonical.corner, canonical.size ] },
      { name = regions, from = halls, keys = [ area_regions.key ], count = area_counts.regions }
    ]
  },
  {
    name = tunnel_partner
    entry = ./tunnel/partner.tavl
    key = 3
    outputs = [ tunnel_partner ]
    capacity = 512
    links = [
      { name = candidates, from = tunnel_candidates, key = same },
      { name = own, from = station, key = tunnel_self.station },
      { name = others, from = station, keys = [ tunnel_candidates.station ], count = candidate_counts.candidates }
    ]
  },
  {
    name = tunnel_link
    entry = ./tunnel/link.tavl
    key = 3
    outputs = [ tunnel_link, tunnel_pair ]
    trim = { tunnel_pair = tunnel_link.pairs }
    capacity = 512
    links = [
      { name = candidates, from = tunnel_candidates, key = same },
      { name = partner, from = tunnel_partner, key = same },
      { name = back, from = tunnel_partner, keys = [ tunnel_partner.station ], count = tunnel_partner.found }
    ]
  },
  {
    name = tunnel_scope
    entry = ./tunnel/scope.tavl
    key = 3
    outputs = [ tunnel_around, around_counts ]
    trim = { tunnel_around = around_counts.stations }
    capacity = 256
    links = [
      { name = link, from = tunnel_link, key = same },
      { name = area, from = area, keys = [ tunnel_link.corner, tunnel_link.size ] },
      { name = graph, from = graph, keys = [ tunnel_link.corner, tunnel_link.size ] },
      { name = regions, from = halls, keys = [ area_regions.key ], count = area_counts.regions }
    ]
  },
  {
    name = tunnel
    entry = ./tunnel/tunnel.tavl
    key = 3
    outputs = [ tunnel_meta, tunnel_pieces, tunnel_mesh ]
    trim = { tunnel_pieces = tunnel_meta.pieces, tunnel_mesh = tunnel_meta.triangles }
    capacity = 256
    links = [
      { name = link, from = tunnel_link, key = same },
      { name = scope, from = tunnel_scope, key = same },
      { name = pair, from = station, keys = [ tunnel_pair.station ], count = tunnel_link.pairs },
      { name = around, from = station, keys = [ tunnel_around.station ], count = around_counts.stations },
      { name = window, from = window, keys = [ tunnel_link.corner, tunnel_link.size ] },
      { name = places, from = window_places, keys = [ tunnel_link.corner, tunnel_link.size ] },
      { name = caves, from = cave, keys = [ places.sector, places.node ], count = place_counts.places }
    ]
    // Природная порода окрестности середины пары (с пещерами мест) и вырезы станций рядом.
    fields = [ { name = natural_sites, terms = [ { kind = gallery, link = window }, { kind = turn, link = window },
                                                 { kind = site, link = caves }, { kind = hall, link = window } ] },
               { name = carves, terms = [ { kind = station, link = around } ] } ]
  },
  {
    name = base_site
    entry = ./base/base_site.tavl
    key = 3
    outputs = [ base_rooms, base_counts ]
    trim = { base_rooms = base_counts.rooms }
    capacity = 2048
    links = [
      { name = context, from = context, project = [ 0, 1 ] },
      { name = graph, from = graph, keys = [ canonical.corner, canonical.size ] }
    ]
  }
]

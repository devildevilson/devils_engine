// Чанк GN09 — ЛОКАТОР: из ключа чанка (x, y, z) — ключ окна макрографа вокруг его сектора. Окно на два
// сектора шире сектора чанка во все стороны: столько же запаса берёт окно просмотрщика, и в нём
// дотягивается всё, что может коснуться чанка (галерея — 80 м, пещера места — 100 м, сектор — 96 м).
//
// В этом файле НЕТ отделителей `//---`.

name = chunk
buffers = ./chunk_buffers.tavl
steps = [
  { name = locate, body = ./01_chunk.lua, writes = [ home ] }
]

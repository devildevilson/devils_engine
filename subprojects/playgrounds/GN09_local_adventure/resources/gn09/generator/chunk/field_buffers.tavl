// Решётка узлов чанка с полосой и значения поля в них. `d`: значение поля сравнивается с C++ побитово.
// Если над решёткой нет ни одной формы, а фон выше нуля, чанк — сплошная порода: сэмплы не считаются
// (surface_counts.sampled = 0) и поверхности нет.
{
  name = lattice
  format = [ position = d3 ]
  extent = [ chunk_padded, chunk_padded, chunk_padded ]
}

{
  name = samples
  format = [ value = d1 ]
  extent = [ chunk_padded, chunk_padded, chunk_padded ]
}

// Поверхность чанка: мировые позиции, нормаль, номер середины клетки и порода клетки.
{
  name = surface
  format = [ position = d3, normal = d3, cell = ui1, shade = ui1 ]
  size = surface_capacity
}

{
  name = middles
  format = [ centre = d3, value = d1, tag = ui1 ]
  size = middle_capacity
}

// Треугольники станций и туннелей, обрезанные по чанку (мировые позиции, нормаль грани, материал).
{
  name = structure_surface
  format = [ position = d3, normal = d3, shade = ui1 ]
  size = structure_vertex_capacity
}

{
  name = surface_counts
  format = [ vertices = ui1, middles = ui1, structure = ui1, props = ui1, sampled = ui1, shapes = ui1 ]
  size = one
}

// Предметы пещер мест в чанке: мировой центр, вид (словарь feature_kinds), ключ узла места и номер
// предмета в его пещере (имя предмета стабильно от них).
{
  name = props
  format = [ position = d3, kind = ui1, node = ul1, index = ui1 ]
  size = prop_capacity
}

{
  name = chunk_meta
  // seed — зерно мира для блока построек; lower — нижняя граница фона поля (field_bound).
  format = [ seed = ul1, lower = d1 ]
  size = one
}

// Буферы генератора пещеры GN09.
//
// Скелет пещеры — комнаты (узлы) и связи (рёбра). Комната 0 — полость узла маршрута, где стоит лодка:
// её кладёт шаг раскладки по входу `site`, и через неё пути не считаются (passable = 0).
//
// Ёмкости — верхние границы: занятое число лежит в `state`. Хост проверяет, что шаги не вышли за
// них, а инструменты получают занятое число параметром.

// Вход `site` объявлен у генератора места (place_buffers.tavl) и приходит связью цепочки.

{
  name = rooms
  format = [
    centre = v3
    radius = v1
    squash = v1
    stretch = v1
    yaw = v1
    // Номер в словаре `purposes` из values.tavl.
    purpose = ui1
    // 1 вход (устье или второй вход), 2 будущая ледяная пробка.
    flags = ui1
    distance = v1
    source = ub1
    passable = ub1
  ]
  size = room_capacity
}

{
  name = links
  format = [
    a = ui1
    b = ui1
    // Сечение галереи: полуширина, свод, пол, раздутие и где оно. width = 0 — только ядро.
    width = v1
    roof = v1
    floor = v1
    bulge = v1
    bulge_at = v1
  ]
  size = link_capacity
}

{
  name = pillars
  format = [
    base = v3
    radius = v1
    height = v1
  ]
  size = pillar_capacity
}

// Лучи для field_march по природному полю: откуда, куда, где нашлось.
{
  name = probes
  format = [
    origin = v3
    direction = v3
    hit = v1
  ]
  size = probe_capacity
}

{
  name = state
  format = [
    verdict = ui1
    built = ui1
    rooms = ui1
    links = ui1
    pillars = ui1
    mouth = ui1
    nest = ui1
    lair = ui1
    lair_kind = ui1
    radio = v1
    gap = v1
    // Масштаб облика пещеры: раскладка выбирает, одевание соизмеряет с ним колонны.
    scale = v1
    tries = ui1
    // сколько предметов в `features`
    features = ui1
  ]
  size = one
}

// Чья это раскладка: ключ экземпляра пещеры и зерно мира. Блоки cave_fits и cave_hidden по ним находят
// через цепочку окно, старших соседей и узел места — контекста хоста вокруг шагов нет.
{
  name = layout_meta
  format = [ key = ul3, seed = ul1 ]
  size = one
}

// Предметы пещеры: залежи в карманах, кладки в гнезде, монстры в логове, ледяные пробки в горловинах.
// kind — номер в словаре `feature_kinds`, room — камера, centre — у её дна.
{
  name = features
  format = [ room = ui1, kind = ui1, amount = ui1, centre = d3 ]
  size = feature_capacity
}

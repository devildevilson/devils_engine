// Генератор пещеры природного места GN09 — ТОЧКА ВХОДА.
//
// Генератор стоит в цепочке `generator/world`: вход `site` приходит связью от генератора места (того
// же ключа), выходы `rooms`, `links`, `pillars`, `state` кэширует цепочка. Хост знает об этом
// генераторе только то, какие буферы он читает после сборки. Всё
// остальное — как пещера растёт, сколько в ней ниш, где сидит монстр, какие у ходов сечения —
// решают шаги ниже и числа в values.tavl. Мод, который хочет других пещер, кладёт свои файлы с теми
// же id (или свою точку входа с этим id) и не трогает C++.
//
// Блоки, которые зовут шаги, — инструменты:
// Блоки находят окно, старших соседей и узел места через цепочку по ключу пещеры (`layout_meta`):
// исполнителя хоста вокруг шагов нет, `site` хоста — представление выходов экземпляра.
//   cave_fits          новая часть скелета в породе с кольцом, не дальше границы места, не сходится
//                      со своей прежней частью и с пещерами соседних мест (жёсткие обещания хоста);
//   cave_hidden        из точек, где бывает лодка, цель не видна;
//   field_march        где вдоль луча впервые порода (или вода) природного поля — общий запрос к полю из
//                      примитивов `natural`, объявленному у генератора в цепочке (libs/originator);
//   skeleton_distance  кратчайший путь по скелету от источников (libs/originator);
//   skeleton_tour      длина обхода остановок по скелету (libs/originator).
//
// Шаг 1 раскладывает скелет: ходы, ниши, цели, логово. Шаг 2 одевает его: колонны в крупных нишах.
// Колонны не влияют на проверки раскладки, поэтому их можно менять, не трогая первого шага.
//
// В этом файле НЕТ отделителей `//---`: они разложили бы его на суб-ресурсы.

name = cave

values  = ./values.tavl
buffers = ./buffers.tavl

steps = [
  {
    name = layout
    body = ./scripts/S01_layout.lua
    reads = [ site ]
    writes = [ rooms, links, probes, state, layout_meta ]
  }
  {
    name = dress
    body = ./scripts/S02_dress.lua
    reads = [ site, links ]
    writes = [ rooms, pillars, state ]
  }
  {
    name = features
    body = ./scripts/S03_features.lua
    reads = [ site, rooms ]
    writes = [ features, state ]
  }
]

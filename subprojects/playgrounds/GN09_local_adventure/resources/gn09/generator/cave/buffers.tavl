// Буферы генератора пещеры GN09.
//
// Форма пещеры — строки общего документа shapes/shape_buffers.tavl (галереи, выступы, ниши-шары): тот же
// генератор галерей, что у маршрута лодки, в меньшем масштабе. Здесь — скелет для хоста и игры: комнаты
// (узлы) и связи (рёбра), сводка и предметы. Комната 0 — полость узла маршрута, где стоит лодка: через неё
// пути внутри пещеры не считаются.
//
// Ёмкости — верхние границы: занятое число лежит в `state`.
//
// В этом файле НЕТ отделителей `//---`.

{
  name = rooms
  format = [
    centre = v3
    radius = v1
    squash = v1
    stretch = v1
    yaw = v1
    // Номер в словаре `purposes` из values.tavl.
    purpose = ui1
    // 1 вход (устье), 2 будущая ледяная пробка.
    flags = ui1
  ]
  size = room_capacity
}

{
  name = links
  format = [
    a = ui1
    b = ui1
    // Полуширина и свод сечения галереи хода (для глаза и отчётов; форма — в `galleries`).
    width = v1
    roof = v1
  ]
  size = link_capacity
}

{
  name = state
  format = [
    built = ui1
    rooms = ui1
    links = ui1
    mouth = ui1
    nest = ui1
    lair = ui1
    // 0 логово в нише, 2 в пустом тупике
    lair_kind = ui1
    // N — радиосвязь с лодкой (для отчёта о том, что за ней)
    radio = v1
    // масштаб ходов этой пещеры
    scale = v1
    // сколько направлений устья перебрано
    tries = ui1
    features = ui1
    // Бюджет времени заплыва: залежей K, сбор одной N секунд, весь заплыв T секунд; оценка по скелету —
    // обход залежей и обратно со скоростью ныряльщика плюс K * N.
    deposits = ui1
    collect = v1
    budget = v1
    tour = v1
    estimate = v1
    // Горло: узкий отрезок оси (дальше воды окна и до ниши за ним) и его ядро. Лодка в него не входит,
    // если ядро меньше радиуса корпуса — blocks_sub.
    throat_a = d3
    throat_b = d3
    throat_core = d1
    blocks_sub = ui1
    // Колонны в крупных нишах (строки `pillars`).
    pillars = ui1
  ]
  size = one
}

// Предметы пещеры: залежи в карманах, кладки в гнезде, монстры в логове, ледяные пробки в горловинах.
// kind — номер в словаре `feature_kinds`, room — комната, centre — у её дна.
{
  name = features
  format = [ room = ui1, kind = ui1, amount = ui1, centre = d3 ]
  size = feature_capacity
}

// Колонны в крупных нишах: вертикальная порода внутри выреза (вид cave_pillar, роль вставки). Центр — на
// высоте ниши, span — её радиус (колонна расширяется к полу и своду), half — полувысота колонны (уходит в
// породу за стенки ниши).
{
  name = pillars
  format = [ centre = d3, radius = d1, span = d1, half = d1, rock = ui1 ]
  size = pillar_capacity
}

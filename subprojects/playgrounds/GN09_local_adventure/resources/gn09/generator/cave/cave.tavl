// Генератор пещеры природного места GN09 — ТОЧКА ВХОДА.
//
// Пещера для ныряльщиков — тот же генератор галерей, что маршрут лодки (modules.world.gallery), в меньшем
// масштабе: узкое горло из полости узла, за ним дерево ходов с нишами. Скелет строится ЗАРАНЕЕ, без
// запросов к полю: чужая вода (галереи, выступы, карманы и шары окна у этого узла) пересчитывается теми же
// правилами из графа и обходится по аналитическим оценкам. Пещера вправе прорезать что угодно (станцию,
// соседнюю пещеру, зал) — лодка остаётся снаружи, вскрытие считает --verify.
//
// Жёсткие обещания: лодка проходит маршрут по большой пещере (пещера только вынимает породу), и лодка не
// проходит в малую: ядро горла меньше радиуса корпуса, стенка горла не дальше ядра. Остальное — прикидки:
// число залежей K, сбор одной N, заплыв T; длина ходов подбирается так, чтобы обход залежей и обратно со
// скоростью ныряльщика уложился в T - K N. Гнездо — в самой глубокой нише, логово — по пути.
//
// Шаги: skeleton раскладывает горло, ходы и ниши и пишет их строками форм; features кладёт предметы.
// Мод, который хочет других пещер, кладёт свои файлы с теми же id и не трогает C++.
//
// В этом файле НЕТ отделителей `//---`: они разложили бы его на суб-ресурсы.

name = cave

values  = ./values.tavl
buffers = ./buffers.tavl
shared_buffers = [ ../shared/shape_buffers.tavl ]

steps = [
  {
    name = skeleton
    body = ./01_skeleton.lua
    reads = [ site, nodes, edges, graph_meta ]
    writes = [ rooms, links, state, galleries, lobes, turns, pockets, environment_counts, pillars ]
  }
  {
    name = features
    body = ./02_features.lua
    reads = [ site, rooms ]
    writes = [ features, state ]
  }
]

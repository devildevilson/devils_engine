// Декоративный карман ребра: горловина от устья до камеры и сама камера, с неровностью стенки (рельеф) и
// искажением пространства (сдвиг точки до 0.7 м). Строка — элемент буфера `pockets`.
{
  ctx_save = { relief = 0.45 * (0.5 + 0.5 * relief_a) + 0.35 * (0.5 + 0.5 * relief_b) }
  ctx_save = { wx = x + 0.4041451884327381 * warp_x, wy = y + 0.4041451884327381 * warp_y, wz = z + 0.4041451884327381 * warp_z }
  ctx_save = { bx = centre_x - mouth_x, by = centre_y - mouth_y, bz = centre_z - mouth_z, px = ctx:saved:wx - mouth_x, py = ctx:saved:wy - mouth_y, pz = ctx:saved:wz - mouth_z }
  ctx_save = { t = clamp((ctx:saved:px * ctx:saved:bx + ctx:saved:py * ctx:saved:by + ctx:saved:pz * ctx:saved:bz) / (ctx:saved:bx * ctx:saved:bx + ctx:saved:by * ctx:saved:by + ctx:saved:bz * ctx:saved:bz), 0, 1) }
  ctx_save = { dx = ctx:saved:px - ctx:saved:bx * ctx:saved:t, dy = ctx:saved:py - ctx:saved:by * ctx:saved:t, dz = ctx:saved:pz - ctx:saved:bz * ctx:saved:t }
  ctx_save = { cx = ctx:saved:wx - centre_x, cy = ctx:saved:wy - centre_y, cz = ctx:saved:wz - centre_z }
  min(sqrt(ctx:saved:dx * ctx:saved:dx + ctx:saved:dy * ctx:saved:dy + ctx:saved:dz * ctx:saved:dz) - core_radius, sqrt(ctx:saved:cx * ctx:saved:cx + ctx:saved:cy * ctx:saved:cy + ctx:saved:cz * ctx:saved:cz) - radius) - 0.7 - ctx:saved:relief
}

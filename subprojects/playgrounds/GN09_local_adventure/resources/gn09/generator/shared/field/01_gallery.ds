// Галерея ребра: эллиптическое сечение (ширина и свод раздуты двумя импульсами вдоль ребра) вокруг отрезка
// портов, гарантированное ядро в нём же и неровность стенки шумами. Строка — элемент буфера `galleries`.
{
  ctx_save = { wall = 0.85 * broad + 0.35 * detail, ax = x - port_a_x, ay = y - port_a_y, az = z - port_a_z }
  ctx_save = { along = ctx:saved:ax * axis_x + ctx:saved:ay * axis_y + ctx:saved:az * axis_z }
  ctx_save = { t = clamp(ctx:saved:along / distance, 0, 1), c = clamp(ctx:saved:along, 0, distance) }
  ctx_save = { ox = ctx:saved:ax - axis_x * ctx:saved:c, oy = ctx:saved:ay - axis_y * ctx:saved:c, oz = ctx:saved:az - axis_z * ctx:saved:c }
  ctx_save = { side = ctx:saved:ox * right_x + ctx:saved:oy * right_y + ctx:saved:oz * right_z, height = ctx:saved:ox * up_x + ctx:saved:oy * up_y + ctx:saved:oz * up_z }
  ctx_save = { beyond = max(max(-ctx:saved:along, ctx:saved:along - distance), 0) }
  ctx_save = { core = sqrt(ctx:saved:ox * ctx:saved:ox + ctx:saved:oy * ctx:saved:oy + ctx:saved:oz * ctx:saved:oz) - core_radius }
  ctx_save = { q1 = max(0, 1 - abs(ctx:saved:t - first_t) / 0.27), q2 = max(0, 1 - abs(ctx:saved:t - second_t) / 0.27) }
  ctx_save = { p1 = ctx:saved:q1 * ctx:saved:q1 * (3 - 2 * ctx:saved:q1), p2 = ctx:saved:q2 * ctx:saved:q2 * (3 - 2 * ctx:saved:q2) }
  ctx_save = { bw = (base_width + first_width * ctx:saved:p1 + second_width * ctx:saved:p2) * biome_width, roof = base_roof + pulse * (2 * ctx:saved:p1 + 2.5 * ctx:saved:p2) + vertical_gain }
  ctx_save = { m = min(ctx:saved:bw, ctx:saved:roof) }
  ctx_save = { gallery = (sqrt((ctx:saved:side / ctx:saved:bw) * (ctx:saved:side / ctx:saved:bw) + (ctx:saved:height / ctx:saved:roof) * (ctx:saved:height / ctx:saved:roof) + (ctx:saved:beyond / ctx:saved:m) * (ctx:saved:beyond / ctx:saved:m)) - 1) * ctx:saved:m + (1 - 0.75 * constriction) * ctx:saved:wall }
  min(ctx:saved:core, ctx:saved:gallery)
}

// Буферы генератора места GN09.

// Вход пещеры: что известно о месте до раскладки.
{
  name = site
  format = [
    centre = v3
    // Ядро прохода: R + охранный слой. Полуоси любой формы не меньше него.
    core = v1
    // Радиус полости узла (комната 0).
    main_radius = v1
    // Граница места: скелет пещеры с запасом на формы не дальше от узла (хост отбирает пещеры чанка по ней).
    extent = v1
    // 0 karst, 1 rift, 2 chimney
    biome = ui1
    // 0 ore_cave, 1 nest_cave, 2 thermal_cave
    recipe = ui1
  ]
  size = one
}

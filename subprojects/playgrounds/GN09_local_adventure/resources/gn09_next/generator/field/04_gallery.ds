 (sqrt(ctx:saved:u*ctx:saved:u/(ctx:saved:width*ctx:saved:width)+ctx:saved:v*ctx:saved:v/(ctx:saved:height*ctx:saved:height)+ctx:saved:w*ctx:saved:w/(ctx:saved:cap*ctx:saved:cap))-1)*ctx:saved:cap+ctx:saved:relief

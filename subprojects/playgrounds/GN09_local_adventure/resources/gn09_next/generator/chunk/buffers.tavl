// Решётка узлов чанка с полосой в мировых метрах (`d`, double). Если над решёткой нет ни одной формы,
// а фон выше нуля, чанк — сплошная порода: surface_counts.sampled = 0, поверхности нет. Саму
// поверхность field_surface строит по своей сетке тетраэдров.
{
  name = lattice
  format = [ position = d3 ]
  extent = [ chunk_padded, chunk_padded, chunk_padded ]
}

// Поверхность чанка: мировые позиции, нормаль и порода (метка поля `solid`).
{
  name = surface
  format = [ position = d3, normal = d3, shade = ui1 ]
  size = surface_capacity
}

// Треугольники аванпостов, обрезанные по чанку (мировые позиции, нормаль грани, материал).
{
  name = structure_surface
  format = [ position = d3, normal = d3, shade = ui1 ]
  size = structure_vertex_capacity
}

{
  name = surface_counts
  format = [ vertices = ui1, structure = ui1, props = ui1, sampled = ui1, shapes = ui1 ]
  size = one
}

// Формат предметов для хоста. Генератор предметов не ставит: буфер всегда пуст.
{
  name = props
  format = [ position = d3, kind = ui1, node = ul1, index = ui1 ]
  size = prop_capacity
}

{
  name = chunk_meta
  // seed — зерно мира; lower — нижняя граница фона поля (field_bound).
  format = [ seed = ul1, lower = d1, biome = ui1 ]
  size = one
}

{ name = detail_boxes, size = cave_detail_capacity, format = [ low = d3, high = d3 ] }

name = gn09_next
constants = ./constants.tavl
modules = [ { name = caves, path = ./modules/caves.lua }, { name = world, path = ./modules/world.lua }, { name = mesh, path = ./modules/mesh.lua }, { name = biomes, path = ./modules/biomes.lua }, { name = network, path = ./modules/network.lua }, { name = feature_bounds, path = ./modules/feature_bounds.lua }, { name = feature_collect, path = ./modules/feature_collect.lua } ]
noise_slots = [ { name = terrain_broad, seed_add = 911, period = 31 }, { name = terrain_detail, seed_add = 912, period = 7 } ]
background = { enabled = true, base = 3, outside = 3, y_min_constant = world_y_min, y_max_constant = world_y_max,
 upper = 3, lower = 3 }
shapes = [
 { name = station_cut, buffer = station_cut, count = station_meta.cuts, box_a = centre, reach = "sqrt(half_x*half_x+half_y*half_y+half_z*half_z)+3.5", tag = tag, role = cut, value = ./field/02_box.ds },
 { name = passages, buffer = passages, count = terrain_meta.passages, blend = 0.35, box_a = a, box_b = b, reach = reach, tag = tag, value = ./field/04_gallery.ds },
 { name = shelters, buffer = shelters, count = terrain_meta.shelters, box_a = a, box_b = b, reach = "radius+3.5", tag = tag, role = cut, value = ./field/01_capsule.ds },
 { name = caverns, buffer = caverns, count = cavern_meta.caverns, blend = 0.35, box_a = centre, reach = "max(half_x,max(half_y,half_z))*(1+(relief+3.5)/min(half_x,min(half_y,half_z)))+1", tag = tag, value = ./field/05_cavern.ds },
 { name = biome_cell, buffer = biome_cell, count = cavern_meta.cells, box_a = low, box_b = high, box = aabb, reach = 3.5, tag = 0, value = ./field/08_domain.ds,
   parts = [ { buffer = biome_clips, first = first_clip, count = clip_count, op = max, value = ./field/07_biome_clip.ds, box_a = low, box_b = high } ] },
 { name = cave_chambers, buffer = cave_chambers, count = cave_meta.chambers, blend = 0.35, box_a = centre,
   reach = "max(half_x,max(half_y,half_z))*(1+(relief+3.5)/min(half_x,min(half_y,half_z)))+1", tag = tag, role = cut, value = ./field/11_oriented_cavern.ds },
 { name = small_passages, buffer = passages, count = cave_meta.passages, blend = 0.2, box_a = a, box_b = b, reach = reach, tag = tag, role = cut, value = ./field/04_gallery.ds },
 { name = ocean, buffer = ocean, count = cavern_meta.ocean, box_a = low, box_b = high, box = aabb, reach = 0, tag = 4, value = ./field/09_ocean.ds },
 { name = collapse_voids, buffer = collapse_voids, count = terrain_meta.collapses, blend = 0.35, box_a = centre, reach = "max(half_x,max(half_y,half_z))*(1+(relief+3.5)/min(half_x,min(half_y,half_z)))+1", tag = tag, value = ./field/05_cavern.ds },
 { name = anchored_rocks, buffer = details, count = features_meta.details, box_a = a, box_b = b, reach = "radius+3.5", tag = tag, role = fill, value = ./field/06_rib.ds },
 { name = rubble, buffer = heaps, count = features_meta.heaps, box_a = centre, reach = "sqrt(half_x*half_x+half_y*half_y+half_z*half_z)*(1+4.1/min(half_x,min(half_y,half_z)))+1", tag = tag, role = fill, value = ./field/10_rubble.ds }

]
generators = [
 { name = biome, entry = ./biome/biome.tavl, key = 2, outputs = [ biome ], capacity = 128 },
 { name = biome_point_home, entry = ./biome/point_home.tavl, key = 2, outputs = [ biome_keys, biome_source_count ], capacity = 1024,
   trim = { biome_keys = biome_source_count.value } },
 { name = biome_query, entry = ./biome/query.tavl, key = 2, outputs = [ biome_sample ], capacity = 1024,
   links = [ { name = home, from = biome_point_home, key = same },
     { name = sites, from = biome, keys = [ biome_keys.key ], count = biome_source_count.value } ] },
 { name = biome_window_home, entry = ./biome/window_home.tavl, key = 2, outputs = [ biome_keys, biome_source_count ], capacity = 128,
   trim = { biome_keys = biome_source_count.value } },
 { name = biome_window, entry = ./biome/window.tavl, key = 2, outputs = [ biome_pixels ], capacity = 128,
   links = [ { name = home, from = biome_window_home, key = same },
     { name = sites, from = biome, keys = [ biome_keys.key ], count = biome_source_count.value } ] },
 { name = network_home, entry = ./network/home.tavl, key = 2, outputs = [ network_request ], capacity = 1024 },
 { name = network, entry = ./network/network.tavl, key = 2, capacity = 1024,
   outputs = [ network_node, network_nodes, network_edges, network_paths, network_routes, network_meta ],
   trim = { network_nodes = network_meta.nodes, network_edges = network_meta.edges, network_paths = network_meta.edges, network_routes = network_meta.routes },
   links = [ { name = home, from = network_home, key = same },
             { name = biome, from = biome_query, keys = [ network_request.position ] } ] },
 { name = terrain, entry = ./terrain/terrain.tavl, key = 2, capacity = 1024,
   outputs = [ passages, shelters, ribs, collapse_voids, terrain_meta ], trim = { passages = terrain_meta.passages, shelters = terrain_meta.shelters, ribs = terrain_meta.ribs, collapse_voids = terrain_meta.collapses },
   links = [ { name = network, from = network, key = same } ] },
 { name = biome_terrain, entry = ./terrain/biome.tavl, key = 2, capacity = 128,
   outputs = [ caverns, ocean, buttresses, cavern_meta, biome_clips, biome_cell ], trim = { ocean = cavern_meta.ocean, caverns = cavern_meta.caverns, buttresses = cavern_meta.buttresses, biome_clips = cavern_meta.clips },
   links = [ { name = biome, from = biome, key = same } ] },
 { name = biome_domain, entry = ./biome/biome.tavl, key = 2, outputs = [ biome ], capacity = 128,
   links = [ { name = geometry, from = biome_terrain, key = same } ],
   fields = [ { name = cell, terms = [ { kind = biome_cell, link = geometry } ] } ] },
 { name = terrain_scope, entry = ./terrain/scope.tavl, key = 3, capacity = 2048,
   outputs = [ terrain_keys, biome_terrain_keys, terrain_count ], trim = { terrain_keys = terrain_count.terrain, biome_terrain_keys = terrain_count.biomes } },
 { name = feature_scope, entry = ./features/scope.tavl, key = 3, outputs = [ terrain_keys, biome_terrain_keys, terrain_count ], capacity = 256,
   links = [ { name = candidates, from = terrain, project = [ 0, 1 ] }, { name = biome_candidates, from = biome_terrain, project = [ 0, 1 ] } ],
   trim = { terrain_keys = terrain_count.terrain, biome_terrain_keys = terrain_count.biomes } },
 { name = features, entry = ./features/features.tavl, key = 3, capacity = 256,
   outputs = [ details, heaps, roots, features_meta ], trim = { details = features_meta.details, heaps = features_meta.heaps, roots = features_meta.roots },
   links = [ { name = candidates, from = terrain, project = [ 0, 1 ] }, { name = biome_candidates, from = biome_terrain, project = [ 0, 1 ] },
     { name = scope, from = feature_scope, key = same },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes } ],
   fields = [ { name = protected, terms = [ { kind = shelters, link = terrain } ] }, { name = raw, terms = [ { kind = passages, link = terrain }, { kind = caverns, link = biomes }, { kind = ocean, link = biomes }, { kind = shelters, link = terrain } ] },
     { name = support, terms = [ { kind = passages, link = terrain }, { kind = caverns, link = biomes }, { kind = ocean, link = biomes },
       { kind = collapse_voids, link = terrain }, { kind = shelters, link = terrain } ] } ] },
 { name = feature_collect, entry = ./features/collect.tavl, key = 3, capacity = 2048,
   outputs = [ feature_keys, feature_count ], trim = { feature_keys = feature_count.value },
   links = [ { name = scope, from = terrain_scope, key = same },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes } ] },
 { name = feature_place_collect, entry = ./features/places.tavl, key = 3, capacity = 512,
   outputs = [ feature_keys, feature_count ], trim = { feature_keys = feature_count.value },
   links = [ { name = scope, from = outpost_scope, key = same },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes } ] },
 { name = natural_landscape, entry = ./chunk/chunk.tavl, key = 3, capacity = 1024,
   outputs = [ samples, surface, surface_counts, structure_surface, props, chunk_meta ],
   trim = { surface = surface_counts.vertices, structure_surface = surface_counts.structure, props = surface_counts.props },
   links = [ { name = scope, from = terrain_scope, key = same },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes },
     { name = detail_keys, from = feature_collect, key = same },
     { name = features, from = features, keys = [ feature_keys.key ], count = feature_count.value } ],
   fields = [ { name = solid, terms = [ { kind = passages, link = terrain }, { kind = caverns, link = biomes }, { kind = ocean, link = biomes }, { kind = collapse_voids, link = terrain },
     { kind = anchored_rocks, link = features }, { kind = rubble, link = features }, { kind = shelters, link = terrain } ] } ] },
 { name = landscape, entry = ./chunk/chunk.tavl, key = 3, capacity = 1024,
   outputs = [ samples, surface, surface_counts, structure_surface, props, chunk_meta ],
   trim = { surface = surface_counts.vertices, structure_surface = surface_counts.structure, props = surface_counts.props },
   links = [ { name = scope, from = terrain_scope, key = same },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes },
     { name = stations, from = outpost, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = caves_scope, from = small_cave_scope, key = same },
     { name = caves, from = small_cave, keys = [ small_cave_keys.key ], count = small_cave_count.value },
     { name = detail_keys, from = feature_collect, key = same },
     { name = features, from = features, keys = [ feature_keys.key ], count = feature_count.value } ],
   fields = [ { name = solid, terms = [ { kind = passages, link = terrain }, { kind = caverns, link = biomes }, { kind = ocean, link = biomes }, { kind = collapse_voids, link = terrain },
     { kind = anchored_rocks, link = features }, { kind = rubble, link = features }, { kind = shelters, link = terrain }, { kind = station_cut, link = stations }, { kind = small_passages, link = caves }, { kind = cave_chambers, link = caves } ] } ] },
 { name = outpost_scope, entry = ./outpost/scope.tavl, key = 3, capacity = 512,
   outputs = [ terrain_keys, biome_terrain_keys, terrain_count ], trim = { terrain_keys = terrain_count.terrain, biome_terrain_keys = terrain_count.biomes } },
 { name = outpost_context, entry = ./outpost/context.tavl, key = 2, outputs = [ outpost_context ], capacity = 256 },
 { name = outpost, entry = ./outpost/outpost.tavl, key = 2, capacity = 256,
   outputs = [ station_cut, station_rooms, station_walls, station_mesh, station_meta, outpost_meta ],
   trim = { station_cut = station_meta.cuts, station_rooms = station_meta.rooms, station_walls = station_meta.walls, station_mesh = station_meta.triangles },
   links = [ { name = network, from = network, key = same }, { name = context, from = outpost_context, key = same },
     { name = scope, from = outpost_scope, keys = [ outpost_context.chunk ] },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes },
     { name = detail_keys, from = feature_place_collect, keys = [ outpost_context.chunk ] },
     { name = features, from = features, keys = [ feature_keys.key ], count = feature_count.value } ],
   fields = [ { name = natural, terms = [ { kind = passages, link = terrain }, { kind = caverns, link = biomes }, { kind = ocean, link = biomes }, { kind = collapse_voids, link = terrain },
     { kind = anchored_rocks, link = features }, { kind = rubble, link = features }, { kind = shelters, link = terrain } ] }, { name = clearance, terms = [ { kind = shelters, link = terrain } ] } ] },
 { name = cave_site, entry = ./small_cave/site.tavl, key = 3, outputs = [ cave_site ], capacity = 256,
   links = [ { name = home, from = cave_inspect_home, key = same },
     { name = scope, from = outpost_scope, keys = [ cave_inspect_request.chunk ] },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes } ],
   fields = [ { name = base, terms = [ { kind = passages, link = terrain }, { kind = caverns, link = biomes }, { kind = ocean, link = biomes },
     { kind = collapse_voids, link = terrain }, { kind = shelters, link = terrain } ] } ] },
 { name = small_cave, entry = ./small_cave/cave.tavl, key = 3, capacity = 256,
   links = [ { name = site, from = cave_site, key = same } ],
   outputs = [ passages, cave_nodes, cave_edges, cave_meta, cave_chambers, cave_details, cave_detail_meta ],
   trim = { passages = cave_meta.passages, cave_nodes = cave_meta.nodes, cave_edges = cave_meta.edges, cave_chambers = cave_meta.chambers, cave_details = cave_detail_meta.count } },
 { name = small_cave_scope, entry = ./small_cave/scope.tavl, key = 3, outputs = [ small_cave_keys, small_cave_count ], capacity = 2048,
   trim = { small_cave_keys = small_cave_count.value } },
 { name = cave_inspect_home, entry = ./small_cave/inspect_home.tavl, key = 3, outputs = [ cave_inspect_request ], capacity = 128 },
 { name = cave_inspect, entry = ./small_cave/inspect.tavl, key = 3, capacity = 128,
   outputs = [ cave_portals, cave_inspection ], trim = { cave_portals = cave_inspection.portals },
   links = [ { name = system, from = small_cave, key = same }, { name = home, from = cave_inspect_home, key = same },
     { name = scope, from = outpost_scope, keys = [ cave_inspect_request.chunk ] },
     { name = terrain, from = terrain, keys = [ terrain_keys.key ], count = terrain_count.terrain },
     { name = biomes, from = biome_terrain, keys = [ biome_terrain_keys.key ], count = terrain_count.biomes },
     { name = detail_keys, from = feature_place_collect, keys = [ cave_inspect_request.chunk ] },
     { name = features, from = features, keys = [ feature_keys.key ], count = feature_count.value } ],
   fields = [ { name = natural, terms = [ { kind = passages, link = terrain }, { kind = caverns, link = biomes }, { kind = ocean, link = biomes }, { kind = collapse_voids, link = terrain },
     { kind = anchored_rocks, link = features }, { kind = rubble, link = features }, { kind = shelters, link = terrain } ] } ] },
 { name = cave_landscape, entry = ./chunk/chunk.tavl, key = 3, capacity = 512,
   outputs = [ samples, surface, surface_counts, structure_surface, props, chunk_meta ],
   trim = { surface = surface_counts.vertices, structure_surface = surface_counts.structure, props = surface_counts.props },
   links = [ { name = scope, from = small_cave_scope, key = same },
     { name = caves, from = small_cave, keys = [ small_cave_keys.key ], count = small_cave_count.value } ],
   fields = [ { name = solid, terms = [ { kind = small_passages, link = caves }, { kind = cave_chambers, link = caves } ] } ] }
]

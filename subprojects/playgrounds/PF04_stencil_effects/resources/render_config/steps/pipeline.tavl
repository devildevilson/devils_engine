{
  name = draw_scene
  material = scene_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ camera_data ]
  command = "draw"
}
{
  name = draw_selection_mask
  material = selection_mask_material
  geometry = scene_geometry
  draw_group = selected_draw_group
  sets = [ camera_data ]
  command = "draw"
  // MAX по .r сохраняет coverage=1, MAX по .g выбирает ближайшую reverse-Z depth независимо от draw order.
  blending = {
    selection_mask = { enable = true, color = "one max one", alpha = "one max one" }
  }
}
{
  name = draw_selected
  material = selected_material
  geometry = scene_geometry
  draw_group = selected_draw_group
  stencil_state = selection_stencil_state
  sets = [ camera_data ]
  command = "draw"
}
{
  name = draw_wallhack_target
  material = scene_material
  geometry = scene_geometry
  draw_group = wallhack_target_draw_group
  sets = [ camera_data ]
  command = "draw"
}
{
  name = write_wallhack_mask
  material = wallhack_mask_material
  geometry = scene_geometry
  draw_group = wallhack_target_draw_group
  sets = [ camera_data ]
  command = "draw"
  blending = { scene_color = { mask = none } }
}
{
  name = apply_wallhack_silhouette
  material = wallhack_silhouette_material
  geometry = fullscreen_geometry
  command = "draw constant fullscreen_draw"
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = apply_local_outline
  material = local_outline_material
  geometry = fullscreen_geometry
  sets = [ camera_data, selection_mask_read ]
  command = "draw constant fullscreen_draw"
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = apply_overlay_outline
  material = overlay_outline_material
  geometry = fullscreen_geometry
  sets = [ camera_data, selection_mask_read ]
  command = "draw constant fullscreen_draw"
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  // Graph ставит этот redraw после локального outline, но до optional through-wall overlay. Поэтому target
  // перекрывает локальную кромку как обычный объект, а selector режима O остаётся поверх всей 3D-сцены.
  name = redraw_wallhack_visible
  material = wallhack_visible_material
  geometry = scene_geometry
  draw_group = wallhack_target_draw_group
  sets = [ camera_data ]
  command = "draw"
}
{
  name = write_local_mask
  material = local_mask_material
  geometry = local_mask_geometry
  draw_group = local_mask_draw_group
  sets = [ camera_data ]
  command = "draw"
  // Это stencil-only pass внутри color target: fragment выполняется, но attachment color не меняется.
  blending = { scene_color = { mask = none } }
}
{
  name = apply_local_tint
  material = local_tint_material
  geometry = fullscreen_geometry
  sets = [ camera_data ]
  command = "draw constant fullscreen_draw"
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = visualize_stencil
  material = stencil_debug_material
  geometry = fullscreen_geometry
  stencil_state = selection_stencil_state
  sets = [ camera_data ]
  command = "draw constant fullscreen_draw"
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = write_window_mask
  material = window_mask_material
  geometry = window_mask_geometry
  draw_group = window_mask_draw_group
  sets = [ camera_data ]
  command = "draw"
  blending = { scene_color = { mask = none } }
}
{
  name = clear_window
  material = window_clear_material
  geometry = fullscreen_geometry
  command = "draw constant fullscreen_draw"
}
{
  name = draw_window_scene
  material = window_scene_material
  geometry = scene_geometry
  draw_group = scene_draw_group
  sets = [ window_camera_data ]
  command = "draw"
}
{
  name = draw_window_selected
  material = window_scene_material
  geometry = scene_geometry
  draw_group = selected_draw_group
  sets = [ window_camera_data ]
  command = "draw"
}
{
  name = write_face_fixture
  material = face_fixture_writer_material
  geometry = face_fixture_geometry
  draw_group = face_fixture_draw_group
  sets = [ camera_data ]
  command = "draw"
  blending = { scene_color = { mask = none } }
}
{
  name = visualize_fixture_front
  material = face_fixture_front_material
  geometry = fullscreen_geometry
  command = "draw constant fullscreen_draw"
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = visualize_fixture_back
  material = face_fixture_back_material
  geometry = fullscreen_geometry
  command = "draw constant fullscreen_draw"
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = draw_playground_overlay
  material = ui_overlay_material
  geometry = ui_geometry
  command = "draw_ui ui_vertices ui_indices ui_commands"
  sets = [ camera_data, ui_textures ]
  push_constants = [ ui_push ]
  blending = {
    scene_color = { enable = true, color = "src_alpha add one_minus_src_alpha", alpha = "one add one_minus_src_alpha" }
  }
}
{
  name = present_scene
  command = "blit scene_color swapchain_image"
}

{
  name = pf04_stencil
  startup = true
  passes = [
    {
      name = pf04_scene
      render_target = scene_target
      subpasses = [
        { scene_color = (undefined, clear), scene_depth_stencil = (undefined, clear) },
        { scene_color = (color_attachment, store), scene_depth_stencil = (depth_attachment, store) },
        { scene_color = (transfer_src, store), scene_depth_stencil = (depth_attachment, store) }
      ]
      steps = [ draw_scene, draw_selected, write_local_mask, draw_outline, apply_local_tint, visualize_stencil, draw_playground_overlay ]
    },
    {
      name = pf04_present
      wait_for = [ swapchain_image ]
      subpasses = [
        { scene_color = (transfer_src, store), swapchain_image = (transfer_dst, store) },
        { scene_color = (color_attachment, store), swapchain_image = (present, store) }
      ]
      steps = [ present_scene ]
    }
  ]
  present_source = swapchain_image
}

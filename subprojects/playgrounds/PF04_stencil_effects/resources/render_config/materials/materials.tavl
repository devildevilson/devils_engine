{
  name = scene_material
  shaders = {
    vertex = "scene.vert.glsl"
    fragment = "scene.frag.glsl"
  }
  depth = {
    test = true
    write = true
    compare = greater
  }
  raster = {
    cull = back
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Выбранный объект одновременно рисует цвет/глубину и записывает reference=1 в stencil.
  name = selected_material
  dynamic = [ stencil_reference, stencil_compare_mask, stencil_write_mask ]
  shaders = {
    vertex = "scene.vert.glsl"
    fragment = "scene.frag.glsl"
  }
  depth = {
    test = true
    write = true
    compare = greater
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = replace
      depth_fail_op = keep
      compare_op = always
      compare_mask = 1
      write_mask = 1
      reference = 1
    }
    back = {
      fail_op = keep
      pass_op = replace
      depth_fail_op = keep
      compare_op = always
      compare_mask = 1
      write_mask = 1
      reference = 1
    }
  }
  raster = {
    cull = back
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Отдельный mask pass получает полную проекцию selected object. Depth attachment не нужен: step применяет
  // order-independent MAX blending к reverse-Z depth в color channel и оставляет ближайшую поверхность.
  name = selection_mask_material
  shaders = {
    vertex = "selection_mask.vert.glsl"
    fragment = "selection_mask.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
  }
  raster = {
    cull = back
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Локальный вариант переносит depth selected object на расширенное кольцо. Оно участвует в reverse-Z
  // как пиксели самого объекта и записывает depth, чтобы последующий spatial window уважал эту границу.
  name = local_outline_material
  definitions = [ PF04_OUTLINE_OVERLAY = "0" ]
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "screen_outline.frag.glsl"
  }
  depth = {
    test = true
    write = true
    compare = greater_or_equal
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Дополнительный through-wall selector использует ту же маску и дилатацию, но намеренно отключает
  // depth test. Runtime-флаг только включает consumer; локальный outline остаётся базовым эффектом.
  name = overlay_outline_material
  definitions = [ PF04_OUTLINE_OVERLAY = "1" ]
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "screen_outline.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Видимая часть повторной target mesh проходит >= depth и не меняет stencil.
  // Только скрытые за ближней геометрией fragments попадают в depth_fail_op и пишут bit 0x40.
  name = wallhack_mask_material
  shaders = {
    vertex = "scene.vert.glsl"
    fragment = "wallhack_mask.frag.glsl"
  }
  depth = {
    test = true
    write = false
    compare = greater_or_equal
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = replace
      compare_op = always
      compare_mask = 64
      write_mask = 64
      reference = 64
    }
    back = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = replace
      compare_op = always
      compare_mask = 64
      write_mask = 64
      reference = 64
    }
  }
  raster = {
    cull = back
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Fullscreen consumer покрасит только записанные hidden-target pixels, не отключая depth у основной сцены.
  name = wallhack_silhouette_material
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "wallhack_silhouette.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 68
      write_mask = 0
      reference = 64
    }
    back = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 68
      write_mask = 0
      reference = 64
    }
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Повторяет только видимую часть target после overlay-outline. Portal bit запрещает draw внутри окна:
  // alternate view остаётся самостоятельным содержимым, а вне окна обычный reverse-Z восстанавливает
  // ровно те пиксели цели, которые она занимала до post-effect.
  name = wallhack_visible_material
  shaders = {
    vertex = "scene.vert.glsl"
    fragment = "scene.frag.glsl"
  }
  depth = {
    test = true
    write = false
    compare = greater_or_equal
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 4
      write_mask = 0
      reference = 0
    }
    back = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 4
      write_mask = 0
      reference = 0
    }
  }
  raster = {
    cull = back
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Невидимая world-space пластина записывает только bit 1 (0x02), сохраняя selection bit 0.
  name = local_mask_material
  shaders = {
    vertex = "local_mask.vert.glsl"
    fragment = "local_mask.frag.glsl"
  }
  depth = {
    test = true
    write = false
    compare = greater
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = replace
      depth_fail_op = keep
      compare_op = always
      compare_mask = 2
      write_mask = 2
      reference = 2
    }
    back = {
      fail_op = keep
      pass_op = replace
      depth_fail_op = keep
      compare_op = always
      compare_mask = 2
      write_mask = 2
      reference = 2
    }
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Fullscreen tint запускается только где установлен local-effect bit 0x02.
  name = local_tint_material
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "local_tint.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 2
      write_mask = 0
      reference = 2
    }
    back = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 2
      write_mask = 0
      reference = 2
    }
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Aperture пишет только bit 2 (0x04). Color/depth остаются от основной сцены до window clear.
  name = window_mask_material
  shaders = {
    vertex = "window_mask.vert.glsl"
    fragment = "window_mask.frag.glsl"
  }
  depth = {
    test = true
    write = false
    compare = greater
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = replace
      depth_fail_op = keep
      compare_op = always
      compare_mask = 4
      write_mask = 4
      reference = 4
    }
    back = {
      fail_op = keep
      pass_op = replace
      depth_fail_op = keep
      compare_op = always
      compare_mask = 4
      write_mask = 4
      reference = 4
    }
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Fullscreen fragment очищает color и reverse-Z depth только внутри aperture bit 0x04.
  name = window_clear_material
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "window_clear.frag.glsl"
  }
  depth = {
    test = true
    write = true
    compare = always
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 4
      write_mask = 0
      reference = 4
    }
    back = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 4
      write_mask = 0
      reference = 4
    }
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Повторный scene draw использует другую camera UBO и проходит только внутри aperture bit 0x04.
  name = window_scene_material
  shaders = {
    vertex = "scene.vert.glsl"
    fragment = "window_scene.frag.glsl"
  }
  depth = {
    test = true
    write = true
    compare = greater
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 4
      write_mask = 0
      reference = 4
    }
    back = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 4
      write_mask = 0
      reference = 4
    }
  }
  raster = {
    cull = back
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Этот fullscreen consumer не читает stencil как texture: fixed-function compare сам оставляет
  // фрагменты только там, где reference равен единице. Шейдер управляет лишь прозрачностью debug tint.
  name = stencil_debug_material
  dynamic = [ stencil_reference, stencil_compare_mask, stencil_write_mask ]
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "stencil_debug.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 1
      write_mask = 0
      reference = 1
    }
    back = {
      fail_op = keep
      pass_op = keep
      depth_fail_op = keep
      compare_op = equal
      compare_mask = 1
      write_mask = 0
      reference = 1
    }
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  // Один draw содержит CCW и CW quads: front заменяет bits 0x30 на 0x10, back инвертирует их в 0x30.
  name = face_fixture_writer_material
  shaders = {
    vertex = "face_fixture.vert.glsl"
    fragment = "face_fixture_writer.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
    stencil_test = true
    front = {
      fail_op = keep
      pass_op = replace
      depth_fail_op = keep
      compare_op = always
      compare_mask = 48
      write_mask = 48
      reference = 16
    }
    back = {
      fail_op = keep
      pass_op = invert
      depth_fail_op = keep
      compare_op = always
      compare_mask = 48
      write_mask = 48
      reference = 16
    }
  }
  raster = {
    cull = none
    front_face = ccw
    polygon = fill
    line_width = 1.0
  }
}
{
  name = face_fixture_front_material
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "face_fixture_front.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
    stencil_test = true
    front = { fail_op = keep, pass_op = keep, depth_fail_op = keep, compare_op = equal, compare_mask = 48, write_mask = 0, reference = 16 }
    back = { fail_op = keep, pass_op = keep, depth_fail_op = keep, compare_op = equal, compare_mask = 48, write_mask = 0, reference = 16 }
  }
  raster = { cull = none, front_face = ccw, polygon = fill, line_width = 1.0 }
}
{
  name = face_fixture_back_material
  shaders = {
    vertex = "fullscreen.vert.glsl"
    fragment = "face_fixture_back.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
    stencil_test = true
    front = { fail_op = keep, pass_op = keep, depth_fail_op = keep, compare_op = equal, compare_mask = 48, write_mask = 0, reference = 48 }
    back = { fail_op = keep, pass_op = keep, depth_fail_op = keep, compare_op = equal, compare_mask = 48, write_mask = 0, reference = 48 }
  }
  raster = { cull = none, front_face = ccw, polygon = fill, line_width = 1.0 }
}
{
  name = ui_overlay_material
  shaders = {
    vertex = "ui.vert.glsl"
    fragment = "ui.frag.glsl"
  }
  depth = {
    test = false
    write = false
    compare = always
  }
  raster = {
    cull = none
    front_face = cw
    polygon = fill
    line_width = 1.0
  }
}

// Генератор GN06 «здание» — ТОЧКА ВХОДА.
//
// Деления на комнаты и коридоры здесь нет: есть ЗОНЫ и их ВИДЫ. Вид несёт проходимость, предел числа
// связей и то, с какими другими видами зона вправе граничить и вправе соединяться дверью. Коридор —
// это вид без предела связей, кухня — вид, которому дверь разрешена в обеденный зал и в служебный
// ход, но не в покои. Что было структурой, стало данными.
//
// Шесть шагов, и граница между ними — граница ответственности:
//
//   kinds   ЧТО БЫВАЕТ: таблица видов и ТРИ матрицы — смежности, дверей и обязательных дверей;
//   layout  ГДЕ ЧТО СТОИТ: улица, участок застройки, двор; раздел, циркуляция кладётся первой;
//   joins   ЧТО С ЧЕМ ГРАНИЧИТ: стыки выводятся из ПЛАНА ОДИН раз, из них — соседство;
//   roles   ЧТО ЭТО ЗА МЕСТА: виды раскладывает решатель ограничений по матрице смежности;
//   doors   ЧТО С ЧЕМ СОЕДИНЕНО: часть стыков становится дверьми, а дверь — это зона;
//   draw    КАК ЭТО ВЫГЛЯДИТ: объявленное окно участка, показанное клетками.
//
// Шаг `roles` стоит МЕЖДУ стыками и дверьми не случайно: чтобы решить, допустима ли дверь, нужно
// знать виды по обе стороны, а чтобы разложить виды — знать, кто с кем граничит.
//
// Шаг `draw` стоит ПОСЛЕДНИМ, и это главное утверждение всей раскладки: до него ни клетки, ни
// пикселя, ни масштаба нет вовсе — есть план В МЕРЕ. Его выход не читает НИ ОДИН следующий шаг,
// потому что следующих нет; выбросить `draw` значит остаться без картинки и ни без чего больше.

name = gn06_building

values  = ./values.tavl
buffers = ./building_buffers.tavl

steps = [
  {
    name = kinds
    body = ./scripts/S10_kinds.lua
    writes = [ kinds, adjacent_rules, door_rules, required_doors ]
  }

  {
    name = layout
    body = ./scripts/S11_layout.lua
    writes = [ zones, columns, state ]
  }

  {
    name = joins
    body = ./scripts/S12_joins.lua
    reads = [ zones ]
    writes = [ joins, zone_offsets, zone_arcs, state ]
  }

  {
    name = roles
    body = ./scripts/S13_roles.lua
    reads = [ kinds, adjacent_rules, zone_offsets, zone_arcs ]
    writes = [ zones, state ]
  }

  {
    name = doors
    body = ./scripts/S14_doors.lua
    reads = [ kinds, door_rules, required_doors, joins ]
    writes = [ zones, links, state ]
  }

  {
    name = draw
    body = ./scripts/S15_draw.lua
    reads = [ zones, columns ]
    writes = [ cells, state ]
  }
]

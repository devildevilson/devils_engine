// Буферы генератора «здание».
//
// ЕДИНИЦА ЗДЕСЬ ОДНА — ЗОНА. Комнаты, коридоры, залы и двери лежат в ОДНОМ списке и различаются
// только видом: как только дверь стала местом, а не свойством ребра, второй список стал бы вторым
// представлением того же самого.
//
// И ЕДИНИЦА ДЛИНЫ ЗДЕСЬ НЕ КЛЕТКА, А МЕРА. Участок объявлен в мере, места нарезаны в мере, стык
// меряется мерой; клетки заводятся ровно в одном буфере (`cells`) и ровно для того, чтобы показать
// объявленное окно. Размер картинки поэтому ни на что не влияет и ничему не мешает: участок в три
// сотни мер показывается в восьмидесяти клетках так же законно, как в трёхстах.

// ВИДЫ ЗОН. Всё, чем раньше отличались «комната» и «коридор», лежит теперь здесь как данные.
//
// `max_links` — сколько связей вид терпит (ноль значит «без предела»): у коридора их десятки, у
// кладовой одна. Предел ЖЁСТКИЙ: если из-за него зона осталась бы отрезанной, генератор отказывает,
// а не открывает лишнюю дверь.
{
  name = kinds
  format = [ passable = ub1, glyph = ui1, max_links = ui1, weight = v1, colour = ui1 ]
  layout = soa
  size = kind_count
}

// СМЕЖНОСТЬ: какие виды вправе иметь ОБЩУЮ СТЕНУ. Матрица симметрична — у смежности нет направления.
// Её читает решатель, когда раскладывает виды по зонам.
{
  name = adjacent_rules
  format = [ allowed = ub1 ]
  layout = soa
  size = rule_size
}

// ДВЕРИ: между какими видами допустима СВЯЗЬ. Это ДРУГОЕ утверждение, и матрица поэтому вторая:
// у кухни с покоями общая стена бывает, а двери между ними быть не должно. Одной таблицей это не
// выражается, а выраженное одной таблицей однажды означало бы не то, что написано.
{
  name = door_rules
  format = [ allowed = ub1 ]
  layout = soa
  size = rule_size
}

// ТРЕБОВАНИЯ: между какими видами дверь ОБЯЗАНА быть. Третья таблица, и она нужна потому, что
// запретом требование не выражается: «служебный вход в кухню со двора» никаким запретом не получить.
// Обязана быть подмножеством допустимого — пара, объявленная и обязательной, и запрещённой, это
// противоречие в объявлении, и инструмент отказывает до работы.
{
  name = required_doors
  format = [ allowed = ub1 ]
  layout = soa
  size = rule_size
}

// ЗОНЫ: габарит, вид, УСЛОВИЕ для решателя (`given`: ноль значит «вид свободен», иначе вид плюс
// один), ФОРМА и признак колоннады. Двери дописываются в ЭТОТ ЖЕ список — дверь это место.
//
// ФОРМА (`shape` = род и параметр) лежит рядом с габаритом, потому что это данные того же порядка:
// прямоугольник говорит, ГДЕ место, форма — какие его меры. Стыки считаются С УЧЁТОМ формы, и иначе
// было бы неверно: у комнаты со срезанными углами прямой кромки меньше, чем сторона, и дверь в срез
// не ставится. Всё прочее формы по-прежнему не замечает — она меняет длину пробега, а не то, как его
// ищут.
{
  name = zones
  format = [ rect = ui4, kind = ui1, given = ui1, shape = ui2, columns = ub1 ]
  layout = soa
  size = zone_capacity
}

// СТЫКИ, выведенные из ПЛАНА: пара зон, признак «через стену» и отрезок стыка (x, y, длина, ось).
// Пара зон вправе иметь НЕСКОЛЬКО стыков — угловое место на повороте коридора, — и именно отсюда
// берутся кратные связи.
{
  name = joins
  format = [ pair = ui3, span = ui4 ]
  layout = soa
  size = join_capacity
}

// Соседство зон в каноническом CSR: то, что читает решатель ограничений.
{
  name = zone_offsets
  format = [ start = ui1 ]
  layout = soa
  size = zone_offset_count
}

{
  name = zone_arcs
  format = [ zone = ui1 ]
  layout = soa
  size = zone_arc_capacity
}

// СВЯЗИ: (зона, зона, дверь, лишняя). Ноль в поле двери значит ШИРОКИЙ ПРОЁМ — связь без двери, как
// у коридорной ленты с хребтом. `spare` помечает дверь вне остова: запирать можно только её, иначе
// за запертой дверью остаётся кусок здания, куда игра больше не попадёт.
{
  name = links
  format = [ edge = ui4 ]
  layout = soa
  size = link_capacity
}

// КОЛОННЫ: прямоугольники кусков стены, стоящих посреди крупных мест. Список отдельный, а не вид
// зоны, потому что колонна зоной не является — по ней не ходят, у неё нет связей и вид ей не нужен.
// В картинку она попадает вторым входом проектора: сначала места, потом дырки в них.
{
  name = columns
  format = [ rect = ui4 ]
  layout = soa
  size = column_capacity
}

// КАРТИНКА: номер зоны плюс один, ноль — стена. Это ВИД объявленного окна участка, а не источник
// истины: из растра больше ничего не выводится, и ни один шаг после `draw` его не читает. Сторона
// картинки и сторона участка — РАЗНЫЕ числа, и в этом весь смысл.
{
  name = cells
  format = [ zone = ui1 ]
  layout = soa
  extent = [ view, view ]
}

// `lost` и `merged` — ЧЕГО НА КАРТИНКЕ НЕ ВИДНО, и это два разных способа огрубеть: место, не
// поймавшее ни одного центра клетки, и граница, где масштаб съел стену. Пока оба нуля, картинка —
// это план один в один, и по ней законно проверять связность заливкой.
{
  name = state
  format = [ zones = ui1, joins = ui1, places = ui1, links = ui1, columns = ui1, attempts = ui1,
             rollbacks = ui1, lost = ui1, merged = ui1 ]
  layout = soa
  size = single
}

// Общие значения пайплайна GN06.

{
  numbers = {
    // ЁМКОСТЬ списка комнат — ЖЕЛАНИЕ, а не факт. Сколько комнат поместится, до запуска не знает
    // никто: это зависит от размеров, зазора и того, куда легли предыдущие. Занятую длину приносит
    // счётчик, и читать список до ёмкости вместо счётчика значит читать мусор прошлого прогона.
    room_capacity = 48

    // Размеры комнаты В КЛЕТКАХ, обе границы включительно (у норы растр — предмет, а не вид).
    min_room = 4
    max_room = 11

    // ЗАЗОР между комнатами. Ноль означает «можно касаться стенами», а касающиеся комнаты на растре
    // сливаются в одну комнату странной формы — и план начинает описывать не то, что вырезано.
    gap = 2

    // Отступ от края растра: у подземелья есть внешняя стена.
    border = 1

    // Сколько попыток отбора с отказом потратить. Ноль означает «посчитай сам» — инструмент берёт
    // тридцать две на объявленную комнату. Число потраченных попыток приезжает наружу: по карте не
    // видно, взялась ёмкость легко или еле-еле, а это единственное, что отличает разумную плотность
    // от невозможной.
    attempts = 0

    // ПЕТЛИ поверх остова. Остов уже соединяет всё — это его определение, — поэтому петли ничего не
    // чинят и ничего не ломают: они меняют подземелье из дерева коридоров (туда и обратно одной
    // дорогой) в карту с обходными путями.
    extra_links = 5

    // Толщина коридора в клетках.
    corridor_width = 1

    // ===================== ЗДАНИЕ: ЗОНЫ И ИХ ВИДЫ =====================
    //
    // Второй генератор площадки. У него другая постановка: пятно не вырезают, а ДЕЛЯТ, и деления на
    // комнаты и коридоры нет вовсе — есть зоны и виды.

    // НОМЕРА ВИДОВ объявлены здесь, а не только в теле шага: по ним инструменты получают параметры
    // (`corridor_kind`, `door_kind`), и по ним же площадка читает результат. Таблица в скрипте
    // сверяется с этими номерами ПО ИМЕНИ и отказывается вслух при расхождении — иначе перестановка
    // строки в таблице тихо превратила бы кухню в кладовую.
    wall_kind = 0
    corridor_kind = 1
    hall_kind = 2
    kitchen_kind = 3
    room_kind = 4
    store_kind = 5
    door_kind = 6
    street_kind = 7
    yard_kind = 8
    court_kind = 9

    // УЧАСТОК ОБЪЯВЛЕН В МЕРЕ. Клетки к этим числам отношения не имеют: участок в три сотни мер
    // законно показывается в восьмидесяти клетках и в трёхстах — план от этого не меняется вовсе.
    // Площадка переставляет эти числа ключом, потому что только она знает, какой участок попросили.
    plot_width = 64
    plot_height = 64

    // ОКНО ПОКАЗА, тоже в мере: что именно из участка рисовать. По умолчанию — участок целиком.
    // Окно выбирает СМОТРЯЩИЙ: генератор про него ничего не знает и знать не должен.
    view_x = 0
    view_y = 0
    view_w = 64
    view_h = 64

    // УЧАСТОК, А НЕ ЗДАНИЕ: полоса улицы, пятно застройки, полоса двора. Улица и двор — такие же
    // ЗОНЫ, как комнаты, и поэтому наружная дверь не требует никакого отдельного механизма: это
    // обычная дверь, у которой с одной стороны улица.
    //
    // Улица и двор между собой НЕ СВЯЗАНЫ (участок обрезан по краям растра), и это не упущение, а
    // полезное следствие: раз обе зоны обязаны быть достижимы, остов вынужден открыть И парадный, И
    // служебный вход. Обойти дом снаружи можно будет, когда появится соседний участок.
    street_depth = 6
    yard_depth = 5

    // Сколько видов объявлено. Число живёт здесь, потому что по нему считается размер ОБЕИХ матриц
    // ещё до запуска скрипта; сам список видов лежит в теле шага, и расхождение проверяется вслух.
    kind_count = 10

    // Ёмкости списков — ПОЛ, а не потолок: площадка поднимает их под размер пятна, потому что только
    // она знает, какое пятно попросили ключом. Ёмкость — желание: сколько зон выйдет, решает раздел,
    // сколько стыков — растр. Двери дописываются в тот же список зон, поэтому запас нужен и на них.
    zone_capacity = 320
    join_capacity = 1024
    link_capacity = 512
    zone_arc_capacity = 4096
    column_capacity = 512

    // Толщина стены. Стена не список, а ДОПОЛНЕНИЕ: мера, не попавшая ни в одну зону, и есть
    // стена. Толщина нужна, чтобы отличить стык через стену от прямого касания.
    wall = 1

    // Ширина ленты циркуляции и границы глубины полосы, которую она обслуживает. Сколько лент
    // положить, генератор считает сам: это ответ, а не вопрос.
    corridor = 2
    min_band = 5
    max_band = 9

    // Границы места вдоль полосы и сдвиг внутренних стен. Без сдвига ряд мест выходит расчерченным
    // по линейке; сдвиг остаётся в объявленных границах.
    min_room = 4
    max_room = 9
    jitter = 2

    // Дверь. `min_span` — насколько длинным должен быть стык, чтобы стать дверью: короткий пробег
    // (угол в угол) дверью быть не может.
    door_width = 1
    min_span = 3

    // ЩЕДРОСТЬ: сколько дверей открыть СВЕРХ остова. Остов уже обещает достижимость, поэтому лишние
    // двери ничего не чинят — они превращают дерево ходов в здание с обходными путями, и запирать
    // можно ровно их.
    extra_doors = 10

    // АРХИТЕКТУРА. Пятно не обязано резаться до последней каморки: объявленная ДОЛЯ частей остаётся
    // ЦЕЛЫМИ, и это не «большая комната», а не разрезанный кусок — парадный зал, атриум, двор.
    // Нарезкой такого не получить: резка стремится к среднему.
    //
    // Доля, а не число: у маленького пятна частей всего две, и объявленная тройка оставила бы целым
    // всё — здание, в котором ничего не разрезано, перестаёт зависеть от зерна вовсе.
    reserve_percent = 25

    // С какой площади место считается КРУПНЫМ. От этого зависят и форма (крупному полагается
    // округлость или срезанные углы), и колоннада, и то, что не ставшее залом крупное место
    // становится двором.
    big_area = 90

    // Наименьшая сторона, при которой крупное место делается ОКРУГЛЫМ. Меньше — срезанные углы:
    // у маленького эллипса прямой кромки почти не остаётся, а на кромке стоят двери.
    round_min = 7

    // Срез угла у обычного места. Единица — незаметно поодиночке и очень заметно на перекрестьях:
    // там, где сходятся четыре комнаты, срезы оставляют стенной столб. Это и есть колонна, в
    // которую упираются стены.
    corner_cut = 1

    // КОЛОННАДА внутри крупных мест: шаг опор, их сторона и отступ от стены. Отступ не украшение:
    // прилипшая к стене колонна это выступ, а не колонна.
    column_spacing = 4
    column_size = 1
    column_margin = 2

    // Решатель ролей: попытки и откаты (см. GN05).
    role_attempts = 24
    role_rollbacks = 32
    role_history = 8
  }
}

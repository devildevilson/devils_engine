// Буферы генератора GN06.
//
// ПЛАН И ГЕОМЕТРИЯ ЛЕЖАТ ОТДЕЛЬНО, и это главное решение площадки. План — список из десятков
// элементов, который целиком помещается в голове; геометрия — растр из десятков тысяч клеток.
// Пока они разделены, ошибка «дверь не туда» видна в плане, а не в растре, а усложнять план (этажи,
// ключи, замки) можно, не трогая вырезание.

// КОМНАТЫ. Поле одно, четырёхкомпонентное: комната это ОДИН элемент списка, а разложенная на четыре
// параллельных массива она пережила бы ровно один рефакторинг.
{
  name = rooms
  format = [ rect = ui4 ]
  layout = soa
  size = room_capacity
}

// СВЯЗИ: пара номеров комнат и ВЫВЕДЕННЫЕ из неё концы коридора. Остов над M комнатами это ровно
// M-1 связей, петли добираются поверх; ёмкость объявлена отдельным именем, потому что по ней
// инструмент ОТКАЗЫВАЕТ: не поместившийся остов означает комнаты, до которых нельзя дойти, и по
// растру этого не видно.
//
// `path` лежит рядом с `pair`, но источником правды НЕ является: это центры комнат, посчитанные
// отдельным проходом. Копия координат, дописанная руками при построении остова, однажды разъехалась
// бы с планом — комнату подвинули, конец связи остался старым, и коридор ведёт в стену.
{
  name = links
  format = [ pair = ui2, path = ui4 ]
  layout = soa
  size = link_capacity
}

// РАСТР. Два поля, а не одно: `room` несёт НОМЕР КОМНАТЫ ПЛЮС ОДИН (ноль значит «не комната», как у
// всех инструментов с ключом), `corridor` — признак коридора. Пол это одно ИЛИ другое, и разделение
// нужно, чтобы вопрос «какой комнате принадлежит клетка» имел ответ: без него не проверить
// достижимость по комнатам и не поставить дверь на стыке.
{
  name = cells
  format = [ room = ui1, corridor = ub1 ]
  layout = soa
  extent = [ side, side ]
}

// Сводка о прогоне. Счётчики здесь не для отчёта: по ним считаются диапазоны следующих шагов.
{
  name = state
  format = [ rooms = ui1, links = ui1, attempts = ui1 ]
  layout = soa
  size = single
}

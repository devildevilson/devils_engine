// Авторский словарь одного тёмного замка. Это ДАННЫЕ ПЛОЩАДКИ, а не виды `originator`.
// `motif` может указывать на модель или отдельную процедуру проекта; пока стенд показывает
// габарит цветом и знаком. Программа задаёт смысл и порядок частей, но не их координаты.
// Порядок правил важен: родитель должен быть объявлен раньше ребёнка.

version = 2

locations = [ torture, laboratory ]

scales = [
  { name = small,  side = 72 }
  { name = medium, side = 96 }
  { name = large,  side = 128 }
]

motifs = [
  { name = gallery,         glyph = "=", colour = [113, 87, 73] }
  { name = focus,           glyph = "T", colour = [155, 74, 66] }
  { name = torture_cell,    glyph = "c", colour = [81, 56, 45] }
  { name = experiment_hall, glyph = "L", colour = [125, 116, 95] }
  { name = holding,         glyph = "h", colour = [97, 83, 78] }
  { name = service_run,     glyph = "+", colour = [119, 112, 105] }
  { name = store,           glyph = "s", colour = [85, 77, 66] }
  { name = study,           glyph = "a", colour = [111, 98, 83] }
]

rules = [
  {
    name = gallery
    motif = gallery
    location = torture
    parent = none
    min_width = [17, 22, 28]
    max_width = [21, 27, 35]
    min_height = 3
    max_height = 4
  }
  {
    name = focus
    motif = focus
    location = torture
    parent = gallery
    sides = [ east ]
    min_width = [6, 6, 6]
    max_width = [9, 9, 9]
    min_height = 6
    max_height = 8
  }
  {
    name = experiment_hall
    motif = experiment_hall
    location = laboratory
    parent = focus
    sides = [ east ]
    min_width = [10, 13, 17]
    max_width = [13, 17, 22]
    min_height = 10
    max_height = 14
  }
  {
    name = service_run
    motif = service_run
    location = laboratory
    parent = experiment_hall
    sides = [ east ]
    min_width = [6, 6, 6]
    max_width = [9, 9, 9]
    min_height = 3
    max_height = 4
  }
  {
    name = store
    motif = store
    location = laboratory
    parent = service_run
    sides = [ north, south ]
    min_width = [5, 5, 5]
    max_width = [7, 7, 7]
    min_height = 4
    max_height = 6
  }
  {
    name = study
    motif = study
    location = laboratory
    parent = service_run
    sides = [ north, south ]
    min_width = [5, 5, 5]
    max_width = [7, 7, 7]
    min_height = 4
    max_height = 6
  }
  {
    name = torture_cell
    motif = torture_cell
    location = torture
    parent = gallery
    sides = [ north, south ]
    min_width = [4, 4, 4]
    max_width = [5, 5, 5]
    min_height = 4
    max_height = 6
    count = [4, 6, 8]
    required = [3, 5, 7]
    optional_chance = 60
  }
  {
    name = holding
    motif = holding
    location = laboratory
    parent = experiment_hall
    sides = [ north, south ]
    min_width = [4, 4, 4]
    max_width = [5, 5, 5]
    min_height = 4
    max_height = 6
    count = [2, 2, 3]
    required = [2, 2, 2]
    optional_chance = 65
  }
]

// Генератор GN06 — ТОЧКА ВХОДА.
//
// Три шага, и границу между ними стоит читать как границу ответственности:
//
//   plan   где стоят комнаты (список прямоугольников, десятки элементов);
//   links  что с чем соединено (остов над комнатами — здесь и живёт обещание достижимости);
//   carve  как это выглядит на растре (десятки тысяч клеток).
//
// Шаг `links` отделён от `plan` не ради дробности: остов это утверждение о ГРАФЕ, и проверяется оно
// на графе, а не на картинке. Растр может разорвать связное подземелье (коридор, уехавший за край,
// обрезается), и тогда план остаётся верным при разорванной карте — поэтому у площадки две разные
// проверки, а не одна.

name = gn06

values  = ./values.tavl
buffers = ./buffers.tavl

steps = [
  {
    name = plan
    body = ./scripts/S00_plan.lua
    writes = [ rooms, state ]
  }

  {
    name = links
    body = ./scripts/S01_links.lua
    reads = [ rooms ]
    writes = [ links, state ]
  }

  {
    name = carve
    body = ./scripts/S02_carve.lua
    reads = [ rooms, links, state ]
    writes = [ cells ]
  }
]

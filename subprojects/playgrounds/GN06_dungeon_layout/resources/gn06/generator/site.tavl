// Одна локация целиком. Порядок правил — только порядок появления кандидатов-якорей.
// Функциональные области отвечают за назначение (включая utility-путь), технические —
// за самостоятельное взаимодействие. Размеры заданы для small/medium/large отдельно.
version = 9
name = black_castle_dungeon
theme = dark_fantasy_castle
scales = [ small, medium, large ]
footprints = [ 128, 192, 256 ]

// Авторское завершение utility-пути: непрерывная алькова для скамьи/инструментов.
// Это часть той же функциональной области, не новая дверь и не фиктивное окно в камень.
endings = [
  { name = service_alcove, motif = store, frontage_extra = 4, depth = [3,3,3] }
]

kinds = [
  { name = entry,       category = functional, function = utility,    motif = service_run,     width = [6,6,7],   height = [6,6,7],    glyph = "E", colour = [149,151,138] }
  { name = junction,    category = functional, function = utility,    motif = service_run,     width = [9,11,13], height = [8,10,12], height_policy = frontage, frontage_margin = 2, frontage_gap = 2, glyph = "+", colour = [125,119,108] }
  { name = gallery,     category = functional, function = utility,    motif = gallery,         width = [36,40,48], width_max = [40,46,54], height = [6,6,8], glyph = "=", colour = [113,87,73], path = {
    mode = offset, l1_per_mille = [550,550,550], l1_max = [650,650,650],
    l2_per_mille = [200,200,200], l2_max = [300,300,300],
    bend = [4,6,8], bend_max = [10,14,18], mirror = 1, min_bend_length = 2,
    start = { policy = trim, clearance = 2, minimum_length = 4 },
    end = { policy = vary, accent = service_alcove, trim_percent = 75, clearance = 2, minimum_length = 4 }
  } }
  { name = exit_run, category = functional, function = utility, motif = gallery,
    width = [12,14,16], width_max = [16,18,22], height = [6,6,8], glyph = "=", colour = [113,87,73],
    path = { mode = offset, l1_per_mille = [750,750,750], l2_per_mille = [250,250,250], bend = [0,0,0],
      start = { policy = trim, clearance = 2, minimum_length = 4 },
      end = { policy = vary, accent = service_alcove, trim_percent = 75, clearance = 2, minimum_length = 4 } } }
  { name = threshold,   category = technical,  function = open_passage, motif = none,         width = [1,1,1],   height = [1,1,1],    glyph = ":", colour = [174,154,122] }
  // width — ширина вдоль кромки, height — глубина стены, не осевой квадрат.
  { name = door, category = technical, function = passage, motif = none,
    width = [2,2,2], width_max = [3,3,3], height = [1,1,1], glyph = "D", colour = [225,211,165] }
  { name = prison_cell, category = functional, function = detention,  motif = torture_cell,    width = [4,5,5], width_max = [6,7,8], height = [4,5,6], height_max = [6,7,8], glyph = "c", colour = [81,56,45] }
  { name = torture,     category = functional, function = coercion,   motif = focus,           width = [7,8,9], width_max = [11,14,17], height = [7,8,9], height_max = [10,12,14], glyph = "T", colour = [155,74,66] }
  { name = watch_post,  category = functional, function = security,   motif = focus,           width = [7,8,9], width_max = [8,9,10], height = [7,8,9], height_max = [8,9,10], shape = oblique, glyph = "W", colour = [120,105,87] }
  { name = laboratory,  category = functional, function = research,   motif = experiment_hall, width = [12,14,16], width_max = [16,18,20], height = [10,10,12], shape = round_east, glyph = "L", colour = [125,116,95] }
  { name = store,       category = functional, function = storage,    motif = store,           width = [4,5,6], width_max = [6,7,9], height = [4,5,6], height_max = [6,7,8], glyph = "s", colour = [85,77,66] }
  { name = observation_walk, category = functional, function = utility, motif = gallery, width = [7,8,9], width_max = [10,12,14], height = [10,10,12], shape = wrap_east, glyph = "~", colour = [106,124,120] }
]

rules = [
  { kind = entry,       min_count = [1,1,1], max_count = [1,1,1] }
  { kind = junction,    anchors = [entry], min_count = [1,1,1], max_count = [1,1,1], via = threshold, appearance_from = parent, port = main, sides = [east] }
  { kind = gallery,     anchors = [junction], min_count = [1,2,2], max_count = [2,2,2], via = threshold, appearance_from = child, port = branch, sides = [east,north,south] }
  { kind = torture,     anchors = [gallery], per_anchor = 1, min_count = [1,1,1], max_count = [1,1,1], via = door, appearance_from = child, port = start, unique_port = 1, sides = [north,south] }
  { kind = watch_post, anchors = [gallery], attachment = bend, anchor_part = bend, min_count = [1,1,1], max_count = [1,1,1], via = door, appearance_from = child, port = centre, sides = [north,south] }
  // Торец -> торец или торец -> начало боковины прямого пути: второй случай даёт угол без двери.
  { kind = exit_run, anchors = [gallery], per_anchor = 1, min_count = [1,1,1], max_count = [1,1,1],
    attachment = cap, port = end, sides = [east], turns = [straight,left,right] }
  // В торец входит центр входной стены зала. Редкий открытый выход не порождает техническую зону.
  { kind = laboratory, anchors = [exit_run,junction], attachment = cap, min_count = [1,1,1], max_count = [1,2,2], via = door, open_percent = 15, appearance_from = child, port = end, unique_port = 1, sides = [east,north,south] }
  { kind = prison_cell, anchors = [gallery], per_anchor = 1, min_count = [2,2,3], max_count = [3,4,4], via = door, appearance_from = vary, port = side, sides = [north,south] }
  { kind = store,       anchors = [laboratory], per_anchor = 1, min_count = [1,1,1], max_count = [1,2,2], via = door, appearance_from = parent, port = side, passage_align = start, sides = [north,south] }
  { kind = observation_walk, anchors = [laboratory], per_anchor = 1, min_count = [1,1,1], max_count = [1,1,1], via = door, appearance_from = child, port = centre, sides = [east] }
]

// Топологическое «рядом с маршрутом», НЕ утверждение о прямой видимости.
perception = { from = torture, to = laboratory, witness = prison_cell, via = gallery, max_distance = 8, dialogue_template = transfer_seen }

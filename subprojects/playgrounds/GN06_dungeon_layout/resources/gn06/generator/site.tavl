// Одна локация целиком. Порядок правил — только порядок появления кандидатов-якорей.
// Функциональные области отвечают за назначение (включая utility-путь), технические —
// за самостоятельное взаимодействие. Геометрия и локальные порты — в site_motifs.tavl.
version = 11
name = black_castle_dungeon
theme = dark_fantasy_castle
scales = [ small, medium, large ]
footprints = [ 128, 192, 256 ]

// Авторское завершение utility-пути: непрерывная алькова для скамьи/инструментов.
// Это часть той же функциональной области, не новая дверь и не фиктивное окно в камень.
endings = [
  { name = service_alcove, motif = store, frontage_extra = 4, depth = [3,3,3] }
]

kinds = [
  { name = entry, category = functional, function = utility, motif = entry }
  { name = junction, category = functional, function = utility, motif = junction }
  { name = gallery, category = functional, function = utility, motif = gallery }
  { name = exit_run, category = functional, function = utility, motif = exit_run }
  { name = threshold, category = technical, function = open_passage, motif = threshold }
  { name = door, category = technical, function = passage, motif = door }
  { name = prison_cell, category = functional, function = detention, motif = prison_cell }
  { name = torture, category = functional, function = coercion, motif = torture }
  { name = watch_post, category = functional, function = security, motif = watch_post }
  { name = laboratory, category = functional, function = research, motif = laboratory }
  { name = store, category = functional, function = storage, motif = store }
  { name = observation_walk, category = functional, function = utility, motif = observation_walk }
]
rules = [
  { kind = entry,       min_count = [1,1,1], max_count = [1,1,1] }
  { kind = junction,    anchors = [entry], min_count = [1,1,1], max_count = [1,1,1], via = threshold, appearance_from = parent, port = main, sides = [east] }
  { kind = gallery,     anchors = [junction], min_count = [1,2,2], max_count = [2,2,2], via = threshold, appearance_from = child, port = branch, sides = [east,north,south] }
  { kind = torture,     anchors = [gallery], per_anchor = 1, min_count = [1,1,1], max_count = [1,1,1], via = door, appearance_from = child, port = start, unique_port = 1, sides = [north,south] }
  { kind = watch_post, anchors = [gallery], attachment = bend, anchor_part = bend, min_count = [1,1,1], max_count = [1,1,1], via = door, appearance_from = child, port = centre, sides = [north,south] }
  // Торец -> торец или торец -> начало боковины прямого пути: второй случай даёт угол без двери.
  { kind = exit_run, anchors = [gallery], per_anchor = 1, min_count = [1,1,1], max_count = [1,1,1],
    attachment = cap, port = end, sides = [east], turns = [straight,left,right], leaf_policy = omit }
  // В торец входит центр входной стены зала. Редкий открытый выход не порождает техническую зону.
  { kind = laboratory, anchors = [exit_run,junction], attachment = cap, min_count = [1,1,1], max_count = [1,2,2], via = door, open_percent = 15, appearance_from = child, port = end, unique_port = 1, sides = [east,north,south] }
  { kind = prison_cell, anchors = [gallery], per_anchor = 1, min_count = [2,2,3], max_count = [3,4,4], via = door, appearance_from = vary, port = side, sides = [north,south] }
  { kind = store,       anchors = [laboratory], per_anchor = 1, min_count = [1,1,1], max_count = [1,2,2], via = door, appearance_from = parent, port = side, passage_align = start, sides = [north,south] }
  { kind = observation_walk, anchors = [laboratory], per_anchor = 1, min_count = [1,1,1], max_count = [1,1,1], via = door, appearance_from = child, port = centre, sides = [east] }
]

// Топологическое «рядом с маршрутом», НЕ утверждение о прямой видимости.
perception = { from = torture, to = laboratory, witness = prison_cell, via = gallery, max_distance = 8, dialogue_template = transfer_seen }

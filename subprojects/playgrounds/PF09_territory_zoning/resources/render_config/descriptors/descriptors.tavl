// У заливки и линий ОДИНАКОВАЯ форма набора, поэтому им хватает одного шейдера: меняется только то,
// какой буфер привязан вторым.
{
  name = fill_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = vertex },
    { resource = fill_vertices, usage = storage_read, stage = vertex }
  ]
}
{
  name = line_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = vertex },
    { resource = line_vertices, usage = storage_read, stage = vertex }
  ]
}
{
  name = label_data
  layout = [
    { resource = camera_buffer, usage = uniform, stage = vertex },
    { resource = label_vertices, usage = storage_read, stage = vertex }
  ]
}
{ name = camera_data, layout = [ { resource = camera_buffer, usage = uniform, stage = vertex } ] }
{ name = ui_textures, texture_count = 16, sampler_pool = [ ui_linear ], texture_stage = fragment }

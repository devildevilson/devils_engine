// Генератор GN05 — ТОЧКА ВХОДА.
//
// Шаг один: объявить таблицу тайлов, заполнить матрицу соседства и решить. Всё это одно действие —
// разрезать его на шаги значило бы разложить по разным местам объявление и его единственного
// потребителя.

name = gn05

values  = ./values.tavl
buffers = ./buffers.tavl

steps = [
  {
    name = layout
    body = ./scripts/S01_layout.lua
    writes = [ tiles, rules, cells, state ]
  }
]

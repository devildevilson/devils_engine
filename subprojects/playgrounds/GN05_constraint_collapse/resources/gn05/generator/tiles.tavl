// Генератор GN05 по ОБЪЯВЛЕННЫМ правилам — ТОЧКА ВХОДА.
//
// Шага два: лесенка тайлов и раскладка по ней. Лесенка отделена не ради красоты — на неё смотрят все
// три генератора площадки, и ссылаются они на ОДИН файл, а не на три копии таблицы.

name = gn05

values  = ./values.tavl
buffers = ./buffers.tavl

steps = [
  {
    name = table
    body = ./scripts/S00_tiles.lua
    writes = [ tiles ]
  }

  {
    name = layout
    body = ./scripts/S01_layout.lua
    reads = [ tiles ]
    writes = [ rules, cells, state ]
  }
]

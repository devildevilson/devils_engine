// Общие значения пайплайна GN05.

{
  numbers = {
    // Сколько тайлов объявлено. Число живёт ЗДЕСЬ, потому что по нему считаются размеры буферов ещё
    // до запуска скрипта; сам список тайлов лежит в теле шага, и расхождение проверяется вслух.
    tile_count = 7

    // Сколько раз пробовать, прежде чем сдаться. Противоречие — нормальный исход алгоритма, а не
    // сбой: arc consistency только отсекает, существование решения она не гарантирует. Исчерпание
    // попыток — ГРОМКИЙ отказ, потому что недособранная сетка это другой мир под тем же зерном.
    attempts = 24

    // Замыкать ли растр по краям. Ноль означает край: у крайней клетки соседа с той стороны просто
    // нет, и никакого ограничения оттуда не приходит.
    wrap = 0

    // Обводить ли карту глубокой водой заранее. Это демонстрация ЗАРАНЕЕ ЗАНЯТЫХ клеток: решатель
    // получает их как условие и обязан его соблюсти.
    frame = 1

    // Дальше — значения второй половины площадки: откаты, обучение и граф. Они лежат в ОДНОМ
    // документе на три генератора потому, что это одни и те же величины одной лаборатории, а не три
    // набора настроек.

    // ОТКАТЫ. Противоречие означает, что где-то выше был сделан выбор, который сюда привёл;
    // перезапуск выбрасывает вместе с ним и всю остальную собранную сетку. Откат отменяет ровно
    // последний выбор и запрещает его — поиск от этого СУЖАЕТСЯ, а не ходит по кругу.
    rollbacks = 64

    // Сколько наблюдений назад решатель помнит. Это ПАМЯТЬ, а не терпение: откатиться сто раз, помня
    // один шаг, — обычное дело, а помнить сто шагов на миллионе клеток — совсем другой разговор.
    history = 8

    // ОБУЧЕНИЕ. Сторона нарисованного образца и сторона окна, которым с него снимаются правила.
    // Окно в одну клетку даёт простые соседства тайлов; окно больше — соседства УЗОРОВ, и вместе с
    // ними мотив, который одними парами тайлов не выражается.
    sample_side = 48
    window = 2

    // Ёмкость алфавита узоров. Сколько их найдётся, до запуска не знает никто, поэтому объявляется
    // запас, а инструмент отклоняет образец, который в него не влез, и называет число. Урезанный
    // алфавит был бы другими правилами под тем же именем.
    capacity = 512

    // ГРАФ. Сколько клеток на сфере и сколько ближайших соседей у каждой.
    cell_count = 4096
    neighbours = 6

    // Сколько вершин и сколько впадин задать заранее. Нужны они не для красоты: у той же лесенки на
    // графе степени 6 НЕТ РАВНОВЕСИЯ. Свободная сфера уходит целиком в воду, а сфера с двумя
    // десятками снежных вершин — целиком в горы: у правила «сосед через ступень» нет возвращающей
    // силы, и весь шар едет туда, куда его толкнуло первое условие. Поэтому условий ДВА, с разных
    // концов лесенки, и между ними появляется склон.
    peaks = 8
    basins = 8
  }
}

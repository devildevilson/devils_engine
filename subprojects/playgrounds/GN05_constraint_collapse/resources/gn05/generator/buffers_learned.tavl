// Буферы генератора GN05 в режиме ОБУЧЕНИЯ.
//
// Отличие от объявленных правил одно, но оно проходит через все буферы: алфавит здесь не тайлы, а
// УЗОРЫ — окна `window x window`, найденные в образце. Сколько их будет, до запуска не знает никто,
// поэтому объявляется ЁМКОСТЬ, а инструмент отклоняет образец, который в неё не влез, и называет
// число. Урезанный алфавит был бы другими правилами под тем же именем.

// Лесенка тайлов: только цвета для глаза. Веса в этом режиме СНИМАЮТСЯ С ОБРАЗЦА — сколько раз узор
// встретился, столько он и весит, — поэтому объявленные веса здесь не участвуют вовсе.
{
  name = tiles
  format = [ weight = v1, colour = ui1 ]
  layout = soa
  size = tile_count
}

// ОБРАЗЕЦ: нарисованный от руки кусок мира, с которого снимаются правила.
{
  name = sample
  format = [ tile = ui1 ]
  layout = soa
  extent = [ sample_side, sample_side ]
}

// Алфавит узоров: вес (сколько раз узор встретился) и ПРЕДСТАВИТЕЛЬ — тайл в якоре узора, которым
// раскладка переводится обратно в тайлы обычным `lookup`.
{
  name = alphabet
  format = [ weight = v1, representative = ui1 ]
  layout = soa
  size = capacity
}

// Матрица соседства УЗОРОВ. Та же раскладка индексов, что и у объявленных правил: две оси, узор на
// узор, — потому что решатель у обоих режимов один.
{
  name = learned_rules
  format = [ allowed = ub1 ]
  layout = soa
  size = learned_rule_size
}

// Растр. `pattern` — то, что решил решатель, `tile` — то же самое, переведённое представителями.
// Два поля, а не одно, потому что проверка обещания читает ИМЕННО узоры.
{
  name = cells
  format = [ pattern = ui1, tile = ui1 ]
  layout = soa
  extent = [ side, side ]
}

// Сводка о прогоне: сколько узоров нашлось, сколько попыток и откатов ушло. Без этих чисел тесная
// таблица и просторная выглядят с результата одинаково.
{
  name = state
  format = [ patterns = ui1, attempts = ui1, rollbacks = ui1 ]
  layout = soa
  size = single
}

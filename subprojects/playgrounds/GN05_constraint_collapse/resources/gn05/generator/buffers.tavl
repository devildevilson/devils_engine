// Буферы генератора GN05.
//
// Правила соседства — ДАННЫЕ, и лежат они в буфере, а не в C++: библиотека говорит «тяжёлые данные
// лежат в буферах и приходят привязками», а маленькое множество скрипт вправе перечислить сам.

// Таблица тайлов: вес выбора и цвет для глаза. Цвет объявлен здесь, а не в коде площадки, чтобы у
// него был ОДИН источник — иначе порядок тайлов оказался бы записан дважды.
{
  name = tiles
  format = [ weight = v1, colour = ui1 ]
  layout = soa
  size = tile_count
}

// МАТРИЦА разрешённого соседства: `allowed[(axis * tiles + a) * tiles + b]` ненулевое означает «b
// может стоять по +axis от a». Осей две, обратные направления решатель ВЫВОДИТ транспонированием.
//
// Матрица, а не битовый набор, намеренно: упаковка в слова — внутреннее дело решателя, и знать о ней
// конфигу незачем. Иначе раскладка слов оказалась бы записана дважды.
{
  name = rules
  format = [ allowed = ub1 ]
  layout = soa
  size = rule_size
}

// Растр. `given` — ЗАРАНЕЕ ЗАНЯТЫЕ клетки: ноль означает «свободна», как и у остальных инструментов
// с ключом, иначе это номер тайла плюс один.
{
  name = cells
  format = [ tile = ui1, given = ui1 ]
  layout = soa
  extent = [ side, side ]
}

// Сводка о прогоне: сколько попыток и сколько откатов понадобилось. Противоречие у решателя —
// нормальный исход, и эти два числа единственное, по чему видно, насколько правила тесные.
{
  name = state
  format = [ attempts = ui1, rollbacks = ui1 ]
  layout = soa
  size = single
}

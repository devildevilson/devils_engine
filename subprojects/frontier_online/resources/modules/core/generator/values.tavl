// Общие значения генератора земли: их видит каждый шаг среди своих параметров.
//
// Пороги живут ЗДЕСЬ, а не в теле шага, потому что их читает и классификация рельефа, и (позже)
// правила проходимости. Порог, продублированный в двух местах, однажды разъедется.
{
  numbers = {
    // Размер черты рельефа В ТАЙЛАХ. Частота шума выводится из него, поэтому ни размер чанка, ни
    // разрешение мир не меняют: 14 тайлов на черту — это 14 тайлов на черту где угодно.
    //
    // Величина выбрана ОТ РАЗМЕРА ОКНА, а не «покрасивее»: мир игры — 8x8 чанков по 16 тайлов,
    // то есть 128 тайлов. При черте в 64 тайла на всю карту приходилось ДВА элемента рельефа, и
    // она оказывалась сплошной водой — генератор работал, мира не было. Правило простое: черта
    // должна быть заметно мельче окна, иначе окно показывает не мир, а один его склон.
    feature_size = 14
    // Влажность мельче рельефа, иначе биомы ложатся ровно по высоте и карта выглядит полосатой.
    moisture_feature_size = 9

    // Пороги классификации, откалиброванные ПРОТИВ СЫРОГО поля выбранного дерева.
    //
    // Приводить поле к [0,1] нечем: нормализация по измеренному диапазону не чанкуется (каждый
    // чанк померил бы свой и получил бы своё отображение), а фиксированный множитель пришлось бы
    // подбирать тем же измерением — то есть он ничего не экономит и лишь добавляет второе число,
    // которое однажды разъедется с первым. Поэтому пороги стоят прямо на поле.
    //
    // Измерено на 147456 клетках (24x24 чанка, зерно 20260911):
    //   height   децили: 0.36 0.53 0.63 0.70 0.78 0.89 1.01 1.13 1.23
    //   moisture децили: -0.29 0.14 0.39 0.53 0.70 0.79 0.88 0.96 1.07
    // Диапазон дерева зависит от ЧАСТОТЫ: на крупной черте (64 тайла) то же дерево не уходило в
    // минус вовсе, на мелкой (14) уходит. Меняешь feature_size — меряешь заново:
    //   frontier_online_server --terrain=24 --ticks=<зерно>
    //
    // Влажность коррелирует с высотой, поэтому пороги суши стоят выше своих перцентилей по всем
    // клеткам: доля считается от СУШИ, а не от карты.
    // Что получилось: на мире игры (8x8 чанков) вода 21.3%, сухая 21.6%, обычная 29.0%,
    // влажная 28.0%; на 24x24 — 30.5 / 20.4 / 23.6 / 25.5.
    sea_level = 0.63
    dry = 0.70
    wet = 0.92

    // Сглаживание высоты перед классификацией: убирает одиночные клетки-острова.
    radius = 1
  }

  strings = {
    // Закодированное дерево узлов FastNoise2: граф шума — данные, а не код.
    tree = "DQkGDA=="
  }
}

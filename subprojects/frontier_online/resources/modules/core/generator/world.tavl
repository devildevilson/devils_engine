// Генератор земли frontier_online — ТОЧКА ВХОДА.
//
// Земля по сети НЕ ЕДЕТ: чанк — чистая функция (зерно мира, ключ чанка), и обе стороны считают его
// сами. По проводу едут только зерно и отпечаток этого генератора, который встаёт в
// session_compatibility рядом с content_root: разные генераторы — разные миры, и узнать об этом
// надо на рукопожатии, а не по разъехавшейся картинке.
//
// Отсюда же требование к шагам: ни один из них не имеет права зависеть от того, какие чанки
// посчитаны раньше. Поле по мировой позиции непрерывно через шов, потому что зерно шага не зависит
// от ключа (step.seed), а локальный разброс берёт step.chunk_seed.

name = frontier_land

values  = ./values.tavl
buffers = ./buffers.tavl

steps = [
  // Высота и влажность из шума по МИРОВОЙ позиции: чанк сдвигает начало координат, а не начинает
  // поле заново.
  {
    name = elevation
    body = ./scripts/elevation.lua
    writes = [ tiles ]
  }

  // Сглаживание и классификация в код рельефа. box_blur читает окно вокруг клетки (апертура
  // gather), поэтому приёмник обязан быть отдельным полем — и это проверяется до исполнения.
  {
    name = classify
    body = ./scripts/classify.lua
    writes = [ tiles ]
  }
]

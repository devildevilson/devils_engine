// Буферы генератора земли.
//
// Буфер ОДИН и он размером с чанк, а не с карту: мир считается по чанкам вокруг наблюдателя, и
// никакого «всего мира» в памяти не существует. Форма объявлена через extent, поэтому ширину
// растра инструмент берёт у самой привязки, а не получает параметром — двух чисел, случайно
// равных, здесь быть не должно.
//
// terrain — это КОД РЕЛЬЕФА, причинная величина. Клетка определяется им, а не текстурой: у
// авторитета нет реестра текстур, а текстура — всего лишь его презентационное отображение.
{
  name = tiles
  format = [
    height = v1
    moisture = v1
    smoothed = v1
    terrain = ub1
  ]
  layout = soa
  extent = [ chunk_side, chunk_side ]
}

tile_texture_group = "tile_textures"
sound_group = "sounds"
tile_size = 1.0
chunk_size = 16
chunks_x = 8
chunks_y = 8
actor_count = 4096
// Ширина обзора выбрана так, чтобы в кадр попадало несколько черт рельефа (черта = 14
// тайлов): при 8.0 в кадре было 16 тайлов, то есть один склон, и мир выглядел однотонным
// независимо от того, что посчитал генератор.
camera = {
  projection = "orthographic"
  half_width = 28.0
  controller = "pan"
  pan_speed = 1.5
  limits = "world"
  body = "none"
}
actor_prefab_cycle = [prey, prey, prey, actor]
// Земля: точка входа генератора originator и зерно мира.
terrain_generator = "generator/world"
world_seed = 20260911

script = "ui/entry"
default_font = "fonts/crimson.roman"

// This is the initial residency set of this UI state; resources the scene manifest declares join it.
// Every entry reaches final_state() before ui/entry is executed.
resources = [
  "ui/entry"
  "fonts/crimson.roman"
  "fonts/crimson.italic"
  "textures/grad2"
  "textures/quad"
]

scene = "scenes/frontier_online"
